  "known_divergences": [
    {
      "id": "cpu-dcbst-emitted-as-noop",
      "status": "divergent",
      "domain": "cpu-cache",
      "semantics": [
        "dcbst"
      ],
      "reason": "RexGlue 0.9 decodes and dispatches dcbst, but its builder emits no effective address calculation or explicit cache publication operation.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/instruction_dispatch.cpp",
        "src/codegen/builders/system.cpp"
      ]
    },
    {
      "id": "cpu-reciprocal-estimates-exact-host-math",
      "status": "divergent",
      "domain": "cpu-floating-point",
      "semantics": [
        "frsqrte",
        "vrefp",
        "vrsqrtefp"
      ],
      "reason": "RexGlue emits exact host divide or square-root operations instead of the Xenon estimate results; its frsqrte vectors document different expected values.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/floating_point.cpp",
        "src/codegen/builders/vector.cpp",
        "tests/ppc/asm/instr_frsqrte.s"
      ]
    },
    {
      "id": "cpu-reservation-without-address-or-granule",
      "status": "divergent",
      "domain": "cpu-atomics",
      "semantics": [
        "lwarx",
        "ldarx",
        "stwcx.",
        "stdcx."
      ],
      "reason": "The reservation records only the loaded value; the conditional store does not validate the reserved address or reservation granule.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/helpers.h",
        "include/rex/ppc/context.h"
      ]
    },
    {
      "id": "cpu-barriers-emitted-as-noop",
      "status": "divergent",
      "domain": "cpu-memory-ordering",
      "semantics": [
        "sync",
        "lwsync",
        "eieio"
      ],
      "reason": "RexGlue emits no host fence and assumes x86 ordering, which is not a complete Xenon or portable host contract.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/system.cpp"
      ]
    },
    {
      "id": "cpu-vmsum4fp128-summation-order",
      "status": "divergent",
      "domain": "cpu-vmx128",
      "semantics": [
        "vmsum4fp128"
      ],
      "reason": "RexGlue emits SIMDe DPPS with a pairwise reduction, while the current executed PAL SLEIGH control matches only a left-to-right sum of individually rounded products; neither result is yet qualified against console hardware.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/vector.cpp",
        "reports/cycle-1412-the-only-reading-that-fits.md",
        "reconstruction/ace-combat-6/tests/retail_scalar_sin_cos_tests.cpp"
      ]
    },
    {
      "id": "cpu-hle-u64-arguments-truncated",
      "status": "divergent",
      "domain": "cpu-abi",
      "semantics": [
        "64-bit integer HLE arguments",
        "64-bit integer HLE stack arguments"
      ],
      "reason": "RexGlue 0.9's generic HLE binder reads and writes integer argument slots through u32 even when the declared wrapper argument is 64 bits.",
      "gate_evidence": false,
      "evidence": [
        "include/rex/ppc/function.h",
        "reports/cycle-1544-recompiler-rexglue-xenon-xenos-review.md"
      ]
    },
    {
      "id": "cpu-hle-mixed-fp-integer-slotting",
      "status": "divergent",
      "domain": "cpu-abi",
      "semantics": [
        "mixed floating-point and integer HLE arguments"
      ],
      "reason": "RexGlue 0.9 advances independent floating-point and integer argument counters, while the Xbox ABI call position also advances across mixed argument classes.",
      "gate_evidence": false,
      "evidence": [
        "include/rex/ppc/function.h",
        "reports/cycle-1544-recompiler-rexglue-xenon-xenos-review.md"
      ]
    },
    {
      "id": "cpu-vscr-sat-not-updated",
      "status": "divergent",
      "domain": "cpu-vmx",
      "semantics": [
        "vpkswss",
        "VSCR.SAT"
      ],
      "reason": "RexGlue packs and clamps the result lanes but does not update VSCR.SAT, so only the lane result may be used provisionally and the complete instruction is divergent.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/vector.cpp",
        "include/rex/ppc/context.h",
        "reports/cycle-1544-recompiler-rexglue-xenon-xenos-review.md"
      ]
    },
    {
      "id": "cpu-fpscr-status-incomplete",
      "status": "divergent",
      "domain": "cpu-floating-point",
      "semantics": [
        "FPSCR status and exceptions",
        "FPRF",
        "fcmpo signaling NaN behavior",
        "mffs",
        "mtfsf"
      ],
      "reason": "RexGlue preserves only a bounded rounding-mode model; exception flags, FPRF and signaling-NaN effects required by the complete FPSCR contract are not modeled.",
      "gate_evidence": false,
      "evidence": [
        "include/rex/ppc/context.h",
        "src/codegen/builders/floating_point.cpp",
        "reports/cycle-1544-recompiler-rexglue-xenon-xenos-review.md"
      ]
    },
    {
      "id": "cpu-pal-oracle-fma-unfused",
      "status": "divergent",
      "domain": "cpu-floating-point",
      "semantics": [
        "scalar fused multiply-add in RexGlue 0.7.1"
      ],
      "reason": "The RexGlue 0.7.1 tree used by the current PAL oracle emits scalar multiply then add, whereas RexGlue 0.9 emits std::fma; discriminating inputs cannot inherit the modern behavior.",
      "gate_evidence": false,
      "evidence": [
        "analysis/oracle/ac6-recomp-dcd41b/manifest.json",
        "reports/cycle-1544-recompiler-rexglue-xenon-xenos-review.md"
      ]
    }
  ],
