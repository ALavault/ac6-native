      "semantics": [
        "frsqrte",
        "vrefp",
        "vrsqrtefp"
      ],
      "reason": "RexGlue emits exact host divide or square-root operations instead of the Xenon estimate results; its frsqrte vectors document different expected values.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/floating_point.cpp",
        "src/codegen/builders/vector.cpp",
        "tests/ppc/asm/instr_frsqrte.s"
      ]
    },
