      "semantics": [
        "lwarx",
        "ldarx",
        "stwcx.",
        "stdcx."
      ],
      "reason": "The reservation records only the loaded value; the conditional store does not validate the reserved address or reservation granule.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/helpers.h",
        "include/rex/ppc/context.h"
      ]
    },
    {
      "id": "cpu-barriers-emitted-as-noop",
      "status": "divergent",
      "domain": "cpu-memory-ordering",
      "semantics": [
        "sync",
        "lwsync",
        "eieio"
      ],
      "reason": "RexGlue emits no host fence and assumes x86 ordering, which is not a complete Xenon or portable host contract.",
      "gate_evidence": false,
      "evidence": [
        "src/codegen/builders/system.cpp"
      ]
    }
