@@ -0,0 +1,825 @@
+#include "ac6_controller_input_replay.h"
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <regex>
+#include <set>
+#include <sstream>
+#include <utility>
+
+#include <rex/crypto/sha256.h>
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-literal-operator"
+#endif
+#include "../thirdparty/rexglue-sdk/thirdparty/tomlplusplus/vendor/json.hpp"
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
+
+namespace ac6::oracle::controller_replay {
+namespace {
+
+using Json = nlohmann::json;
+
+constexpr std::size_t kMaxLineBytes = 1024u * 1024u;
+constexpr uint64_t kMaxMarkers = 500'000u;
+constexpr std::size_t kMaxJsonDepth = 64u;
+constexpr std::string_view kSchema = "ac6.controller-input-replay.v4";
+constexpr std::string_view kOracleCommit =
+    "ab90b54713e5889f33eee1cc8681dae89fe83d1e";
+constexpr std::string_view kNtscUjXexSha256 =
+    "6eefba42cdfe9121207e534d8d290009c98b1a8c60ae5334a33a4f15167cbbbc";
+constexpr std::string_view kMarkerCodeSha256 =
+    "a4c027fcc05b34b0bb5ad5c8ad6a7f6bd37e2230797549637ee1950338ea390d";
+constexpr uint32_t kExpectedCallerLr0 = 0x8234CEE0u;
+constexpr uint32_t kExpectedCallerLr1 = 0x8234CFA4u;
+
+const std::regex kSha256{"[0-9a-f]{64}"};
+const std::regex kHex64Upper{"[0-9A-F]{16}"};
+
+bool SetError(std::string message, std::string& error) {
+  error = std::move(message);
+  return false;
+}
+
+bool ExactKeys(const Json& value,
+               std::initializer_list<std::string_view> expected) {
+  if (!value.is_object() || value.size() != expected.size()) return false;
+  for (std::string_view key : expected) {
+    if (!value.contains(std::string(key))) return false;
+  }
+  return true;
+}
+
+bool Unsigned(const Json& value, uint64_t maximum, uint64_t& output) {
+  if (value.is_number_unsigned()) {
+    output = value.get<uint64_t>();
+  } else if (value.is_number_integer()) {
+    const int64_t signed_value = value.get<int64_t>();
+    if (signed_value < 0) return false;
+    output = static_cast<uint64_t>(signed_value);
+  } else {
+    return false;
+  }
+  return output <= maximum;
+}
+
+bool Signed(const Json& value, int64_t minimum, int64_t maximum,
+            int64_t& output) {
+  if (value.is_number_unsigned()) {
+    const uint64_t unsigned_value = value.get<uint64_t>();
+    if (unsigned_value > static_cast<uint64_t>(maximum)) return false;
+    output = static_cast<int64_t>(unsigned_value);
+  } else if (value.is_number_integer()) {
+    output = value.get<int64_t>();
+  } else {
+    return false;
+  }
+  return output >= minimum && output <= maximum;
+}
+
+bool StringMatches(const Json& value, const std::regex& expression) {
+  return value.is_string() &&
+         std::regex_match(value.get_ref<const std::string&>(), expression);
+}
+
+std::string CanonicalLine(const Json& value) {
+  return value.dump(-1, ' ', true, Json::error_handler_t::strict) + '\n';
+}
+
+bool ParseCanonicalLine(std::string_view line, Json& value, std::string& error,
+                        std::string_view where) {
+  if (line.empty() || line.size() > kMaxLineBytes || line.back() != '\n' ||
+      line.find('\r') != std::string_view::npos) {
+    return SetError(std::string(where) + " framing", error);
+  }
+  std::size_t depth = 0;
+  bool in_string = false;
+  bool escaped = false;
+  for (char byte : line) {
+    if (in_string) {
+      if (escaped) {
+        escaped = false;
+      } else if (byte == '\\') {
+        escaped = true;
+      } else if (byte == '"') {
+        in_string = false;
+      }
+      continue;
+    }
+    if (byte == '"') {
+      in_string = true;
+    } else if (byte == '{' || byte == '[') {
+      if (++depth > kMaxJsonDepth) {
+        return SetError(std::string(where) + " JSON depth bound", error);
+      }
+    } else if (byte == '}' || byte == ']') {
+      if (depth == 0) {
+        return SetError(std::string(where) + " JSON nesting", error);
+      }
+      --depth;
+    }
+  }
+  if (in_string || depth != 0) {
+    return SetError(std::string(where) + " JSON nesting", error);
+  }
+  value = Json::parse(line.begin(), line.end() - 1, nullptr, false);
+  if (value.is_discarded() || !value.is_object()) {
+    return SetError(std::string(where) + " JSON", error);
+  }
+  if (CanonicalLine(value) != line) {
+    return SetError(std::string(where) + " canonical encoding", error);
+  }
+  return true;
+}
+
+bool ExpectedCallerLr(uint64_t caller_lr) {
+  return caller_lr == kExpectedCallerLr0 || caller_lr == kExpectedCallerLr1;
+}
+
+bool ValidateState(const Json& state, ControllerState* output,
+                   std::string& error, std::string_view where) {
+  if (!ExactKeys(state, {"packet_number", "buttons", "left_trigger",
+                         "right_trigger", "thumb_lx", "thumb_ly",
+                         "thumb_rx", "thumb_ry"})) {
+    return SetError(std::string(where) + " shape", error);
+  }
+  uint64_t packet = 0;
+  uint64_t buttons = 0;
+  uint64_t left_trigger = 0;
+  uint64_t right_trigger = 0;
+  int64_t lx = 0;
+  int64_t ly = 0;
+  int64_t rx = 0;
+  int64_t ry = 0;
+  if (!Unsigned(state["packet_number"], UINT32_MAX, packet) ||
+      !Unsigned(state["buttons"], UINT16_MAX, buttons) ||
+      !Unsigned(state["left_trigger"], UINT8_MAX, left_trigger) ||
+      !Unsigned(state["right_trigger"], UINT8_MAX, right_trigger) ||
+      !Signed(state["thumb_lx"], INT16_MIN, INT16_MAX, lx) ||
+      !Signed(state["thumb_ly"], INT16_MIN, INT16_MAX, ly) ||
+      !Signed(state["thumb_rx"], INT16_MIN, INT16_MAX, rx) ||
+      !Signed(state["thumb_ry"], INT16_MIN, INT16_MAX, ry)) {
+    return SetError(std::string(where) + " range", error);
+  }
+  if (output) {
+    *output = {
+        static_cast<uint32_t>(packet),
+        static_cast<uint16_t>(buttons),
+        static_cast<uint8_t>(left_trigger),
+        static_cast<uint8_t>(right_trigger),
+        static_cast<int16_t>(lx),
+        static_cast<int16_t>(ly),
+        static_cast<int16_t>(rx),
+        static_cast<int16_t>(ry),
+    };
+  }
+  return true;
+}
+
+Json StateJson(const ControllerState& state) {
+  return Json{{"packet_number", state.packet_number},
+              {"buttons", state.buttons},
+              {"left_trigger", state.left_trigger},
+              {"right_trigger", state.right_trigger},
+              {"thumb_lx", state.thumb_lx},
+              {"thumb_ly", state.thumb_ly},
+              {"thumb_rx", state.thumb_rx},
+              {"thumb_ry", state.thumb_ry}};
+}
+
+bool ValidateHeader(const Json& header, std::string& error) {
+  if (!ExactKeys(header, {"kind", "schema", "producer", "target",
+                          "session", "segment", "sync"}) ||
+      header["kind"] != "header" || header["schema"] != kSchema) {
+    return SetError("header identity or shape", error);
+  }
+
+  const Json& producer = header["producer"];
+  if (!ExactKeys(producer, {"lane", "implementation_commit",
+                            "binary_sha256", "build_sha256", "platform"}) ||
+      producer["lane"] != "ac6-recomp" ||
+      producer["implementation_commit"] != kOracleCommit ||
+      !StringMatches(producer["binary_sha256"], kSha256) ||
+      !StringMatches(producer["build_sha256"], kSha256) ||
+      !producer["platform"].is_string() ||
+      producer["platform"].get_ref<const std::string&>().empty() ||
+      producer["platform"].get_ref<const std::string&>().size() > 128u ||
+      producer["platform"].get_ref<const std::string&>().find('\0') !=
+          std::string::npos) {
+    return SetError("producer identity", error);
+  }
+
+  const Json& target = header["target"];
+  if (!ExactKeys(target, {"target_id", "title_id", "media_id", "module",
+                          "xex_sha256", "xex_version", "base_version",
+                          "module_xxh3", "entry_point", "region_mask"}) ||
+      target["target_id"] != "ac6-ntsc-uj-default-xex" ||
+      target["title_id"] != "4E4D07D1" || target["media_id"] != "531C30BE" ||
+      target["module"] != "default.xex" ||
+      target["xex_sha256"] != kNtscUjXexSha256 ||
+      target["xex_version"] != "v0.0.0.8" ||
+      target["base_version"] != "v0.0.0.8" ||
+      !StringMatches(target["module_xxh3"], kHex64Upper) ||
+      target["module_xxh3"] != "892639B654015428" ||
+      target["entry_point"] != "821F5ED0" ||
+      target["region_mask"] != "0000FDFF") {
+    return SetError("NTSC-U/J target identity", error);
+  }
+
+  const Json& session = header["session"];
+  if (!ExactKeys(session, {"content_manifest_sha256", "runtime_config_sha256",
+                           "behavior_config_sha256",
+                           "profile_save_manifest_sha256", "route_sha256",
+                           "segment_origin"})) {
+    return SetError("session shape", error);
+  }
+  for (const char* key : {"content_manifest_sha256", "runtime_config_sha256",
+                          "behavior_config_sha256",
+                          "profile_save_manifest_sha256", "route_sha256"}) {
+    if (!StringMatches(session[key], kSha256)) {
+      return SetError(std::string("session identity: ") + key, error);
+    }
+  }
+  if (session["segment_origin"] != "clean_boot" &&
+      session["segment_origin"] != "sealed_retail_save") {
+    return SetError("session segment_origin", error);
+  }
+
+  const Json& segment = header["segment"];
+  if (!ExactKeys(segment, {"kind", "parent_replay_sha256",
+                           "parent_payload_sha256", "parent_start_marker",
+                           "parent_marker_count"}) ||
+      segment["kind"] != "full_recording" ||
+      !segment["parent_replay_sha256"].is_null() ||
+      !segment["parent_payload_sha256"].is_null() ||
+      !segment["parent_start_marker"].is_null() ||
+      !segment["parent_marker_count"].is_null()) {
+    return SetError("full recording lineage", error);
+  }
+
+  const Json& sync = header["sync"];
+  const Json portable_guards =
+      Json::array({"marker_index", "poll_in_marker", "caller_lr",
+                   "user_index", "flags", "state_ptr_null"});
+  const Json lane_local = Json::array({"thread_id", "state_ptr"});
+  const Json telemetry = Json::array({"guest_tick", "present_index"});
+  if (!ExactKeys(sync, {"primary", "portable_guards",
+                        "lane_local_diagnostics", "telemetry",
+                        "marker_contract", "cadence"}) ||
+      sync["primary"] != "poll_index" ||
+      sync["portable_guards"] != portable_guards ||
+      sync["lane_local_diagnostics"] != lane_local ||
+      sync["telemetry"] != telemetry) {
+    return SetError("sync contract", error);
+  }
+  const Json& marker = sync["marker_contract"];
+  if (!ExactKeys(marker, {"role", "address", "phase", "code"}) ||
+      marker["role"] != "ac6_frame_input_stage" ||
+      marker["address"] != "821CA940" || marker["phase"] != "before_input") {
+    return SetError("NTSC-U/J marker contract", error);
+  }
+  const Json& code = marker["code"];
+  uint64_t code_length = 0;
+  if (!ExactKeys(code, {"image_rva", "length", "sha256"}) ||
+      code["image_rva"] != "001CA940" ||
+      !Unsigned(code["length"], 4096, code_length) || code_length != 328 ||
+      code["sha256"] != kMarkerCodeSha256) {
+    return SetError("NTSC-U/J marker code contract", error);
+  }
+  const Json& cadence = sync["cadence"];
+  if (!ExactKeys(cadence, {"status", "integrity_level", "source_hz",
+                           "native_hz", "resampling", "projection", "census",
+                           "native_clock"}) ||
+      cadence["status"] != "unqualified" ||
+      !cadence["integrity_level"].is_null() ||
+      !cadence["source_hz"].is_null() ||
+      !cadence["native_hz"].is_null() ||
+      cadence["resampling"] != "refuse" ||
+      cadence["projection"] != "unique_successful_user0_poll" ||
+      !cadence["census"].is_null() || !cadence["native_clock"].is_null()) {
+    return SetError("unqualified cadence contract", error);
+  }
+  return true;
+}
+
+struct ValidationSummary {
+  uint64_t poll_count{0};
+  uint64_t marker_count{0};
+  uint64_t present_count{0};
+};
+
+bool SplitLines(std::string_view data, std::vector<std::string_view>& lines,
+                std::string& error) {
+  if (data.empty() || data.size() > kMaxReplayBytes || data.back() != '\n' ||
+      data.find('\r') != std::string_view::npos) {
+    return SetError("file framing or byte bound", error);
+  }
+  std::size_t start = 0;
+  while (start < data.size()) {
+    const std::size_t end = data.find('\n', start);
+    if (end == std::string_view::npos || end - start + 1 > kMaxLineBytes) {
+      return SetError("file line bound", error);
+    }
+    lines.emplace_back(data.substr(start, end - start + 1));
+    if (lines.size() > kMaxEvents + 2u) {
+      return SetError("file record bound", error);
+    }
+    start = end + 1;
+  }
+  return lines.size() >= 3u;
+}
+
+bool ValidateEvents(const std::vector<Json>& events, ValidationSummary& summary,
+                    std::string& error) {
+  if (events.empty() || events.size() > kMaxEvents) {
+    return SetError("empty replay or event count bound", error);
+  }
+  uint64_t expected_poll = 0;
+  uint64_t expected_marker = 1;
+  uint64_t current_marker = 0;
+  uint64_t expected_poll_in_marker = 0;
+  uint64_t last_present = 0;
+  uint64_t last_guest_tick = 0;
+
+  for (std::size_t sequence = 0; sequence < events.size(); ++sequence) {
+    const Json& event = events[sequence];
+    uint64_t event_sequence = 0;
+    if (!event.contains("kind") || !event["kind"].is_string()) {
+      return SetError("event kind", error);
+    }
+    const std::string kind = event["kind"].get<std::string>();
+    if (kind == "marker") {
+      uint64_t marker_index = 0;
+      uint64_t poll_index = 0;
+      if (!ExactKeys(event, {"kind", "sequence", "marker_index",
+                             "poll_index", "guest_tick", "present_index"}) ||
+          !Unsigned(event["sequence"], kMaxEvents, event_sequence) ||
+          event_sequence != sequence ||
+          !Unsigned(event["marker_index"], kMaxMarkers, marker_index) ||
+          marker_index != expected_marker ||
+          !Unsigned(event["poll_index"], kMaxEvents, poll_index) ||
+          poll_index != expected_poll ||
+          (summary.marker_count != 0 && expected_poll_in_marker == 0)) {
+        return SetError("marker order", error);
+      }
+      ++summary.marker_count;
+      current_marker = expected_marker++;
+      expected_poll_in_marker = 0;
+    } else if (kind == "poll") {
+      uint64_t poll_index = 0;
+      uint64_t marker_index = 0;
+      uint64_t poll_in_marker = 0;
+      uint64_t thread_id = 0;
+      uint64_t caller_lr = 0;
+      uint64_t user_index = 0;
+      uint64_t flags = 0;
+      uint64_t state_ptr = 0;
+      uint64_t result = 0;
+      if (!ExactKeys(event, {"kind", "sequence", "poll_index",
+                             "marker_index", "poll_in_marker", "guest_tick",
+                             "present_index", "thread_id", "caller_lr",
+                             "user_index", "flags", "state_ptr", "result",
+                             "state"}) ||
+          !Unsigned(event["sequence"], kMaxEvents, event_sequence) ||
+          event_sequence != sequence ||
+          !Unsigned(event["poll_index"], kMaxEvents, poll_index) ||
+          poll_index != expected_poll ||
+          !Unsigned(event["marker_index"], kMaxMarkers, marker_index) ||
+          marker_index != current_marker ||
+          !Unsigned(event["poll_in_marker"], kMaxEvents, poll_in_marker) ||
+          poll_in_marker != expected_poll_in_marker ||
+          !Unsigned(event["thread_id"], UINT32_MAX, thread_id) ||
+          !Unsigned(event["caller_lr"], UINT32_MAX, caller_lr) ||
+          !ExpectedCallerLr(caller_lr) ||
+          !Unsigned(event["user_index"], UINT32_MAX, user_index) ||
+          !Unsigned(event["flags"], UINT32_MAX, flags) ||
+          !Unsigned(event["state_ptr"], UINT32_MAX, state_ptr) ||
+          !Unsigned(event["result"], UINT32_MAX, result)) {
+        return SetError("poll order, shape or range", error);
+      }
+      if (result == 0 && state_ptr != 0) {
+        if (!ValidateState(event["state"], nullptr, error, "poll state")) {
+          return false;
+        }
+      } else if (!event["state"].is_null()) {
+        return SetError("poll state/result/pointer", error);
+      }
+      ++expected_poll;
+      ++expected_poll_in_marker;
+    } else {
+      return SetError("event kind", error);
+    }
+
+    uint64_t guest_tick = 0;
+    uint64_t present_index = 0;
+    if (!Unsigned(event["guest_tick"], UINT64_MAX, guest_tick) ||
+        !Unsigned(event["present_index"], UINT64_MAX, present_index) ||
+        guest_tick < last_guest_tick || present_index < last_present) {
+      return SetError("event telemetry order", error);
+    }
+    last_guest_tick = guest_tick;
+    last_present = present_index;
+  }
+
+  if (expected_poll == 0 || summary.marker_count == 0 ||
+      expected_poll_in_marker == 0) {
+    return SetError("replay terminal shape", error);
+  }
+  summary.poll_count = expected_poll;
+  summary.present_count = last_present;
+  return true;
+}
+
+bool ParseReplay(std::string_view data, const Json* expected_header,
+                 std::vector<std::string>* event_lines, Json* parsed_header,
+                 std::string& error) {
+  std::vector<std::string_view> lines;
+  if (!SplitLines(data, lines, error)) return false;
+
+  Json header;
+  if (!ParseCanonicalLine(lines.front(), header, error, "header") ||
+      !ValidateHeader(header, error)) {
+    return false;
+  }
+  if (expected_header && header != *expected_header) {
+    return SetError("runtime header mismatch", error);
+  }
+
+  std::vector<Json> events;
+  events.reserve(lines.size() - 2u);
+  for (std::size_t index = 1; index + 1 < lines.size(); ++index) {
+    Json event;
+    std::ostringstream where;
+    where << "event line " << index + 1u;
+    if (!ParseCanonicalLine(lines[index], event, error, where.str())) return false;
+    events.emplace_back(std::move(event));
+  }
+  ValidationSummary summary;
+  if (!ValidateEvents(events, summary, error)) return false;
+
+  Json footer;
+  if (!ParseCanonicalLine(lines.back(), footer, error, "footer") ||
+      !ExactKeys(footer, {"kind", "event_count", "poll_count",
+                          "marker_count", "present_count", "payload_sha256"}) ||
+      footer["kind"] != "footer") {
+    return SetError("footer identity or shape", error);
+  }
+  uint64_t event_count = 0;
+  uint64_t poll_count = 0;
+  uint64_t marker_count = 0;
+  uint64_t present_count = 0;
+  if (!Unsigned(footer["event_count"], kMaxEvents, event_count) ||
+      event_count != events.size() ||
+      !Unsigned(footer["poll_count"], kMaxEvents, poll_count) ||
+      poll_count != summary.poll_count ||
+      !Unsigned(footer["marker_count"], kMaxMarkers, marker_count) ||
+      marker_count != summary.marker_count ||
+      !Unsigned(footer["present_count"], UINT64_MAX, present_count) ||
+      present_count < summary.present_count ||
+      !StringMatches(footer["payload_sha256"], kSha256)) {
+    return SetError("footer counts or range", error);
+  }
+
+  Json footer_payload{{"kind", "footer"},
+                      {"event_count", event_count},
+                      {"poll_count", poll_count},
+                      {"marker_count", marker_count},
+                      {"present_count", present_count}};
+  const std::size_t footer_offset = data.size() - lines.back().size();
+  std::string digest_input(data.substr(0, footer_offset));
+  digest_input += CanonicalLine(footer_payload);
+  if (footer["payload_sha256"].get<std::string>() !=
+      rex::crypto::sha256(digest_input)) {
+    return SetError("footer payload_sha256", error);
+  }
+
+  if (event_lines) {
+    event_lines->clear();
+    event_lines->reserve(lines.size() - 2u);
+    for (std::size_t index = 1; index + 1 < lines.size(); ++index) {
+      event_lines->emplace_back(lines[index]);
+    }
+  }
+  if (parsed_header) *parsed_header = std::move(header);
+  return true;
+}
+
+bool ParseHeader(std::string_view line, Json& header, std::string& canonical,
+                 std::string& error) {
+  if (!ParseCanonicalLine(line, header, error, "expected header") ||
+      !ValidateHeader(header, error)) {
+    return false;
+  }
+  canonical.assign(line);
+  return true;
+}
+
+bool ReadEvent(const std::vector<std::string>& lines, std::size_t cursor,
+               Json& event, std::string& error) {
+  if (cursor >= lines.size()) return SetError("replay EOF", error);
+  return ParseCanonicalLine(lines[cursor], event, error, "replay event");
+}
+
+std::string Hex32(uint32_t value) {
+  std::ostringstream stream;
+  stream << "0x" << std::hex << std::uppercase << value;
+  return stream.str();
+}
+
+}  // namespace
+
+void Service::Reset() {
+  mode_ = Mode::kDisabled;
+  failed_ = false;
+  failure_.clear();
+  header_line_.clear();
+  body_.clear();
+  replay_bytes_.clear();
+  replay_event_lines_.clear();
+  replay_cursor_ = 0;
+  sequence_ = 0;
+  poll_index_ = 0;
+  marker_index_ = 0;
+  poll_in_marker_ = 0;
+  last_guest_tick_ = 0;
+  last_present_index_ = 0;
+}
+
+bool Service::Fail(std::string message, std::string& error) {
+  if (!failed_) failure_ = std::move(message);
+  failed_ = true;
+  error = failure_;
+  return false;
+}
+
+void Service::Abort(std::string reason) {
+  if (!failed_) failure_ = std::move(reason);
+  failed_ = true;
+}
+
+bool Service::BeginRecord(std::string_view canonical_header,
+                          std::string& error) {
+  Reset();
+  Json header;
+  if (!ParseHeader(canonical_header, header, header_line_, error)) {
+    return Fail(error, error);
+  }
+  if (header_line_.size() > kMaxReplayBytes) {
+    return Fail("header byte bound", error);
+  }
+  mode_ = Mode::kRecord;
+  body_ = header_line_;
+  return true;
+}
+
+bool Service::BeginReplay(std::string_view replay,
+                          std::string_view canonical_expected_header,
+                          std::string& error) {
+  Reset();
+  Json expected;
+  if (!ParseHeader(canonical_expected_header, expected, header_line_, error)) {
+    return Fail(error, error);
+  }
+  Json parsed;
+  if (!ParseReplay(replay, &expected, &replay_event_lines_, &parsed, error)) {
+    return Fail(error, error);
+  }
+  replay_bytes_.assign(replay);
+  mode_ = Mode::kReplay;
+  return true;
+}
+
+bool Service::MarkerBefore(uint64_t guest_tick, uint64_t present_index,
+                           std::string& error) {
+  if (mode_ == Mode::kDisabled) return true;
+  if (failed_) return SetError(failure_, error);
+
+  if (mode_ == Mode::kReplay) {
+    Json event;
+    if (!ReadEvent(replay_event_lines_, replay_cursor_, event, error)) {
+      return Fail(error, error);
+    }
+    uint64_t event_marker = 0;
+    uint64_t event_poll = 0;
+    if (event["kind"] != "marker" ||
+        !Unsigned(event["marker_index"], kMaxMarkers, event_marker) ||
+        event_marker != marker_index_ + 1u ||
+        !Unsigned(event["poll_index"], kMaxEvents, event_poll) ||
+        event_poll != poll_index_) {
+      std::ostringstream message;
+      message << "divergence sequence=" << sequence_
+              << " expected=marker marker_index=" << marker_index_ + 1u
+              << " poll_index=" << poll_index_;
+      return Fail(message.str(), error);
+    }
+    ++replay_cursor_;
+    ++sequence_;
+    ++marker_index_;
+    poll_in_marker_ = 0;
+    return true;
+  }
+
+  if (guest_tick < last_guest_tick_ || present_index < last_present_index_) {
+    return Fail("record marker telemetry order", error);
+  }
+  if (marker_index_ != 0 && poll_in_marker_ == 0) {
+    return Fail("record previous marker has no polls", error);
+  }
+  if (sequence_ >= kMaxEvents || marker_index_ >= kMaxMarkers) {
+    return Fail("record marker/event bound", error);
+  }
+  ++marker_index_;
+  poll_in_marker_ = 0;
+  Json event{{"kind", "marker"},
+             {"sequence", sequence_},
+             {"marker_index", marker_index_},
+             {"poll_index", poll_index_},
+             {"guest_tick", guest_tick},
+             {"present_index", present_index}};
+  const std::string line = CanonicalLine(event);
+  if (line.size() > kMaxReplayBytes - body_.size()) {
+    return Fail("record byte bound", error);
+  }
+  body_ += line;
+  ++sequence_;
+  last_guest_tick_ = guest_tick;
+  last_present_index_ = present_index;
+  return true;
+}
+
+bool Service::RecordPoll(const PollObservation& observation,
+                         std::string& error) {
+  if (mode_ != Mode::kRecord) {
+    return Fail("record poll outside record mode", error);
+  }
+  if (failed_) return SetError(failure_, error);
+  if (sequence_ >= kMaxEvents || poll_index_ >= kMaxEvents) {
+    return Fail("record poll/event bound", error);
+  }
+  if (!ExpectedCallerLr(observation.caller_lr)) {
+    return Fail("record poll unexpected NTSC-U/J caller_lr", error);
+  }
+  if (observation.guest_tick < last_guest_tick_ ||
+      observation.present_index < last_present_index_) {
+    return Fail("record poll telemetry order", error);
+  }
+  if ((observation.result == 0 && observation.state_ptr != 0) !=
+      observation.state.has_value()) {
+    return Fail("record poll state/result/pointer", error);
+  }
+
+  Json event{{"kind", "poll"},
+             {"sequence", sequence_},
+             {"poll_index", poll_index_},
+             {"marker_index", marker_index_},
+             {"poll_in_marker", poll_in_marker_},
+             {"guest_tick", observation.guest_tick},
+             {"present_index", observation.present_index},
+             {"thread_id", observation.thread_id},
+             {"caller_lr", observation.caller_lr},
+             {"user_index", observation.user_index},
+             {"flags", observation.flags},
+             {"state_ptr", observation.state_ptr},
+             {"result", observation.result},
+             {"state", observation.state ? StateJson(*observation.state)
+                                           : Json(nullptr)}};
+  const std::string line = CanonicalLine(event);
+  if (line.size() > kMaxReplayBytes - body_.size()) {
+    return Fail("record byte bound", error);
+  }
+  body_ += line;
+  ++sequence_;
+  ++poll_index_;
+  ++poll_in_marker_;
+  last_guest_tick_ = observation.guest_tick;
+  last_present_index_ = observation.present_index;
+  return true;
+}
+
+bool Service::ReplayNextPoll(const PollGuards& guards, ReplayPoll& output,
+                             std::string& error) {
+  if (mode_ != Mode::kReplay) {
+    return Fail("replay poll outside replay mode", error);
+  }
+  if (failed_) return SetError(failure_, error);
+  Json event;
+  if (!ReadEvent(replay_event_lines_, replay_cursor_, event, error)) {
+    return Fail(error, error);
+  }
+
+  uint64_t event_poll = 0;
+  uint64_t event_marker = 0;
+  uint64_t event_poll_in_marker = 0;
+  uint64_t caller_lr = 0;
+  uint64_t user_index = 0;
+  uint64_t flags = 0;
+  uint64_t state_ptr = 0;
+  uint64_t result = 0;
+  if (event["kind"] != "poll" ||
+      !Unsigned(event["poll_index"], kMaxEvents, event_poll) ||
+      event_poll != poll_index_ ||
+      !Unsigned(event["marker_index"], kMaxMarkers, event_marker) ||
+      event_marker != marker_index_ ||
+      !Unsigned(event["poll_in_marker"], kMaxEvents, event_poll_in_marker) ||
+      event_poll_in_marker != poll_in_marker_ ||
+      !Unsigned(event["caller_lr"], UINT32_MAX, caller_lr) ||
+      !ExpectedCallerLr(caller_lr) ||
+      !Unsigned(event["user_index"], UINT32_MAX, user_index) ||
+      !Unsigned(event["flags"], UINT32_MAX, flags) ||
+      !Unsigned(event["state_ptr"], UINT32_MAX, state_ptr) ||
+      !Unsigned(event["result"], UINT32_MAX, result)) {
+    std::ostringstream message;
+    message << "divergence poll_index=" << poll_index_
+            << " expected=poll marker_index=" << marker_index_
+            << " poll_in_marker=" << poll_in_marker_;
+    return Fail(message.str(), error);
+  }
+
+  auto mismatch = [&](std::string_view guard, std::string expected,
+                      std::string actual) {
+    std::ostringstream message;
+    message << "divergence poll_index=" << poll_index_ << " guard=" << guard
+            << " expected=" << expected << " actual=" << actual;
+    return Fail(message.str(), error);
+  };
+  if (caller_lr != guards.caller_lr) {
+    return mismatch("caller_lr", Hex32(static_cast<uint32_t>(caller_lr)),
+                    Hex32(guards.caller_lr));
+  }
+  if (user_index != guards.user_index) {
+    return mismatch("user_index", std::to_string(user_index),
+                    std::to_string(guards.user_index));
+  }
+  if (flags != guards.flags) {
+    return mismatch("flags", Hex32(static_cast<uint32_t>(flags)),
+                    Hex32(guards.flags));
+  }
+  const bool recorded_null = state_ptr == 0;
+  if (recorded_null != guards.state_ptr_null) {
+    return mismatch("state_ptr_null", recorded_null ? "true" : "false",
+                    guards.state_ptr_null ? "true" : "false");
+  }
+
+  output = {};
+  output.result = static_cast<uint32_t>(result);
+  if (result == 0 && state_ptr != 0) {
+    ControllerState state;
+    if (!ValidateState(event["state"], &state, error, "replay state")) {
+      return Fail(error, error);
+    }
+    output.state = state;
+  }
+  ++replay_cursor_;
+  ++sequence_;
+  ++poll_index_;
+  ++poll_in_marker_;
+  return true;
+}
+
+bool Service::Finalize(std::string& sealed_recording, std::string& error) {
+  sealed_recording.clear();
+  if (failed_) return SetError(failure_, error);
+  if (mode_ == Mode::kDisabled) return true;
+  if (mode_ == Mode::kReplay) {
+    if (replay_cursor_ != replay_event_lines_.size()) {
+      std::ostringstream message;
+      message << "replay has " << replay_event_lines_.size() - replay_cursor_
+              << " unconsumed events at sequence=" << sequence_;
+      return Fail(message.str(), error);
+    }
+    mode_ = Mode::kDisabled;
+    return true;
+  }
+
+  if (sequence_ == 0 || poll_index_ == 0 || marker_index_ == 0 ||
+      poll_in_marker_ == 0) {
+    return Fail("recording has no complete marker/poll window", error);
+  }
+  Json footer_payload{{"kind", "footer"},
+                      {"event_count", sequence_},
+                      {"poll_count", poll_index_},
+                      {"marker_count", marker_index_},
+                      {"present_count", last_present_index_}};
+  const std::string digest =
+      rex::crypto::sha256(body_ + CanonicalLine(footer_payload));
+  Json footer = footer_payload;
+  footer["payload_sha256"] = digest;
+  const std::string footer_line = CanonicalLine(footer);
+  if (footer_line.size() > kMaxReplayBytes - body_.size()) {
+    return Fail("sealed replay byte bound", error);
+  }
+  sealed_recording = body_ + footer_line;
+  std::string validation_error;
+  if (!ParseReplay(sealed_recording, nullptr, nullptr, nullptr,
+                   validation_error)) {
+    sealed_recording.clear();
+    return Fail("self-validation failed: " + validation_error, error);
+  }
+  mode_ = Mode::kDisabled;
+  return true;
+}
+
+}  // namespace ac6::oracle::controller_replay
