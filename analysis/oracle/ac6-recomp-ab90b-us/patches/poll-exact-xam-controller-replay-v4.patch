+#include "generated/ac6recomp_config.h"
+
+#include "ac6_controller_input_replay.h"
+#include "ac6_controller_input_replay_io.h"
+
+#include <filesystem>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+#include <native/chrono/clock.h>
+#include <rex/ac6_controller_input_replay.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ppc/function.h>
+#include <rex/system/thread_state.h>
+
+#include "d3d_hooks.h"
+
+#ifndef PPC_CONFIG_H_INCLUDED
+#error "AC6 oracle PPC wrappers require generated/ac6recomp_config.h first"
+#endif
+
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_header_path, "", "AC6/Oracle",
+                      "Canonical ac6.controller-input-replay.v4 header JSONL");
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_record_path, "", "AC6/Oracle",
+                      "New poll-exact controller recording path");
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_replay_path, "", "AC6/Oracle",
+                      "Sealed poll-exact controller replay path");
+
+namespace ac6::oracle {
+namespace {
+
+using controller_replay::ControllerState;
+using controller_replay::Mode;
+using controller_replay::PendingPublication;
+using controller_replay::PollGuards;
+using controller_replay::PollObservation;
+using controller_replay::ReplayPoll;
+using controller_replay::Service;
+
+constexpr std::size_t kMaxHeaderBytes = 1024u * 1024u;
+constexpr uint32_t kExpectedTitleId = 0x4E4D07D1u;
+constexpr uint32_t kExpectedEntryPoint = 0x821F5ED0u;
+constexpr uint32_t kExpectedCallerLr0 = 0x8234CEE0u;
+constexpr uint32_t kExpectedCallerLr1 = 0x8234CFA4u;
+
+std::mutex g_controller_mutex;
+Service g_controller_service;
+std::filesystem::path g_record_path;
+bool g_controller_initialized = false;
+PendingPublication g_pending_publication;
+
+struct Telemetry {
+  uint64_t guest_tick;
+  uint64_t present_index;
+  uint32_t thread_id;
+  uint32_t caller_lr;
+};
+
+Telemetry CurrentTelemetry() {
+  rex::runtime::ThreadState *thread = rex::runtime::ThreadState::Get();
+  if (!thread || !thread->context()) {
+    REX_FATAL("AC6 controller replay called without a bound guest thread");
+  }
+  return {
+      rex::chrono::Clock::PeekGuestTickCount(),
+      ac6::d3d::GetFrameCaptureSummary().frame_index,
+      thread->thread_id(),
+      static_cast<uint32_t>(thread->context()->lr),
+  };
+}
+
+ControllerState ToServiceState(const XamControllerState &state) {
+  return {
+      state.packet_number, state.buttons,  state.left_trigger,
+      state.right_trigger, state.thumb_lx, state.thumb_ly,
+      state.thumb_rx,      state.thumb_ry,
+  };
+}
+
+XamControllerState FromServiceState(const ControllerState &state) {
+  return {
+      state.packet_number, state.buttons,  state.left_trigger,
+      state.right_trigger, state.thumb_lx, state.thumb_ly,
+      state.thumb_rx,      state.thumb_ry,
+  };
+}
+
+[[noreturn]] void FatalControllerReplay(std::string_view operation,
+                                        const std::string &detail) {
+  REX_FATAL("AC6 controller replay {} failed: {}", operation, detail);
+}
+
+} // namespace
+
+bool InitializeControllerInputReplay(uint32_t title_id, uint32_t entry_point) {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (g_controller_initialized) {
+    REXLOG_ERROR("AC6 controller replay initialized more than once");
+    return false;
+  }
+  if (title_id != kExpectedTitleId || entry_point != kExpectedEntryPoint) {
+    REXLOG_ERROR("AC6 controller replay rejected loaded module title={:08X} "
+                 "entry={:08X}; "
+                 "expected qualified NTSC-U/J title={:08X} entry={:08X}",
+                 title_id, entry_point, kExpectedTitleId, kExpectedEntryPoint);
+    return false;
+  }
+
+  const std::filesystem::path header_path =
+      REXCVAR_GET(ac6_oracle_controller_header_path);
+  const std::filesystem::path record_path =
+      REXCVAR_GET(ac6_oracle_controller_record_path);
+  const std::filesystem::path replay_path =
+      REXCVAR_GET(ac6_oracle_controller_replay_path);
+  if (record_path.empty() && replay_path.empty()) {
+    if (!header_path.empty()) {
+      REXLOG_ERROR(
+          "AC6 controller header configured without record/replay mode");
+      return false;
+    }
+    return true;
+  }
+  if (header_path.empty() || (!record_path.empty() && !replay_path.empty())) {
+    REXLOG_ERROR("AC6 controller replay requires one mode and one header");
+    return false;
+  }
+
+  Service staged_service;
+  std::filesystem::path staged_record_path;
+  std::string header;
+  std::string error;
+  if (!controller_replay::ReadBoundedFile(header_path, kMaxHeaderBytes, header,
+                                          error)) {
+    REXLOG_ERROR("AC6 controller replay initialization: {}", error);
+    return false;
+  }
+  if (!record_path.empty()) {
+    if (record_path == header_path || std::filesystem::exists(record_path) ||
+        !staged_service.BeginRecord(header, error)) {
+      REXLOG_ERROR("AC6 controller record initialization: {}",
+                   error.empty() ? "output identity" : error);
+      return false;
+    }
+    staged_record_path = record_path;
+    REXLOG_INFO(
+        "AC6 controller raw v4 record armed before guest launch at NTSC-U/J "
+        "marker 0x821CA940 BEFORE (cadence unqualified; census external)");
+  } else {
+    if (replay_path == header_path) {
+      REXLOG_ERROR("AC6 controller replay and header paths must differ");
+      return false;
+    }
+    std::string replay;
+    if (!controller_replay::ReadBoundedFile(
+            replay_path, controller_replay::kMaxReplayBytes, replay, error) ||
+        !staged_service.BeginReplay(replay, header, error)) {
+      REXLOG_ERROR("AC6 controller replay initialization: {}", error);
+      return false;
+    }
+    REXLOG_INFO(
+        "AC6 controller raw v4 replay loaded before guest launch at NTSC-U/J "
+        "marker 0x821CA940 BEFORE (cadence unqualified; census external)");
+  }
+
+  // Publish the fully validated state in one critical section only after all
+  // input and configuration checks have succeeded.
+  g_controller_service = std::move(staged_service);
+  g_record_path = std::move(staged_record_path);
+  g_pending_publication.Reset();
+  g_controller_initialized = true;
+  return true;
+}
+
+bool FinalizeControllerInputReplay() {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (!g_controller_initialized)
+    return true;
+  const Mode mode = g_controller_service.mode();
+  std::string sealed;
+  std::string error;
+  if (!g_pending_publication.pending()) {
+    if (!g_controller_service.Finalize(sealed, error)) {
+      REXLOG_ERROR("AC6 controller replay finalization: {}", error);
+      return false;
+    }
+    if (mode == Mode::kRecord &&
+        !g_pending_publication.Stage(g_record_path, std::move(sealed), error)) {
+      REXLOG_ERROR("AC6 controller record staging: {}", error);
+      return false;
+    }
+  }
+  if (g_pending_publication.pending() &&
+      !g_pending_publication.Publish(error)) {
+    REXLOG_ERROR("AC6 controller record publication: {}", error);
+    return false;
+  }
+  if (mode != Mode::kDisabled) {
+    REXLOG_INFO("AC6 controller replay finalized polls={} markers={}",
+                g_controller_service.poll_index(),
+                g_controller_service.marker_index());
+  }
+  g_controller_initialized = false;
+  g_record_path.clear();
+  g_pending_publication.Reset();
+  return true;
+}
+
+XamControllerPollAction
+BeginXamInputGetState(uint32_t user_index, uint32_t flags, uint32_t state_ptr,
+                      uint32_t &result, XamControllerState &state,
+                      bool &has_state, XamControllerPollRecord &record) {
+  record = {};
+  g_controller_mutex.lock();
+  const Mode mode = g_controller_service.mode();
+  if (mode == Mode::kDisabled) {
+    g_controller_mutex.unlock();
+    return XamControllerPollAction::kPhysical;
+  }
+  const Telemetry telemetry = CurrentTelemetry();
+  if (telemetry.caller_lr != kExpectedCallerLr0 &&
+      telemetry.caller_lr != kExpectedCallerLr1) {
+    const uint32_t caller_lr = telemetry.caller_lr;
+    g_controller_mutex.unlock();
+    FatalControllerReplay(
+        "poll caller LR",
+        fmt::format("unexpected NTSC-U/J LR 0x{:08X}", caller_lr));
+  }
+  if (mode == Mode::kReplay) {
+    ReplayPoll replay;
+    std::string error;
+    const bool accepted = g_controller_service.ReplayNextPoll(
+        {telemetry.caller_lr, user_index, flags, state_ptr == 0}, replay,
+        error);
+    if (accepted) {
+      result = replay.result;
+      has_state = replay.state.has_value();
+      if (replay.state)
+        state = FromServiceState(*replay.state);
+    }
+    g_controller_mutex.unlock();
+    if (!accepted)
+      FatalControllerReplay("poll", error);
+    return XamControllerPollAction::kReplay;
+  }
+
+  record = {
+      true,
+      telemetry.guest_tick,
+      telemetry.present_index,
+      telemetry.thread_id,
+      telemetry.caller_lr,
+      user_index,
+      flags,
+      state_ptr,
+  };
+  return XamControllerPollAction::kRecord;
+}
+
+void AbortRecordXamInputGetState(XamControllerPollRecord &record) {
+  if (!record.armed)
+    return;
+  g_controller_service.Abort(
+      "physical input call threw after record admission");
+  record.armed = false;
+  g_controller_mutex.unlock();
+}
+
+void CompleteRecordXamInputGetState(XamControllerPollRecord &record,
+                                    uint32_t result,
+                                    const XamControllerState *state) {
+  if (!record.armed)
+    return;
+  PollObservation observation{
+      record.guest_tick,
+      record.present_index,
+      record.thread_id,
+      record.caller_lr,
+      record.user_index,
+      record.flags,
+      record.state_ptr,
+      result,
+      state ? std::optional<ControllerState>(ToServiceState(*state))
+            : std::nullopt,
+  };
+  std::string error;
+  const bool accepted = g_controller_service.RecordPoll(observation, error);
+  record.armed = false;
+  g_controller_mutex.unlock();
+  if (!accepted)
+    FatalControllerReplay("record poll", error);
+}
+
+void ControllerInputMarkerBefore() {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (g_controller_service.mode() == Mode::kDisabled)
+    return;
+  const Telemetry telemetry = CurrentTelemetry();
+  std::string error;
+  if (!g_controller_service.MarkerBefore(telemetry.guest_tick,
+                                         telemetry.present_index, error)) {
+    FatalControllerReplay("marker", error);
+  }
+}
+
+} // namespace ac6::oracle
+
+PPC_EXTERN_FUNC(__imp__rex_sub_821CA940);
+
+PPC_FUNC_IMPL(rex_sub_821CA940) {
+  PPC_FUNC_PROLOGUE();
+  ac6::oracle::ControllerInputMarkerBefore();
+  __imp__rex_sub_821CA940(ctx, base);
+}
