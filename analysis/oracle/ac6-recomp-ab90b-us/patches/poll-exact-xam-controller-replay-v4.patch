+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ac6::oracle::controller_replay {
+
+constexpr std::size_t kMaxReplayBytes = 128u * 1024u * 1024u;
+constexpr std::size_t kMaxEvents = 1'000'000u;
+
+struct ControllerState {
+  uint32_t packet_number{0};
+  uint16_t buttons{0};
+  uint8_t left_trigger{0};
+  uint8_t right_trigger{0};
+  int16_t thumb_lx{0};
+  int16_t thumb_ly{0};
+  int16_t thumb_rx{0};
+  int16_t thumb_ry{0};
+
+  bool operator==(const ControllerState&) const = default;
+};
+
+struct PollObservation {
+  uint64_t guest_tick{0};
+  uint64_t present_index{0};
+  uint32_t thread_id{0};
+  uint32_t caller_lr{0};
+  uint32_t user_index{0};
+  uint32_t flags{0};
+  uint32_t state_ptr{0};
+  uint32_t result{0};
+  std::optional<ControllerState> state;
+};
+
+struct PollGuards {
+  uint32_t caller_lr{0};
+  uint32_t user_index{0};
+  uint32_t flags{0};
+  bool state_ptr_null{true};
+};
+
+struct ReplayPoll {
+  uint32_t result{0};
+  std::optional<ControllerState> state;
+};
+
+enum class Mode {
+  kDisabled,
+  kRecord,
+  kReplay,
+};
+
+// Poll-exact service for ac6.controller-input-replay.v4. The runtime owns file
+// IO; this class owns bounded parsing, canonical sealing and event ordering.
+class Service {
+ public:
+  bool BeginRecord(std::string_view canonical_header, std::string& error);
+  bool BeginReplay(std::string_view replay, std::string_view canonical_expected_header,
+                   std::string& error);
+
+  bool MarkerBefore(uint64_t guest_tick, uint64_t present_index, std::string& error);
+  bool RecordPoll(const PollObservation& observation, std::string& error);
+  bool ReplayNextPoll(const PollGuards& guards, ReplayPoll& output, std::string& error);
+  void Abort(std::string reason);
+
+  // Record mode returns the sealed JSONL. Replay mode requires exact EOF and
+  // returns an empty payload. Disabled mode is a no-op.
+  bool Finalize(std::string& sealed_recording, std::string& error);
+
+  [[nodiscard]] Mode mode() const { return mode_; }
+  [[nodiscard]] bool failed() const { return failed_; }
+  [[nodiscard]] uint64_t poll_index() const { return poll_index_; }
+  [[nodiscard]] uint64_t marker_index() const { return marker_index_; }
+
+ private:
+  bool Fail(std::string message, std::string& error);
+  void Reset();
+
+  Mode mode_{Mode::kDisabled};
+  bool failed_{false};
+  std::string failure_;
+  std::string header_line_;
+  std::string body_;
+  std::string replay_bytes_;
+  std::vector<std::string> replay_event_lines_;
+  std::size_t replay_cursor_{0};
+  uint64_t sequence_{0};
+  uint64_t poll_index_{0};
+  uint64_t marker_index_{0};
+  uint64_t poll_in_marker_{0};
+  uint64_t last_guest_tick_{0};
+  uint64_t last_present_index_{0};
+};
+
+}  // namespace ac6::oracle::controller_replay
diff --git a/src/ac6_controller_input_replay_io.cpp b/src/ac6_controller_input_replay_io.cpp
new file mode 100644
index 00000000..ede4dc22
--- /dev/null
+++ b/src/ac6_controller_input_replay_io.cpp
@@ -0,0 +1,259 @@
+#include "ac6_controller_input_replay_io.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <system_error>
+
+#if defined(_WIN32)
+#include <fcntl.h>
+#include <io.h>
+#include <sys/stat.h>
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace ac6::oracle::controller_replay {
+namespace {
+
+std::atomic<uint64_t> g_temporary_sequence{0};
+
+std::string ErrnoMessage(std::string_view operation) {
+  return std::string(operation) + ": " + std::strerror(errno);
+}
+
+#if defined(_WIN32)
+using FileStat = struct _stat64;
+
+int OpenRead(const std::filesystem::path &path) {
+  return _wopen(path.c_str(), _O_RDONLY | _O_BINARY);
+}
+
+int OpenWriteExclusive(const std::filesystem::path &path) {
+  return _wopen(path.c_str(), _O_WRONLY | _O_CREAT | _O_EXCL | _O_BINARY,
+                _S_IREAD | _S_IWRITE);
+}
+
+int StatDescriptor(int descriptor, FileStat *status) {
+  return _fstat64(descriptor, status);
+}
+
+int CloseDescriptor(int descriptor) { return _close(descriptor); }
+
+bool FlushDescriptor(int descriptor) {
+  const intptr_t handle = _get_osfhandle(descriptor);
+  return handle != -1 && FlushFileBuffers(reinterpret_cast<HANDLE>(handle));
+}
+
+bool FlushDirectory(const std::filesystem::path &) {
+  // Windows makes the file durable with FlushFileBuffers before the exclusive
+  // hard-link publication. Directory handles are not portably flushable.
+  return true;
+}
+#else
+using FileStat = struct stat;
+
+int OpenRead(const std::filesystem::path &path) {
+  return open(path.c_str(), O_RDONLY | O_CLOEXEC);
+}
+
+int OpenWriteExclusive(const std::filesystem::path &path) {
+  return open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+}
+
+int StatDescriptor(int descriptor, FileStat *status) {
+  return fstat(descriptor, status);
+}
+
+int CloseDescriptor(int descriptor) { return close(descriptor); }
+
+bool FlushDescriptor(int descriptor) { return fsync(descriptor) == 0; }
+
+bool FlushDirectory(const std::filesystem::path &path) {
+  const int descriptor = open(path.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (descriptor < 0)
+    return false;
+  const bool flushed = fsync(descriptor) == 0;
+  const bool closed = close(descriptor) == 0;
+  return flushed && closed;
+}
+#endif
+
+bool WriteAll(int descriptor, std::string_view payload) {
+  std::size_t offset = 0;
+  while (offset < payload.size()) {
+    const std::size_t remaining = payload.size() - offset;
+#if defined(_WIN32)
+    const unsigned int chunk = static_cast<unsigned int>(
+        std::min<std::size_t>(remaining, std::numeric_limits<int>::max()));
+    const int written = _write(descriptor, payload.data() + offset, chunk);
+#else
+    const ssize_t written =
+        write(descriptor, payload.data() + offset, remaining);
+#endif
+    if (written < 0 && errno == EINTR)
+      continue;
+    if (written <= 0)
+      return false;
+    offset += static_cast<std::size_t>(written);
+  }
+  return true;
+}
+
+bool RemoveIfPresent(const std::filesystem::path &path) {
+  std::error_code error;
+  const bool removed = std::filesystem::remove(path, error);
+  return !error && (removed || !std::filesystem::exists(path, error));
+}
+
+} // namespace
+
+bool ReadBoundedFile(const std::filesystem::path &path, std::size_t maximum,
+                     std::string &payload, std::string &error) {
+  payload.clear();
+  const int descriptor = OpenRead(path);
+  if (descriptor < 0) {
+    error = ErrnoMessage("input open failed");
+    return false;
+  }
+
+  FileStat status{};
+  if (StatDescriptor(descriptor, &status) != 0 || status.st_size <= 0 ||
+      static_cast<uint64_t>(status.st_size) > maximum) {
+    CloseDescriptor(descriptor);
+    error = "input empty or outside byte bound: " + path.string();
+    return false;
+  }
+
+  payload.resize(static_cast<std::size_t>(status.st_size));
+  std::size_t offset = 0;
+  while (offset < payload.size()) {
+    const std::size_t remaining = payload.size() - offset;
+#if defined(_WIN32)
+    const unsigned int chunk = static_cast<unsigned int>(
+        std::min<std::size_t>(remaining, std::numeric_limits<int>::max()));
+    const int read_count = _read(descriptor, payload.data() + offset, chunk);
+#else
+    const ssize_t read_count =
+        read(descriptor, payload.data() + offset, remaining);
+#endif
+    if (read_count < 0 && errno == EINTR)
+      continue;
+    if (read_count <= 0) {
+      CloseDescriptor(descriptor);
+      payload.clear();
+      error = "input truncated while reading: " + path.string();
+      return false;
+    }
+    offset += static_cast<std::size_t>(read_count);
+  }
+
+  char trailing = 0;
+#if defined(_WIN32)
+  const int trailing_count = _read(descriptor, &trailing, 1);
+#else
+  const ssize_t trailing_count = read(descriptor, &trailing, 1);
+#endif
+  const bool closed = CloseDescriptor(descriptor) == 0;
+  if (trailing_count != 0 || !closed) {
+    payload.clear();
+    error = "input changed or failed while reading: " + path.string();
+    return false;
+  }
+  return true;
+}
+
+bool PublishNewFile(const std::filesystem::path &destination,
+                    std::string_view payload, std::string &error) {
+  const std::filesystem::path parent = destination.parent_path().empty()
+                                           ? std::filesystem::current_path()
+                                           : destination.parent_path();
+  std::error_code filesystem_error;
+  if (payload.empty() || destination.filename().empty() ||
+      !std::filesystem::is_directory(parent, filesystem_error) ||
+      filesystem_error ||
+      std::filesystem::exists(destination, filesystem_error)) {
+    error = "record output parent/identity is invalid or already exists";
+    return false;
+  }
+
+  std::filesystem::path temporary;
+  int descriptor = -1;
+  for (uint32_t attempt = 0; attempt < 64; ++attempt) {
+    const uint64_t suffix =
+        g_temporary_sequence.fetch_add(1, std::memory_order_relaxed);
+    temporary = parent / ("." + destination.filename().string() +
+                          ".ac6-controller-" + std::to_string(suffix) + ".tmp");
+    descriptor = OpenWriteExclusive(temporary);
+    if (descriptor >= 0)
+      break;
+    if (errno != EEXIST)
+      break;
+  }
+  if (descriptor < 0) {
+    error = ErrnoMessage("exclusive temporary replay creation failed");
+    return false;
+  }
+
+  const bool data_durable =
+      WriteAll(descriptor, payload) && FlushDescriptor(descriptor);
+  const bool closed = CloseDescriptor(descriptor) == 0;
+  if (!data_durable || !closed) {
+    RemoveIfPresent(temporary);
+    error = "temporary replay write/fsync failed";
+    return false;
+  }
+
+  std::error_code link_error;
+  std::filesystem::create_hard_link(temporary, destination, link_error);
+  if (link_error) {
+    RemoveIfPresent(temporary);
+    error = "exclusive replay publication failed: " + link_error.message();
+    return false;
+  }
+
+  if (!FlushDirectory(parent) || !RemoveIfPresent(temporary) ||
+      !FlushDirectory(parent)) {
+    RemoveIfPresent(destination);
+    RemoveIfPresent(temporary);
+    FlushDirectory(parent);
+    error = "replay directory fsync/cleanup failed";
+    return false;
+  }
+  return true;
+}
+
+bool PendingPublication::Stage(std::filesystem::path destination,
+                               std::string payload, std::string &error) {
+  if (pending() || destination.empty() || payload.empty()) {
+    error = "publication staging state is invalid";
+    return false;
+  }
+  destination_ = std::move(destination);
+  payload_ = std::move(payload);
+  return true;
+}
+
+bool PendingPublication::Publish(std::string &error) {
+  if (!pending()) {
+    error = "no staged publication";
+    return false;
+  }
+  if (!PublishNewFile(destination_, payload_, error))
+    return false;
+  Reset();
+  return true;
+}
+
+void PendingPublication::Reset() {
+  destination_.clear();
+  payload_.clear();
+}
+
+} // namespace ac6::oracle::controller_replay
