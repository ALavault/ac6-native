@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstddef>
+#include <filesystem>
+#include <string>
+#include <string_view>
+
+namespace ac6::oracle::controller_replay {
+
+bool ReadBoundedFile(const std::filesystem::path &path, std::size_t maximum,
+                     std::string &payload, std::string &error);
+
+bool PublishNewFile(const std::filesystem::path &destination,
+                    std::string_view payload, std::string &error);
+
+// Retains a sealed recording until durable publication succeeds. This makes a
+// shutdown retry safe after an I/O or destination-collision failure.
+class PendingPublication {
+public:
+  bool Stage(std::filesystem::path destination, std::string payload,
+             std::string &error);
+  bool Publish(std::string &error);
+  void Reset();
+
+  [[nodiscard]] bool pending() const { return !payload_.empty(); }
+  [[nodiscard]] const std::filesystem::path &destination() const {
+    return destination_;
+  }
+
+private:
+  std::filesystem::path destination_;
+  std::string payload_;
+};
+
+} // namespace ac6::oracle::controller_replay
diff --git a/src/ac6_controller_input_replay_runtime.cpp b/src/ac6_controller_input_replay_runtime.cpp
