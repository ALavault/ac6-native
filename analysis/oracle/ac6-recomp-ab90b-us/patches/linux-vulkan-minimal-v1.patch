diff --git a/tests/ac6_posix_auto_reset_event_test.cpp b/tests/ac6_posix_auto_reset_event_test.cpp
new file mode 100644
index 00000000..1e7e00b1
--- /dev/null
+++ b/tests/ac6_posix_auto_reset_event_test.cpp
@@ -0,0 +1,56 @@
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <thread>
+
+#include <rex/thread.h>
+
+namespace {
+
+using namespace std::chrono_literals;
+
+bool CheckExistingWaiterOwnsSignal() {
+  auto event = rex::thread::Event::CreateAutoResetEvent(false);
+  std::atomic<bool> entering_wait{false};
+  std::atomic<rex::thread::WaitResult> existing_result{
+      rex::thread::WaitResult::kFailed};
+
+  std::thread existing_waiter([&] {
+    entering_wait.store(true, std::memory_order_release);
+    existing_result.store(rex::thread::Wait(event.get(), false, 1s),
+                          std::memory_order_release);
+  });
+
+  while (!entering_wait.load(std::memory_order_acquire)) {
+    std::this_thread::yield();
+  }
+  // Let the announced waiter enter the condition-variable wait before Set.
+  std::this_thread::sleep_for(10ms);
+
+  event->Set();
+  const auto later_result = rex::thread::Wait(event.get(), false, 5ms);
+  if (later_result == rex::thread::WaitResult::kSuccess) {
+    // Release the original waiter before reporting the stolen signal.
+    event->Set();
+  }
+  existing_waiter.join();
+
+  return existing_result.load(std::memory_order_acquire) ==
+             rex::thread::WaitResult::kSuccess &&
+         later_result == rex::thread::WaitResult::kTimeout;
+}
+
+}  // namespace
+
+int main() {
+  for (int iteration = 0; iteration < 64; ++iteration) {
+    if (!CheckExistingWaiterOwnsSignal()) {
+      std::fprintf(stderr,
+                   "auto-reset signal was stolen by a later waiter at "
+                   "iteration %d\n",
+                   iteration);
+      return 1;
+    }
+  }
+  return 0;
+}
diff --git a/tests/ac6_posix_socket_ioctl_test.cpp b/tests/ac6_posix_socket_ioctl_test.cpp
new file mode 100644
index 00000000..2d22e5ed
--- /dev/null
+++ b/tests/ac6_posix_socket_ioctl_test.cpp
@@ -0,0 +1,23 @@
+#include <fcntl.h>
+#include <sys/socket.h>
+
+#include <cstdint>
+
+#include <rex/net/socket.h>
+
+int main() {
+  const int socket_fd = socket(AF_INET, SOCK_DGRAM, 0);
+  if (socket_fd < 0) {
+    return 1;
+  }
+
+  // Guest memory is big-endian. Either endian interpretation is nonzero,
+  // which is the contract required by FIONBIO.
+  uint8_t enabled[4] = {0, 0, 0, 1};
+  const int ioctl_result =
+      rex::net::socket_ioctl(socket_fd, 0x8004667E, enabled);
+  const int flags = fcntl(socket_fd, F_GETFL, 0);
+  rex::net::socket_close(socket_fd);
+
+  return ioctl_result == 0 && flags >= 0 && (flags & O_NONBLOCK) ? 0 : 1;
+}
diff --git a/thirdparty/rexglue-sdk/src/core/socket_posix.cpp b/thirdparty/rexglue-sdk/src/core/socket_posix.cpp
index b4b885a3..8f4ed190 100644
--- a/thirdparty/rexglue-sdk/src/core/socket_posix.cpp
+++ b/thirdparty/rexglue-sdk/src/core/socket_posix.cpp
@@ -13,6 +13,22 @@ int socket_close(SocketHandle handle) {
 }

 int socket_ioctl(SocketHandle handle, uint32_t cmd, uint8_t* arg) {
+  // Xbox 360 socket ioctls use the Winsock command encoding. Translate the
+  // commands whose POSIX numeric values differ instead of passing guest
+  // constants directly to the host kernel.
+  switch (cmd) {
+    case 0x8004667E:  // Winsock FIONBIO
+      cmd = FIONBIO;
+      break;
+    case 0x4004667F:  // Winsock FIONREAD
+      cmd = FIONREAD;
+      break;
+    case 0x40047307:  // Winsock SIOCATMARK
+      cmd = SIOCATMARK;
+      break;
+    default:
+      break;
+  }
   return ioctl(static_cast<int>(handle), cmd, arg);
 }

diff --git a/thirdparty/rexglue-sdk/src/core/threading_posix.cpp b/thirdparty/rexglue-sdk/src/core/threading_posix.cpp
index e10e30b4..21c9bc61 100644
