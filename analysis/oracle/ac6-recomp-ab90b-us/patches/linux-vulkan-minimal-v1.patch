diff --git a/src/ac6_oracle_linux_main.cpp b/src/ac6_oracle_linux_main.cpp
new file mode 100644
index 00000000..309f2a71
--- /dev/null
+++ b/src/ac6_oracle_linux_main.cpp
@@ -0,0 +1,134 @@
+#include "generated/ac6recomp_config.h"
+#include "generated/ac6recomp_init.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string_view>
+
+#include <rex/ac6_controller_input_replay.h>
+#include <rex/cvar.h>
+#include <rex/graphics/vulkan/graphics_system.h>
+#include <rex/logging.h>
+#include <rex/rex_app.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/user_module.h>
+
+#if !defined(__linux__) || !REX_HAS_VULKAN || REX_HAS_D3D12
+#error "AC6_ORACLE_LINUX_MINIMAL is Linux/Vulkan-only"
+#endif
+
+REXCVAR_DEFINE_BOOL(ac6_unlock_fps, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_kbm_enabled, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_texture_swaps_enabled, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_fix_scaling, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_fix_deswizzle, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_fix_dof, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+REXCVAR_DEFINE_BOOL(ac6_fix_water_line, false, "AC6/Oracle",
+                    "Forbidden in the stock behavioural oracle");
+
+namespace {
+
+std::atomic<uint64_t> g_present_index{0};
+
+[[noreturn]] void RefuseEnhancements() {
+  std::fputs("AC6_ORACLE_LINUX_MINIMAL refuses FPS, KBM, texture swaps and AC6 fixes\n",
+             stderr);
+  std::fflush(stderr);
+  std::exit(EXIT_FAILURE);
+}
+
+class Ac6OracleLinuxApp final : public rex::ReXApp {
+ public:
+  Ac6OracleLinuxApp(rex::ui::WindowedAppContext& context,
+                    std::string_view name, rex::PPCImageInfo image)
+      : rex::ReXApp(context, name, image) {}
+
+  static std::unique_ptr<rex::ui::WindowedApp> Create(
+      rex::ui::WindowedAppContext& context) {
+    return std::make_unique<Ac6OracleLinuxApp>(context, "ac6recomp", PPCImageConfig);
+  }
+
+ protected:
+  uint32_t OnGetExpectedTitleId() const override { return 0x4E4D07D1; }
+
+  void OnConfigLoaded() override {
+    if (REXCVAR_GET(ac6_unlock_fps) || REXCVAR_GET(ac6_kbm_enabled) ||
+        REXCVAR_GET(ac6_texture_swaps_enabled) || REXCVAR_GET(ac6_fix_scaling) ||
+        REXCVAR_GET(ac6_fix_deswizzle) || REXCVAR_GET(ac6_fix_dof) ||
+        REXCVAR_GET(ac6_fix_water_line)) {
+      RefuseEnhancements();
+    }
+    rex::cvar::SetSessionDefault("vsync", "true", "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("guest_vblank_sync_to_refresh", "true",
+                                 "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("resolution_scale", "1", "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("draw_resolution_scale_x", "1",
+                                 "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("draw_resolution_scale_y", "1",
+                                 "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("video_mode_width", "1280", "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("video_mode_height", "720", "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("resolution", "720p", "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("show_build_stamp", "false", "AC6_ORACLE_LINUX_MINIMAL");
+    // A skipped placeholder frame is not an observable retail PRESENT. Compile
+    // synchronously so the bounded oracle run never substitutes or suppresses
+    // a frame while Vulkan pipelines warm up.
+    rex::cvar::SetSessionDefault("async_shader_compilation", "false",
+                                 "AC6_ORACLE_LINUX_MINIMAL");
+    rex::cvar::SetSessionDefault("vulkan_pipeline_creation_threads", "0",
+                                 "AC6_ORACLE_LINUX_MINIMAL");
+  }
+
+  void OnPreSetup(rex::RuntimeConfig& config) override {
+    rex::ReXApp::OnPreSetup(config);
+    config.graphics = REX_GRAPHICS_BACKEND(rex::graphics::vulkan::VulkanGraphicsSystem);
+  }
+
+  void OnPostSetup() override {
+    auto* graphics = runtime()->graphics_system();
+    if (!graphics) {
+      REX_FATAL("AC6 minimal oracle has no Vulkan graphics system");
+    }
+    graphics->SetFrameBoundaryCallback([](rex::memory::Memory*) {
+      const auto index =
+          g_present_index.fetch_add(1, std::memory_order_relaxed) + 1;
+      if (index <= 10) {
+        REXLOG_INFO("AC6_ORACLE_PRESENT index={}", index);
+      }
+    });
+    auto module = runtime()->kernel_state()->GetExecutableModule();
+    if (!module || !ac6::oracle::InitializeControllerInputReplay(
+                       module->title_id(), module->entry_point())) {
+      REX_FATAL("AC6 minimal oracle rejected XEX or controller replay lineage");
+    }
+    REXLOG_INFO("AC6_ORACLE_LINUX_MINIMAL stock Vulkan profile active");
+  }
+
+  void OnPostGuestShutdown() override {
+    REXLOG_INFO("AC6_ORACLE_SHUTDOWN presents={}",
+                g_present_index.load(std::memory_order_relaxed));
+    if (!ac6::oracle::FinalizeControllerInputReplay()) {
+      REX_FATAL("AC6 minimal oracle controller replay finalization failed");
+    }
+  }
+};
+
+}  // namespace
+
+namespace ac6::oracle {
+
+uint64_t LinuxMinimalPresentIndex() {
+  return g_present_index.load(std::memory_order_relaxed);
+}
+
+}  // namespace ac6::oracle
+
+REX_DEFINE_APP(ac6recomp, Ac6OracleLinuxApp::Create)
