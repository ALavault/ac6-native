@@ -233,7 +233,7 @@ class PosixConditionBase {
   virtual ~PosixConditionBase() = default;
   virtual bool Signal() = 0;

-  WaitResult Wait(std::chrono::milliseconds timeout) {
+  virtual WaitResult Wait(std::chrono::milliseconds timeout) {
     bool executed;
     auto predicate = [this] { return this->signaled(); };
 #if REX_PLATFORM_LINUX
@@ -394,17 +394,77 @@ class PosixCondition<Event> : public PosixConditionBase {

   bool Signal() override {
     auto lock = std::unique_lock<std::mutex>(mutex_);
-    signal_ = true;
-    cond_.notify_all();
+    if (!manual_reset_ && !waiters_.empty()) {
+      // An auto-reset event releases a thread that was already waiting. Do
+      // not leave a stealable boolean signal for a later waiter (notably the
+      // thread performing SignalAndWait itself).
+      Waiter* waiter = waiters_.front();
+      waiters_.pop_front();
+      waiter->granted = true;
+      cond_.notify_all();
+    } else {
+      signal_ = true;
+      if (manual_reset_) {
+        cond_.notify_all();
+      } else {
+        cond_.notify_one();
+      }
+    }
     return true;
   }

+  WaitResult Wait(std::chrono::milliseconds timeout) override {
+    if (manual_reset_) {
+      return PosixConditionBase::Wait(timeout);
+    }
+
+#if REX_PLATFORM_LINUX
+    auto native_mutex = static_cast<pthread_mutex_t*>(mutex_.native_handle());
+    int lock_result = pthread_mutex_lock(native_mutex);
+    if (lock_result == EOWNERDEAD) {
+      pthread_mutex_consistent(native_mutex);
+    } else if (lock_result != 0) {
+      return WaitResult::kFailed;
+    }
+    std::unique_lock<std::mutex> lock(mutex_, std::adopt_lock);
+#else
+    std::unique_lock<std::mutex> lock(mutex_);
+#endif
+    if (signal_) {
+      signal_ = false;
+      return WaitResult::kSuccess;
+    }
+
+    Waiter waiter;
+    waiters_.push_back(&waiter);
+    bool executed;
+    if (timeout == std::chrono::milliseconds::max()) {
+      cond_.wait(lock, [&waiter] { return waiter.granted; });
+      executed = true;
+    } else {
+      executed = cond_.wait_for(lock, timeout,
+                                [&waiter] { return waiter.granted; });
+    }
+    if (!executed) {
+      auto position = std::find(waiters_.begin(), waiters_.end(), &waiter);
+      if (position != waiters_.end()) {
+        waiters_.erase(position);
+      }
+      return WaitResult::kTimeout;
+    }
+    return WaitResult::kSuccess;
+  }
+
   void Reset() {
     auto lock = std::unique_lock<std::mutex>(mutex_);
     signal_ = false;
   }

  private:
+  struct Waiter {
+    bool granted = false;
+  };
+
   inline bool signaled() const override { return signal_; }
   inline void post_execution() override {
     if (!manual_reset_) {
@@ -413,6 +473,7 @@ class PosixCondition<Event> : public PosixConditionBase {
   }
   bool signal_;
   const bool manual_reset_;
+  std::deque<Waiter*> waiters_;
 };

