+bool EnsureUnitBoundaryOutput(const std::string& path) {
+  if (g_unit_boundary_output.is_open() && path == g_unit_boundary_output_path) {
+    return true;
+  }
+  if (g_unit_boundary_output.is_open()) {
+    g_unit_boundary_output.close();
+  }
+  g_unit_boundary_output.open(path, std::ios::out | std::ios::trunc);
+  g_unit_boundary_output_path = path;
+  g_unit_boundary_sequence = 0;
+  g_unit_boundary_output_bytes = 0;
+  g_unit_boundary_failed = !g_unit_boundary_output.is_open();
+  if (g_unit_boundary_failed) {
+    REXLOG_ERROR("AC6 oracle unit boundary could not open its bounded output");
+    return false;
+  }
+  REXLOG_INFO("AC6 oracle CX360UnitManager insertion boundary enabled");
+  return true;
+}
+
+void EmitUnitBoundary(uint8_t* base, uint32_t manager, uint32_t unit,
+                      uint32_t count_before, uint32_t count_after,
+                      uint32_t return_value) {
+  const std::string path = REXCVAR_GET(ac6_oracle_unit_boundary_path);
+  if (path.empty()) return;
+  std::lock_guard<std::mutex> lock(g_unit_boundary_mutex);
+  if (g_unit_boundary_failed || g_unit_boundary_sequence >= kUnitBoundaryMaxEvents ||
+      !EnsureUnitBoundaryOutput(path)) {
+    return;
+  }
+  const uint32_t trace_tick =
+      g_trace_v2_tick_atomic.load(std::memory_order_relaxed);
+  const uint32_t record_index = GuestField(base, unit, 0xD0u);
+  const uint32_t flags = GuestField(base, unit, 0xD4u);
+  const uint32_t object_count = GuestField(base, unit, 0xDCu);
+  const uint32_t inserted_index = count_after == 0 ? 0 : count_after - 1u;
+  std::ostringstream event;
+  event << "{\"sequence\":" << g_unit_boundary_sequence
+        << ",\"trace_tick\":" << trace_tick
+        << ",\"guest_address\":\"0x8226FEC0\""
+        << ",\"manager\":" << manager
+        << ",\"unit\":" << unit
+        << ",\"count_before\":" << count_before
+        << ",\"count_after\":" << count_after
+        << ",\"inserted_index\":" << inserted_index
+        << ",\"record_index\":" << record_index
+        << ",\"flags\":" << flags
+        << ",\"object_count\":" << object_count
+        << ",\"return_value\":" << return_value << "}\n";
+  const std::string line = event.str();
+  if (g_unit_boundary_output_bytes + line.size() > kUnitBoundaryMaxOutputBytes) {
+    g_unit_boundary_failed = true;
+    return;
+  }
+  g_unit_boundary_output << line;
+  if (!g_unit_boundary_output.good()) {
+    g_unit_boundary_failed = true;
+    return;
+  }
+  g_unit_boundary_output_bytes += line.size();
+  ++g_unit_boundary_sequence;
+  g_unit_boundary_output.flush();
+}
