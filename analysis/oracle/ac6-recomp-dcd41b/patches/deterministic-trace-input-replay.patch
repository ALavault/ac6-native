diff --git a/src/ac6_trace_input_policy.h b/src/ac6_trace_input_policy.h
new file mode 100644
index 00000000..8b4fc6ce
--- /dev/null
+++ b/src/ac6_trace_input_policy.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace ac6::oracle {
+
+enum class ReplayTickDecision {
+  kWaitingForFirstInput,
+  kReady,
+  kMissingInput,
+};
+
+// Access is serialized by the replay-input mutex in the capture host.
+class ReplayTickPolicy {
+ public:
+  void Reset() {
+    observed_tick_ = kNoTick;
+    calls_ = 0;
+  }
+
+  void ObserveInput(uint64_t tick) {
+    if (observed_tick_ != tick) {
+      observed_tick_ = tick;
+      calls_ = 0;
+    }
+    ++calls_;
+  }
+
+  [[nodiscard]] ReplayTickDecision ManagerTick(uint64_t tick,
+                                                bool trace_started) const {
+    if (!trace_started && tick == 0 && observed_tick_ == kNoTick) {
+      return ReplayTickDecision::kWaitingForFirstInput;
+    }
+    if (observed_tick_ == tick && calls_ != 0) {
+      return ReplayTickDecision::kReady;
+    }
+    return ReplayTickDecision::kMissingInput;
+  }
+
+  [[nodiscard]] uint64_t calls() const { return calls_; }
+
+ private:
+  static constexpr uint64_t kNoTick = std::numeric_limits<uint64_t>::max();
+  uint64_t observed_tick_{kNoTick};
+  uint64_t calls_{0};
+};
+
+}  // namespace ac6::oracle
diff --git a/tests/ac6_trace_input_policy_test.cpp b/tests/ac6_trace_input_policy_test.cpp
new file mode 100644
index 00000000..84879ee9
--- /dev/null
+++ b/tests/ac6_trace_input_policy_test.cpp
@@ -0,0 +1,30 @@
+#include "ac6_trace_input_policy.h"
+
+#include <cassert>
+
+int main() {
+  using ac6::oracle::ReplayTickDecision;
+  using ac6::oracle::ReplayTickPolicy;
+
+  ReplayTickPolicy policy;
+  assert(policy.ManagerTick(0, false) ==
+         ReplayTickDecision::kWaitingForFirstInput);
+
+  policy.ObserveInput(0);
+  assert(policy.calls() == 1);
+  assert(policy.ManagerTick(0, false) == ReplayTickDecision::kReady);
+
+  policy.ObserveInput(0);
+  assert(policy.calls() == 2);
+  assert(policy.ManagerTick(0, true) == ReplayTickDecision::kReady);
+
+  assert(policy.ManagerTick(1, true) == ReplayTickDecision::kMissingInput);
+  policy.ObserveInput(1);
+  assert(policy.calls() == 1);
+  assert(policy.ManagerTick(1, true) == ReplayTickDecision::kReady);
+
+  policy.Reset();
+  assert(policy.ManagerTick(0, false) ==
+         ReplayTickDecision::kWaitingForFirstInput);
+  return 0;
+}
