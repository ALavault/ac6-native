@@ -0,0 +1,234 @@
+#include <rex/ac6_xam_input_movie.h>
+
+#include <atomic>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+#include <native/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/thread_state.h>
+
+#include "ac6_xam_input_movie.h"
+
+REXCVAR_DEFINE_STRING(ac6_xam_movie_header_path, "", "AC6/Oracle",
+                      "Canonical ac6.xam-input-movie.v1 header JSONL");
+REXCVAR_DEFINE_STRING(ac6_xam_movie_record_path, "", "AC6/Oracle",
+                      "Exclusive XAM input movie output");
+REXCVAR_DEFINE_STRING(ac6_xam_movie_replay_path, "", "AC6/Oracle",
+                      "Strict XAM input movie replay input");
+
+namespace ac6::oracle {
+namespace {
+
+using xam_movie::Mode;
+using xam_movie::Observation;
+using xam_movie::ReplayValue;
+using xam_movie::Service;
+
+constexpr std::size_t kMaxHeaderBytes = 1024u * 1024u;
+std::mutex g_mutex;
+Service g_service;
+std::filesystem::path g_record_path;
+bool g_initialized = false;
+std::atomic<uint64_t> g_temp_sequence{0};
+
+bool ReadBounded(const std::filesystem::path& path, std::size_t maximum,
+                 std::string& output, std::string& error) {
+  std::error_code status_error;
+  const uintmax_t size = std::filesystem::file_size(path, status_error);
+  if (status_error || size == 0 || size > maximum ||
+      !std::filesystem::is_regular_file(path)) {
+    error = "input absent, non-regular, empty, or outside byte bound";
+    return false;
+  }
+  std::ifstream input(path, std::ios::binary);
+  output.assign(std::istreambuf_iterator<char>(input),
+                std::istreambuf_iterator<char>());
+  input.peek();
+  if (!input.eof() || output.size() != size) {
+    output.clear();
+    error = "input changed or failed while reading";
+    return false;
+  }
+  return true;
+}
+
+bool PublishNew(const std::filesystem::path& destination,
+                std::string_view payload, std::string& error) {
+  const std::filesystem::path parent = destination.parent_path().empty()
+                                           ? std::filesystem::current_path()
+                                           : destination.parent_path();
+  if (destination.filename().empty() || !std::filesystem::is_directory(parent) ||
+      std::filesystem::exists(destination)) {
+    error = "movie output identity or parent";
+    return false;
+  }
+  const auto temporary = parent / ("." + destination.filename().string() +
+      ".tmp-" + std::to_string(g_temp_sequence.fetch_add(1)));
+  {
+    std::ofstream output(temporary, std::ios::binary | std::ios::out |
+                                       std::ios::noreplace);
+    if (!output) {
+      error = "exclusive temporary movie creation";
+      return false;
+    }
+    output.write(payload.data(), static_cast<std::streamsize>(payload.size()));
+    output.flush();
+    if (!output) {
+      std::error_code ignored;
+      std::filesystem::remove(temporary, ignored);
+      error = "temporary movie write";
+      return false;
+    }
+  }
+  std::error_code link_error;
+  std::filesystem::create_hard_link(temporary, destination, link_error);
+  std::error_code remove_error;
+  std::filesystem::remove(temporary, remove_error);
+  if (link_error || remove_error) {
+    if (!link_error) {
+      std::error_code ignored;
+      std::filesystem::remove(destination, ignored);
+    }
+    error = "atomic movie publication";
+    return false;
+  }
+  return true;
+}
+
+struct Telemetry {
+  uint64_t tick;
+  uint32_t thread;
+  uint32_t lr;
+};
+
+Telemetry CurrentTelemetry() {
+  rex::runtime::ThreadState* thread = rex::runtime::ThreadState::Get();
+  if (!thread || !thread->context()) {
+    REX_FATAL("AC6 XAM movie called without a guest thread");
+  }
+  return {rex::chrono::Clock::PeekGuestTickCount(), thread->thread_id(),
+          static_cast<uint32_t>(thread->context()->lr)};
+}
+
+[[noreturn]] void Fatal(std::string_view operation, const std::string& detail) {
+  REX_FATAL("AC6 XAM input movie {} failed: {}", operation, detail);
+}
+
+}  // namespace
+
+bool InitializeXamInputMovie() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_initialized) return false;
+  g_initialized = true;
+  const std::filesystem::path header = REXCVAR_GET(ac6_xam_movie_header_path);
+  const std::filesystem::path record = REXCVAR_GET(ac6_xam_movie_record_path);
+  const std::filesystem::path replay = REXCVAR_GET(ac6_xam_movie_replay_path);
+  if (record.empty() && replay.empty()) return header.empty();
+  if (header.empty() || (!record.empty() && !replay.empty()) ||
+      !rex::cvar::GetFlagByName("ac6_oracle_controller_record_path").empty() ||
+      !rex::cvar::GetFlagByName("ac6_oracle_controller_replay_path").empty() ||
+      !rex::cvar::GetFlagByName("ac6_oracle_trace_v2_input_path").empty()) {
+    REXLOG_ERROR("AC6 XAM movie requires one exclusive input mode");
+    return false;
+  }
+  std::string header_bytes;
+  std::string error;
+  if (!ReadBounded(header, kMaxHeaderBytes, header_bytes, error)) {
+    REXLOG_ERROR("AC6 XAM movie header: {}", error);
+    return false;
+  }
+  if (!record.empty()) {
+    if (record == header || std::filesystem::exists(record) ||
+        !g_service.BeginRecord(header_bytes, error)) {
+      REXLOG_ERROR("AC6 XAM movie record initialization: {}", error);
+      return false;
+    }
+    g_record_path = record;
+    REXLOG_INFO("AC6 XAM input movie record armed FROM_XEX_LAUNCH");
+    return true;
+  }
+  std::string movie;
+  if (replay == header ||
+      !ReadBounded(replay, xam_movie::kMaxMovieBytes, movie, error) ||
+      !g_service.BeginReplay(movie, header_bytes, error)) {
+    REXLOG_ERROR("AC6 XAM movie replay initialization: {}", error);
+    return false;
+  }
+  REXLOG_INFO("AC6 XAM input movie strict replay armed FROM_XEX_LAUNCH; host HID bypassed");
+  return true;
+}
+
+bool FinalizeXamInputMovie() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (!g_initialized) return true;
+  const Mode mode = g_service.mode();
+  const uint64_t count = g_service.ordinal();
+  std::string sealed;
+  std::string error;
+  if (!g_service.Finalize(sealed, error) ||
+      (mode == Mode::kRecord && !PublishNew(g_record_path, sealed, error))) {
+    REXLOG_ERROR("AC6 XAM movie finalization: {}", error);
+    return false;
+  }
+  if (mode != Mode::kDisabled) {
+    REXLOG_INFO("AC6 XAM input movie finalized events={}", count);
+  }
+  g_record_path.clear();
+  g_initialized = false;
+  return true;
+}
+
+XamInputMovieAction BeginXamInputMoviePoll(
+    uint32_t user, uint32_t flags, uint32_t state_ptr, uint32_t& result,
+    XamInputMovieState& state, bool& has_state, XamInputMovieRecord& record) {
+  record = {};
+  g_mutex.lock();
+  const Mode mode = g_service.mode();
+  if (mode == Mode::kDisabled) {
+    g_mutex.unlock();
+    return XamInputMovieAction::kPhysical;
+  }
+  const Telemetry telemetry = CurrentTelemetry();
+  if (mode == Mode::kReplay) {
+    ReplayValue replay;
+    std::string error;
+    const bool accepted = g_service.Replay(
+        {telemetry.lr, user, flags, state_ptr == 0}, replay, error);
+    if (accepted) {
+      result = replay.result;
+      has_state = replay.has_state;
+      state.bytes = replay.state;
+      if (g_service.replay_consumed()) {
+        REXLOG_INFO("AC6 XAM input movie strict replay consumed all events");
+      }
+    }
+    g_mutex.unlock();
+    if (!accepted) Fatal("poll", error);
+    return XamInputMovieAction::kReplay;
+  }
+  record = {telemetry.tick, telemetry.thread, telemetry.lr, user, flags,
+            state_ptr == 0, true};
+  return XamInputMovieAction::kPhysical;
+}
+
+void CompleteXamInputMoviePoll(XamInputMovieRecord& record, uint32_t result,
+                               const XamInputMovieState* state) {
+  if (!record.active) return;
+  Observation observation{
+      g_service.ordinal(), record.guest_tick, record.guest_thread,
+      record.caller_lr, record.user, record.flags, record.state_ptr_null,
+      result, state != nullptr, state ? state->bytes : xam_movie::StateBytes{}};
+  std::string error;
+  const bool accepted = g_service.Record(observation, error);
+  record.active = false;
+  g_mutex.unlock();
+  if (!accepted) Fatal("record poll", error);
+}
+
+}  // namespace ac6::oracle
