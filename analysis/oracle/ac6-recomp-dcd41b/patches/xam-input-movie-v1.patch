+#include "ac6_xam_input_movie.h"
+
+#include <cassert>
+#include <cstddef>
+#include <string>
+
+namespace {
+
+std::string Header() {
+  return R"json({"configuration":{"behavior_sha256":"7777777777777777777777777777777777777777777777777777777777777777","runtime_sha256":"6666666666666666666666666666666666666666666666666666666666666666"},"content":{"manifest_sha256":"5555555555555555555555555555555555555555555555555555555555555555"},"initial_state":"FROM_XEX_LAUNCH","interventions":["mission01-step-recipe"],"kind":"header","lane":"bridge","profile":{"id":"isolated-english-new-game","tree_sha256":"4444444444444444444444444444444444444444444444444444444444444444"},"roots":{"cache":{"isolated":true,"label":"cache","tree_sha256":"3333333333333333333333333333333333333333333333333333333333333333"},"content":{"isolated":true,"label":"content","tree_sha256":"2222222222222222222222222222222222222222222222222222222222222222"},"storage":{"isolated":true,"label":"storage","tree_sha256":"1111111111111111111111111111111111111111111111111111111111111111"}},"route":{"recipe":"scripts/ac6-oracle-mission01-controlled-sortie-delayed.steps","sha256":"9999999999999999999999999999999999999999999999999999999999999999"},"runtime":{"binary_sha256":"8888888888888888888888888888888888888888888888888888888888888888","commit":"dcd41b7457fcac8242f8ef40de83d1719390d5af","diff_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},"schema":"ac6.xam-input-movie.v1","target":{"base_address":"82000000","data_tbl_sha256":"82700410d305dc2d24e24d378ce5b9b63f240ac208842d7620b608fac15d50f5","module":"default.xex","target_id":"ac6-pal-default-xex","xex_sha256":"acc302c1599c7a2fd38bd5a7de395b418a157d7001b6f986ab7113f45711bcde"}})json"
+         "\n";
+}
+
+ac6::oracle::xam_movie::StateBytes State() {
+  ac6::oracle::xam_movie::StateBytes state{};
+  for (std::size_t index = 0; index < state.size(); ++index) {
+    state[index] = std::byte(index);
+  }
+  return state;
+}
+
+}  // namespace
+
+int main() {
+  using namespace ac6::oracle::xam_movie;
+  Service record;
+  std::string error;
+  assert(record.BeginRecord(Header(), error));
+  assert(record.Record({0, 100, 2, 0x823911C0, 0, 1, false, 0, true,
+                        State()}, error));
+  assert(record.Record({1, 101, 2, 0x823911C0, 1, 0, true, 1167, false, {}},
+                       error));
+  std::string movie;
+  assert(record.Finalize(movie, error));
+  assert(movie.find("000102030405060708090a0b0c0d0e0f") != std::string::npos);
+  assert(movie.find("present") == std::string::npos);
+  assert(movie.find("XamInputGetState") != std::string::npos);
+
+  Service replay;
+  assert(replay.BeginReplay(movie, Header(), error));
+  ReplayValue value;
+  assert(replay.Replay({0x823911C0, 0, 1, false}, value, error));
+  assert(value.result == 0 && value.has_state && value.state == State());
+  assert(replay.Replay({0x823911C0, 1, 0, true}, value, error));
+  assert(value.result == 1167 && !value.has_state);
+  std::string none;
+  assert(replay.Finalize(none, error));
+
+  for (const auto mismatch : {Guards{0x823911C4, 0, 1, false},
+                              Guards{0x823911C0, 1, 1, false},
+                              Guards{0x823911C0, 0, 2, false}}) {
+    Service strict;
+    assert(strict.BeginReplay(movie, Header(), error));
+    assert(!strict.Replay(mismatch, value, error));
+  }
+
+  Service short_replay;
+  assert(short_replay.BeginReplay(movie, Header(), error));
+  assert(short_replay.Replay({0x823911C0, 0, 1, false}, value, error));
+  assert(!short_replay.Finalize(none, error));
+  assert(error.find("trace-length mismatch") != std::string::npos);
+
+  Service extra_replay;
+  assert(extra_replay.BeginReplay(movie, Header(), error));
+  assert(extra_replay.Replay({0x823911C0, 0, 1, false}, value, error));
+  assert(extra_replay.Replay({0x823911C0, 1, 0, true}, value, error));
+  assert(!extra_replay.Replay({0x823911C0, 0, 1, false}, value, error));
+  assert(error.find("trace-length mismatch") != std::string::npos);
+  return 0;
+}
