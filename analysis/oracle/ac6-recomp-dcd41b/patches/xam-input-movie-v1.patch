@@ -0,0 +1,77 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ac6::oracle::xam_movie {
+
+constexpr std::size_t kStateBytes = 16;
+constexpr std::size_t kMaxMovieBytes = 128u * 1024u * 1024u;
+constexpr std::size_t kMaxEvents = 1'000'000u;
+
+using StateBytes = std::array<std::byte, kStateBytes>;
+
+struct Observation {
+  uint64_t ordinal{0};
+  uint64_t guest_tick{0};
+  uint32_t guest_thread{0};
+  uint32_t caller_lr{0};
+  uint32_t user{0};
+  uint32_t flags{0};
+  bool state_ptr_null{true};
+  uint32_t result{0};
+  bool has_state{false};
+  StateBytes state{};
+};
+
+struct Guards {
+  uint32_t caller_lr{0};
+  uint32_t user{0};
+  uint32_t flags{0};
+  bool state_ptr_null{true};
+};
+
+struct ReplayValue {
+  uint32_t result{0};
+  bool has_state{false};
+  StateBytes state{};
+};
+
+enum class Mode { kDisabled, kRecord, kReplay };
+
+class Service {
+ public:
+  bool BeginRecord(std::string_view header, std::string& error);
+  bool BeginReplay(std::string_view movie, std::string_view expected_header,
+                   std::string& error);
+  bool Record(const Observation& observation, std::string& error);
+  bool Replay(const Guards& guards, ReplayValue& output, std::string& error);
+  bool Finalize(std::string& sealed_movie, std::string& error);
+
+  [[nodiscard]] Mode mode() const { return mode_; }
+  [[nodiscard]] uint64_t ordinal() const { return ordinal_; }
+  [[nodiscard]] bool replay_consumed() const {
+    return mode_ == Mode::kReplay && replay_cursor_ == replay_events_.size();
+  }
+
+ private:
+  bool Fail(std::string message, std::string& error);
+  void Reset();
+
+  Mode mode_{Mode::kDisabled};
+  bool failed_{false};
+  std::string failure_;
+  std::string header_;
+  std::string body_;
+  std::string normalized_;
+  std::string expected_normalized_sha256_;
+  std::vector<std::string> replay_events_;
+  std::size_t replay_cursor_{0};
+  uint64_t ordinal_{0};
+};
+
+}  // namespace ac6::oracle::xam_movie
diff --git a/src/ac6_xam_input_movie_runtime.cpp b/src/ac6_xam_input_movie_runtime.cpp
