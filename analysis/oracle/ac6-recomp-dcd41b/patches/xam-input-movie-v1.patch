diff --git a/src/ac6_xam_input_movie.cpp b/src/ac6_xam_input_movie.cpp
new file mode 100644
index 0000000..c57fd61
--- /dev/null
+++ b/src/ac6_xam_input_movie.cpp
@@ -0,0 +1,421 @@
+#include "ac6_xam_input_movie.h"
+
+#include <algorithm>
+#include <regex>
+#include <sstream>
+#include <utility>
+
+#include <rex/crypto/sha256.h>
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-literal-operator"
+#endif
+#include "../thirdparty/rexglue-sdk/thirdparty/tomlplusplus/vendor/json.hpp"
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
+
+namespace ac6::oracle::xam_movie {
+namespace {
+
+using Json = nlohmann::json;
+constexpr std::string_view kSchema = "ac6.xam-input-movie.v1";
+constexpr std::string_view kRuntimeCommit =
+    "dcd41b7457fcac8242f8ef40de83d1719390d5af";
+constexpr std::string_view kXexSha =
+    "acc302c1599c7a2fd38bd5a7de395b418a157d7001b6f986ab7113f45711bcde";
+constexpr std::string_view kDataTblSha =
+    "82700410d305dc2d24e24d378ce5b9b63f240ac208842d7620b608fac15d50f5";
+constexpr std::size_t kMaxLineBytes = 1024u * 1024u;
+const std::regex kSha256{"[0-9a-f]{64}"};
+
+bool SetError(std::string value, std::string& error) {
+  error = std::move(value);
+  return false;
+}
+
+bool ExactKeys(const Json& value,
+               std::initializer_list<std::string_view> expected) {
+  if (!value.is_object() || value.size() != expected.size()) return false;
+  return std::ranges::all_of(expected, [&](std::string_view key) {
+    return value.contains(std::string(key));
+  });
+}
+
+bool Sha(const Json& value) {
+  return value.is_string() &&
+         std::regex_match(value.get_ref<const std::string&>(), kSha256);
+}
+
+bool Uint(const Json& value, uint64_t maximum, uint64_t& output) {
+  if (value.is_number_unsigned()) {
+    output = value.get<uint64_t>();
+  } else if (value.is_number_integer()) {
+    const int64_t signed_value = value.get<int64_t>();
+    if (signed_value < 0) return false;
+    output = static_cast<uint64_t>(signed_value);
+  } else {
+    return false;
+  }
+  return output <= maximum;
+}
+
+std::string Canonical(const Json& value) {
+  return value.dump(-1, ' ', true, Json::error_handler_t::strict) + '\n';
+}
+
+bool ParseCanonical(std::string_view line, Json& output, std::string& error,
+                    std::string_view where) {
+  if (line.empty() || line.size() > kMaxLineBytes || line.back() != '\n' ||
+      line.find('\r') != std::string_view::npos) {
+    return SetError(std::string(where) + " framing", error);
+  }
+  output = Json::parse(line.begin(), line.end() - 1, nullptr, false);
+  if (output.is_discarded() || !output.is_object() || Canonical(output) != line) {
+    return SetError(std::string(where) + " canonical JSON", error);
+  }
+  return true;
+}
+
+bool ValidateRoot(const Json& root, std::string_view label) {
+  return ExactKeys(root, {"label", "tree_sha256", "isolated"}) &&
+         root["label"] == label && Sha(root["tree_sha256"]) &&
+         root["isolated"] == true;
+}
+
+bool ValidateHeader(const Json& header, std::string& error) {
+  if (!ExactKeys(header, {"kind", "schema", "lane", "initial_state",
+                          "target", "content", "runtime", "configuration",
+                          "profile", "roots", "route", "interventions"}) ||
+      header["kind"] != "header" || header["schema"] != kSchema ||
+      header["lane"] != "bridge" ||
+      header["initial_state"] != "FROM_XEX_LAUNCH") {
+    return SetError("header identity or initial state", error);
+  }
+  const Json& target = header["target"];
+  if (!ExactKeys(target, {"target_id", "module", "xex_sha256",
+                           "data_tbl_sha256", "base_address"}) ||
+      target["target_id"] != "ac6-pal-default-xex" ||
+      target["module"] != "default.xex" || target["xex_sha256"] != kXexSha ||
+      target["data_tbl_sha256"] != kDataTblSha ||
+      target["base_address"] != "82000000") {
+    return SetError("target identity", error);
+  }
+  const Json& runtime = header["runtime"];
+  if (!ExactKeys(runtime, {"commit", "diff_sha256", "binary_sha256"}) ||
+      runtime["commit"] != kRuntimeCommit || !Sha(runtime["diff_sha256"]) ||
+      !Sha(runtime["binary_sha256"])) {
+    return SetError("runtime identity", error);
+  }
+  const Json& content = header["content"];
+  if (!ExactKeys(content, {"manifest_sha256"}) ||
+      !Sha(content["manifest_sha256"])) {
+    return SetError("content identity", error);
+  }
+  const Json& configuration = header["configuration"];
+  if (!ExactKeys(configuration,
+                 {"runtime_sha256", "behavior_sha256"}) ||
+      !Sha(configuration["runtime_sha256"]) ||
+      !Sha(configuration["behavior_sha256"])) {
+    return SetError("configuration identity", error);
+  }
+  const Json& profile = header["profile"];
+  if (!ExactKeys(profile, {"id", "tree_sha256"}) ||
+      !profile["id"].is_string() || profile["id"].get<std::string>().empty() ||
+      !Sha(profile["tree_sha256"])) {
+    return SetError("profile identity", error);
+  }
+  const Json& roots = header["roots"];
+  if (!ExactKeys(roots, {"storage", "content", "cache"}) ||
+      !ValidateRoot(roots["storage"], "storage") ||
+      !ValidateRoot(roots["content"], "content") ||
+      !ValidateRoot(roots["cache"], "cache")) {
+    return SetError("isolated roots identity", error);
+  }
+  const Json& route = header["route"];
+  if (!ExactKeys(route, {"recipe", "sha256"}) ||
+      route["recipe"] != "scripts/ac6-oracle-mission01-controlled-sortie-delayed.steps" ||
+      !Sha(route["sha256"]) || !header["interventions"].is_array()) {
+    return SetError("route or interventions identity", error);
+  }
+  return true;
+}
+
+std::string Hex(const StateBytes& state) {
+  static constexpr char digits[] = "0123456789abcdef";
+  std::string output(kStateBytes * 2u, '0');
+  for (std::size_t index = 0; index < state.size(); ++index) {
+    const uint8_t value = std::to_integer<uint8_t>(state[index]);
+    output[index * 2u] = digits[value >> 4u];
+    output[index * 2u + 1u] = digits[value & 15u];
+  }
+  return output;
+}
+
+bool State(const Json& value, StateBytes& state) {
+  if (!value.is_string()) return false;
+  const std::string& text = value.get_ref<const std::string&>();
+  if (text.size() != kStateBytes * 2u) return false;
+  auto nibble = [](char c) -> int {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    return -1;
+  };
+  for (std::size_t index = 0; index < state.size(); ++index) {
+    const int high = nibble(text[index * 2u]);
+    const int low = nibble(text[index * 2u + 1u]);
+    if (high < 0 || low < 0) return false;
+    state[index] = std::byte((high << 4) | low);
+  }
+  return true;
+}
+
+bool Split(std::string_view bytes, std::vector<std::string_view>& lines,
+           std::string& error) {
+  if (bytes.empty() || bytes.size() > kMaxMovieBytes || bytes.back() != '\n' ||
+      bytes.find('\r') != std::string_view::npos) {
+    return SetError("movie framing or byte bound", error);
+  }
+  for (std::size_t start = 0; start < bytes.size();) {
+    const std::size_t end = bytes.find('\n', start);
+    if (end == std::string_view::npos || end - start + 1u > kMaxLineBytes ||
+        lines.size() >= kMaxEvents + 2u) {
+      return SetError("movie line or event bound", error);
+    }
+    lines.push_back(bytes.substr(start, end - start + 1u));
+    start = end + 1u;
+  }
+  return lines.size() >= 2u;
+}
+
+bool ParseEvent(const Json& event, uint64_t expected, Observation& output,
+                std::string& error) {
+  if (!ExactKeys(event, {"kind", "ordinal", "guest_tick", "guest_thread",
+                          "caller_lr", "user", "flags", "state_ptr_null",
+                          "result", "state16"}) ||
+      event["kind"] != "XamInputGetState") {
+    return SetError("event type or shape mismatch", error);
+  }
+  uint64_t ordinal = 0, guest_tick = 0, guest_thread = 0, caller_lr = 0;
+  uint64_t user = 0, flags = 0, result = 0;
+  if (!Uint(event["ordinal"], kMaxEvents, ordinal) || ordinal != expected ||
+      !Uint(event["guest_tick"], UINT64_MAX, guest_tick) ||
+      !Uint(event["guest_thread"], UINT32_MAX, guest_thread) ||
+      !Uint(event["caller_lr"], UINT32_MAX, caller_lr) ||
+      !Uint(event["user"], UINT32_MAX, user) ||
+      !Uint(event["flags"], UINT32_MAX, flags) ||
+      !event["state_ptr_null"].is_boolean() ||
+      !Uint(event["result"], UINT32_MAX, result)) {
+    return SetError("event range or ordinal mismatch", error);
+  }
+  const bool pointer_null = event["state_ptr_null"].get<bool>();
+  const bool has_state = !event["state16"].is_null();
+  StateBytes state{};
+  if ((has_state && (!State(event["state16"], state) || pointer_null || result != 0)) ||
+      (!has_state && !event["state16"].is_null())) {
+    return SetError("event state/result/pointer mismatch", error);
+  }
+  output = {ordinal, guest_tick, static_cast<uint32_t>(guest_thread),
+            static_cast<uint32_t>(caller_lr), static_cast<uint32_t>(user),
+            static_cast<uint32_t>(flags), pointer_null,
+            static_cast<uint32_t>(result), has_state, state};
+  return true;
+}
+
+std::string Normalized(const Observation& observation) {
+  return Canonical(Json{{"kind", "XamInputGetState"},
+                        {"ordinal", observation.ordinal},
+                        {"caller_lr", observation.caller_lr},
+                        {"user", observation.user},
+                        {"flags", observation.flags},
+                        {"state_ptr_null", observation.state_ptr_null},
+                        {"result", observation.result},
+                        {"state16", observation.has_state
+                                        ? Json(Hex(observation.state))
+                                        : Json(nullptr)}});
+}
+
+}  // namespace
+
+void Service::Reset() {
+  mode_ = Mode::kDisabled;
+  failed_ = false;
+  failure_.clear();
+  header_.clear();
+  body_.clear();
+  normalized_.clear();
+  expected_normalized_sha256_.clear();
+  replay_events_.clear();
+  replay_cursor_ = 0;
+  ordinal_ = 0;
+}
+
+bool Service::Fail(std::string message, std::string& error) {
+  failed_ = true;
+  failure_ = std::move(message);
+  error = failure_;
+  return false;
+}
+
+bool Service::BeginRecord(std::string_view header, std::string& error) {
+  Reset();
+  Json parsed;
+  if (!ParseCanonical(header, parsed, error, "header") ||
+      !ValidateHeader(parsed, error)) {
+    return false;
+  }
+  header_.assign(header);
+  body_ = header_;
+  mode_ = Mode::kRecord;
+  return true;
+}
+
+bool Service::BeginReplay(std::string_view movie,
+                          std::string_view expected_header,
+                          std::string& error) {
+  Reset();
+  Json expected;
+  if (!ParseCanonical(expected_header, expected, error, "expected header") ||
+      !ValidateHeader(expected, error)) {
+    return false;
+  }
+  std::vector<std::string_view> lines;
+  if (!Split(movie, lines, error)) return false;
+  Json actual;
+  if (!ParseCanonical(lines.front(), actual, error, "movie header") ||
+      !ValidateHeader(actual, error) || actual != expected) {
+    return SetError("movie header mismatch", error);
+  }
+  Json footer;
+  if (!ParseCanonical(lines.back(), footer, error, "footer") ||
+      !ExactKeys(footer, {"kind", "event_count", "payload_sha256",
+                          "normalized_sha256"}) ||
+      footer["kind"] != "footer" || !Sha(footer["payload_sha256"])) {
+    return SetError("footer shape", error);
+  }
+  uint64_t count = 0;
+  if (!Uint(footer["event_count"], kMaxEvents, count) ||
+      count != lines.size() - 2u || count == 0) {
+    return SetError("trace-length mismatch", error);
+  }
+  std::string digest_input(movie.substr(0, movie.size() - lines.back().size()));
+  digest_input += Canonical(Json{{"kind", "footer"}, {"event_count", count}});
+  if (footer["payload_sha256"] != rex::crypto::sha256(digest_input)) {
+    return SetError("payload digest mismatch", error);
+  }
+  if (!Sha(footer["normalized_sha256"])) {
+    return SetError("normalized digest shape", error);
+  }
+  replay_events_.reserve(count);
+  for (std::size_t index = 1; index + 1 < lines.size(); ++index) {
+    Json event;
+    Observation ignored;
+    if (!ParseCanonical(lines[index], event, error, "event") ||
+        !ParseEvent(event, index - 1u, ignored, error)) {
+      return false;
+    }
+    normalized_ += Normalized(ignored);
+    replay_events_.emplace_back(lines[index]);
+  }
+  expected_normalized_sha256_ = footer["normalized_sha256"].get<std::string>();
+  if (rex::crypto::sha256(normalized_) != expected_normalized_sha256_) {
+    return SetError("normalized digest mismatch", error);
+  }
+  normalized_.clear();
+  header_.assign(expected_header);
+  mode_ = Mode::kReplay;
+  return true;
+}
+
+bool Service::Record(const Observation& observation, std::string& error) {
+  if (mode_ != Mode::kRecord || failed_) return Fail("record mode", error);
+  if (observation.ordinal != ordinal_ || ordinal_ >= kMaxEvents ||
+      (observation.has_state &&
+       (observation.state_ptr_null || observation.result != 0))) {
+    return Fail("record event invariant", error);
+  }
+  Json event{{"kind", "XamInputGetState"},
+             {"ordinal", ordinal_},
+             {"guest_tick", observation.guest_tick},
+             {"guest_thread", observation.guest_thread},
+             {"caller_lr", observation.caller_lr},
+             {"user", observation.user},
+             {"flags", observation.flags},
+             {"state_ptr_null", observation.state_ptr_null},
+             {"result", observation.result},
+             {"state16", observation.has_state ? Json(Hex(observation.state))
+                                                : Json(nullptr)}};
+  const std::string line = Canonical(event);
+  if (body_.size() + line.size() > kMaxMovieBytes) {
+    return Fail("movie byte bound", error);
+  }
+  body_ += line;
+  normalized_ += Normalized(observation);
+  ++ordinal_;
+  return true;
+}
+
+bool Service::Replay(const Guards& guards, ReplayValue& output,
+                     std::string& error) {
+  if (mode_ != Mode::kReplay || failed_) return Fail("replay mode", error);
+  if (replay_cursor_ >= replay_events_.size()) {
+    return Fail("trace-length mismatch: unexpected XamInputGetState", error);
+  }
+  Json event;
+  Observation observation;
+  if (!ParseCanonical(replay_events_[replay_cursor_], event, error, "event") ||
+      !ParseEvent(event, ordinal_, observation, error)) {
+    return Fail(error, error);
+  }
+  auto mismatch = [&](std::string_view field) {
+    return Fail("strict replay mismatch: " + std::string(field) +
+                    " at ordinal " + std::to_string(ordinal_),
+                error);
+  };
+  if (observation.caller_lr != guards.caller_lr) return mismatch("caller_lr");
+  if (observation.user != guards.user) return mismatch("user");
+  if (observation.flags != guards.flags) return mismatch("flags");
+  if (observation.state_ptr_null != guards.state_ptr_null) {
+    return mismatch("state_ptr_null");
+  }
+  output = {observation.result, observation.has_state, observation.state};
+  Observation actual = observation;
+  actual.caller_lr = guards.caller_lr;
+  actual.user = guards.user;
+  actual.flags = guards.flags;
+  actual.state_ptr_null = guards.state_ptr_null;
+  normalized_ += Normalized(actual);
+  ++replay_cursor_;
+  ++ordinal_;
+  return true;
+}
+
+bool Service::Finalize(std::string& sealed_movie, std::string& error) {
+  sealed_movie.clear();
+  if (failed_) return SetError(failure_, error);
+  if (mode_ == Mode::kDisabled) return true;
+  if (mode_ == Mode::kReplay) {
+    if (replay_cursor_ != replay_events_.size()) {
+      return Fail("trace-length mismatch: unconsumed events", error);
+    }
+    if (rex::crypto::sha256(normalized_) != expected_normalized_sha256_) {
+      return Fail("normalized XAM event stream mismatch", error);
+    }
+    Reset();
+    return true;
+  }
+  if (ordinal_ == 0) return Fail("empty movie", error);
+  Json footer_payload{{"kind", "footer"}, {"event_count", ordinal_}};
+  const std::string digest_input = body_ + Canonical(footer_payload);
+  footer_payload["payload_sha256"] = rex::crypto::sha256(digest_input);
+  footer_payload["normalized_sha256"] = rex::crypto::sha256(normalized_);
+  sealed_movie = body_ + Canonical(footer_payload);
+  if (sealed_movie.size() > kMaxMovieBytes) {
+    sealed_movie.clear();
+    return Fail("sealed movie byte bound", error);
+  }
+  Reset();
+  return true;
+}
+
+}  // namespace ac6::oracle::xam_movie
