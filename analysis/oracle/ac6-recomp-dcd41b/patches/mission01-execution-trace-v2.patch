+void EmitExecutionTick(uint8_t* base, uint32_t player) {
+  const std::string path = REXCVAR_GET(ac6_oracle_trace_v2_path);
+  const std::string arm = REXCVAR_GET(ac6_oracle_trace_v2_arm_path);
+  if (path.empty() || arm.empty() || !std::filesystem::is_regular_file(arm)) {
+    return;
+  }
+  const InputSnapshot input = SnapshotInput();
+  const ac6::d3d::FrameCaptureSummary graphics = ac6::d3d::GetFrameCaptureSummary();
+  const int32_t yaw = (input.buttons & 0x0100u) != 0
+                          ? -32768
+                          : ((input.buttons & 0x0200u) != 0 ? 32767
+                                                            : input.thumb_rx);
+  std::ostringstream controller;
+  controller << "{\"pitch\":" << input.thumb_ly
+             << ",\"roll\":" << input.thumb_lx << ",\"yaw\":" << yaw
+             << ",\"throttle\":" << static_cast<uint32_t>(input.right_trigger)
+             << ",\"buttons\":" << input.buttons << '}';
+
+  const uint32_t child_list = GuestField(base, player, 216u);
+  const uint32_t child_count = GuestField(base, player, 220u);
+  const uint32_t child = child_list && child_count ? GuestWord(base, child_list) : 0;
+  std::ostringstream simulation;
+  simulation << "{\"player_transform_words\":[" << GuestField(base, player, 144u)
+             << ',' << GuestField(base, player, 160u) << ','
+             << GuestField(base, player, 176u) << ','
+             << GuestField(base, player, 192u)
+             << "],\"child_transform_words\":[" << GuestField(base, child, 112u)
+             << ',' << GuestField(base, child, 128u) << ','
+             << GuestField(base, child, 144u) << ','
+             << GuestField(base, child, 160u) << "]}";
+
+  constexpr uint32_t kCampaignGlobalsPointer = 0x8293BA10u;
+  const uint32_t campaign = GuestWord(base, kCampaignGlobalsPointer);
+  const uint32_t manager = g_gameplay_manager.load(std::memory_order_relaxed);
+  std::ostringstream mission;
+  mission << "{\"campaign_phase\":" << GuestField(base, campaign, 24u)
+          << ",\"campaign_step\":" << GuestField(base, campaign, 28u)
+          << ",\"manager_state\":" << GuestField(base, manager, 12u)
+          << ",\"objectives\":[]}";
+
+  std::ostringstream graphics_payload;
+  graphics_payload << "{\"draw_calls\":" << graphics.draw_count
+                   << ",\"clear_calls\":" << graphics.clear_count
+                   << ",\"resolve_calls\":" << graphics.resolve_count
+                   << ",\"record_signature\":" << graphics.record_signature << '}';
+  const std::string controller_json = controller.str();
+  const std::string simulation_json = simulation.str();
+  const std::string mission_json = mission.str();
+  const std::string graphics_json = graphics_payload.str();
+  std::ostringstream hashes;
+  hashes << "{\"simulation_snapshot\":\""
+         << rex::crypto::sha256(simulation_json)
+         << "\",\"mission_objectives\":\"" << rex::crypto::sha256(mission_json)
+         << "\",\"graphics_submission\":\"" << rex::crypto::sha256(graphics_json)
+         << "\"}";
+
+  std::lock_guard<std::mutex> lock(g_trace_v2_mutex);
+  if (g_trace_v2_failed || g_trace_v2_complete || !EnsureTraceV2Output(path)) {
+    return;
+  }
+  const uint64_t tick = g_trace_v2_tick_count + 1u;
+  if (!EmitTraceV2Domain(tick, "controller_input", controller_json) ||
+      !EmitTraceV2Domain(tick, "simulation_snapshot", simulation_json) ||
+      !EmitTraceV2Domain(tick, "mission_objectives", mission_json) ||
+      !EmitTraceV2Domain(tick, "graphics_submission", graphics_json) ||
+      !EmitTraceV2Domain(tick, "output_hashes", hashes.str())) {
+    REXLOG_ERROR("AC6 oracle trace v2 write failed");
+    return;
+  }
+  ++g_trace_v2_tick_count;
+  g_trace_v2_output.flush();
+  if (g_trace_v2_tick_count == kTraceV2Ticks) {
+    g_trace_v2_complete = true;
+    REXLOG_INFO("AC6 oracle trace v2 complete: 3600 gameplay ticks");
+  }
+}
