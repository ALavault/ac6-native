+uint32_t GuestWord(uint8_t* base, uint32_t address) {
+  return address ? rex::memory::load_and_swap<uint32_t>(base + address) : 0;
+}
+
+uint32_t GuestField(uint8_t* base, uint32_t object, uint32_t offset) {
+  return object ? GuestWord(base, object + offset) : 0;
+}
+
+bool EnsureTraceV2Output(const std::string& path) {
+  if (g_trace_v2_output.is_open() && path == g_trace_v2_output_path) {
+    return true;
+  }
+  if (g_trace_v2_output.is_open()) {
+    g_trace_v2_output.close();
+  }
+  g_trace_v2_output.open(path, std::ios::out | std::ios::trunc);
+  g_trace_v2_output_path = path;
+  g_trace_v2_tick_count = 0;
+  g_trace_v2_sequence = 0;
+  g_trace_v2_output_bytes = 0;
+  g_trace_v2_failed = !g_trace_v2_output.is_open();
+  g_trace_v2_complete = false;
+  if (g_trace_v2_failed) {
+    REXLOG_ERROR("AC6 oracle trace v2 could not open its bounded output");
+    return false;
+  }
+  REXLOG_INFO("AC6 oracle trace v2 armed at the Mission 01 manager-tick boundary");
+  return true;
+}
+
+bool EmitTraceV2Domain(uint64_t tick, std::string_view domain,
+                       std::string_view payload) {
+  std::ostringstream event;
+  event << "{\"sequence\":" << g_trace_v2_sequence << ",\"tick\":" << tick
+        << ",\"domain\":\"" << domain << "\",\"payload\":" << payload
+        << "}\n";
+  const std::string line = event.str();
+  if (g_trace_v2_output_bytes + line.size() > kTraceV2MaxOutputBytes) {
+    g_trace_v2_failed = true;
+    return false;
+  }
+  g_trace_v2_output << line;
+  if (!g_trace_v2_output.good()) {
+    g_trace_v2_failed = true;
+    return false;
+  }
+  g_trace_v2_output_bytes += line.size();
+  ++g_trace_v2_sequence;
+  return true;
+}
