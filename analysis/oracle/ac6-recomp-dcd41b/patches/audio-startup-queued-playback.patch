+#include <native/audio/startup_pacing.h>
+
+#include <cassert>
+
+int main() {
+  using rex::audio::HasObservedQueuedPlayback;
+  assert(!HasObservedQueuedPlayback(0));
+  assert(HasObservedQueuedPlayback(1));
+  assert(HasObservedQueuedPlayback(42));
+  return 0;
+}
