+// Host-injected underrun silence advances the audio clock but is not evidence
+// that the render driver has consumed a queued guest frame.
+constexpr bool HasObservedQueuedPlayback(uint64_t queued_played_frames) noexcept {
+  return queued_played_frames != 0;
+}
