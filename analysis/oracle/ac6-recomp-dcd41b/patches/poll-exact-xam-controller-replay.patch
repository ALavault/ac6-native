+#include "generated/ac6recomp_config.h"
+
+#include "ac6_controller_input_replay.h"
+
+#include <atomic>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+#include <native/chrono/clock.h>
+#include <rex/ac6_controller_input_replay.h>
+#include <rex/ac6_oracle_probe.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ppc/function.h>
+#include <rex/system/thread_state.h>
+
+#include "d3d_hooks.h"
+
+#ifndef PPC_CONFIG_H_INCLUDED
+#error "AC6 oracle PPC wrappers require generated/ac6recomp_config.h first"
+#endif
+
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_header_path, "", "AC6/Oracle",
+                      "Canonical ac6.controller-input-replay.v1 header JSONL");
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_record_path, "", "AC6/Oracle",
+                      "New poll-exact controller recording path");
+REXCVAR_DEFINE_STRING(ac6_oracle_controller_replay_path, "", "AC6/Oracle",
+                      "Sealed poll-exact controller replay path");
+
+namespace ac6::oracle {
+namespace {
+
+using controller_replay::ControllerState;
+using controller_replay::Mode;
+using controller_replay::PollGuards;
+using controller_replay::PollObservation;
+using controller_replay::ReplayPoll;
+using controller_replay::Service;
+
+constexpr std::size_t kMaxHeaderBytes = 1024u * 1024u;
+
+std::mutex g_controller_mutex;
+Service g_controller_service;
+std::filesystem::path g_record_path;
+bool g_controller_initialized = false;
+std::atomic<uint64_t> g_temporary_sequence{0};
+
+bool ReadBounded(const std::filesystem::path& path, std::size_t maximum,
+                 std::string& payload, std::string& error) {
+  std::error_code status_error;
+  const uintmax_t size = std::filesystem::file_size(path, status_error);
+  if (status_error || size == 0 || size > maximum) {
+    error = "input absent, empty, or outside byte bound: " + path.string();
+    return false;
+  }
+  std::ifstream input(path, std::ios::binary);
+  if (!input) {
+    error = "input unreadable: " + path.string();
+    return false;
+  }
+  payload.assign(std::istreambuf_iterator<char>(input),
+                 std::istreambuf_iterator<char>());
+  if (!input.eof() || payload.size() != size) {
+    error = "input changed or failed while reading: " + path.string();
+    payload.clear();
+    return false;
+  }
+  return true;
+}
+
+bool AtomicWriteNew(const std::filesystem::path& destination,
+                    std::string_view payload, std::string& error) {
+  const std::filesystem::path parent = destination.parent_path().empty()
+                                           ? std::filesystem::current_path()
+                                           : destination.parent_path();
+  if (destination.filename().empty() || !std::filesystem::is_directory(parent) ||
+      std::filesystem::exists(destination)) {
+    error = "record output parent/identity is invalid or already exists";
+    return false;
+  }
+
+  std::filesystem::path temporary;
+  std::ofstream output;
+  for (uint32_t attempt = 0; attempt < 64; ++attempt) {
+    const uint64_t suffix =
+        g_temporary_sequence.fetch_add(1, std::memory_order_relaxed);
+    temporary = parent / ("." + destination.filename().string() +
+                          ".ac6-controller-" + std::to_string(suffix) + ".tmp");
+    output.open(temporary, std::ios::binary | std::ios::out |
+                               std::ios::noreplace);
+    if (output) break;
+    output.clear();
+  }
+  if (!output) {
+    error = "could not create exclusive temporary replay output";
+    return false;
+  }
+  output.write(payload.data(), static_cast<std::streamsize>(payload.size()));
+  output.flush();
+  const bool write_ok = output.good();
+  output.close();
+  if (!write_ok) {
+    std::error_code ignored;
+    std::filesystem::remove(temporary, ignored);
+    error = "temporary replay write failed";
+    return false;
+  }
+
+  std::error_code link_error;
+  std::filesystem::create_hard_link(temporary, destination, link_error);
+  std::error_code remove_error;
+  std::filesystem::remove(temporary, remove_error);
+  if (link_error || remove_error) {
+    if (!link_error) {
+      std::error_code rollback_error;
+      std::filesystem::remove(destination, rollback_error);
+    }
+    error = "atomic replay publication failed";
+    return false;
+  }
+  return true;
+}
+
+struct Telemetry {
+  uint64_t guest_tick;
+  uint64_t present_index;
+  uint32_t thread_id;
+  uint32_t caller_lr;
+};
+
+Telemetry CurrentTelemetry() {
+  rex::runtime::ThreadState* thread = rex::runtime::ThreadState::Get();
+  if (!thread || !thread->context()) {
+    REX_FATAL("AC6 controller replay called without a bound guest thread");
+  }
+  return {
+      rex::chrono::Clock::PeekGuestTickCount(),
+      ac6::d3d::GetFrameCaptureSummary().frame_index,
+      thread->thread_id(),
+      static_cast<uint32_t>(thread->context()->lr),
+  };
+}
+
+ControllerState ToServiceState(const XamControllerState& state) {
+  return {
+      state.packet_number, state.buttons,      state.left_trigger,
+      state.right_trigger, state.thumb_lx,     state.thumb_ly,
+      state.thumb_rx,      state.thumb_ry,
+  };
+}
+
+XamControllerState FromServiceState(const ControllerState& state) {
+  return {
+      state.packet_number, state.buttons,      state.left_trigger,
+      state.right_trigger, state.thumb_lx,     state.thumb_ly,
+      state.thumb_rx,      state.thumb_ry,
+  };
+}
+
+[[noreturn]] void FatalControllerReplay(std::string_view operation,
+                                        const std::string& detail) {
+  REX_FATAL("AC6 controller replay {} failed: {}", operation, detail);
+}
+
+}  // namespace
+
+bool InitializeControllerInputReplay() {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (g_controller_initialized) {
+    REXLOG_ERROR("AC6 controller replay initialized more than once");
+    return false;
+  }
+  g_controller_initialized = true;
+
+  const std::filesystem::path header_path =
+      REXCVAR_GET(ac6_oracle_controller_header_path);
+  const std::filesystem::path record_path =
+      REXCVAR_GET(ac6_oracle_controller_record_path);
+  const std::filesystem::path replay_path =
+      REXCVAR_GET(ac6_oracle_controller_replay_path);
+  if (!rex::cvar::GetFlagByName("ac6_oracle_trace_v2_input_path").empty()) {
+    REXLOG_ERROR(
+        "Legacy manager-tick TSV replay is retired; use the poll-exact XAM "
+        "controller replay lane");
+    return false;
+  }
+  if (record_path.empty() && replay_path.empty()) {
+    if (!header_path.empty()) {
+      REXLOG_ERROR("AC6 controller header configured without record/replay mode");
+      return false;
+    }
+    return true;
+  }
+  if (header_path.empty() || (!record_path.empty() && !replay_path.empty())) {
+    REXLOG_ERROR("AC6 controller replay requires one mode and one header");
+    return false;
+  }
+
+  std::string header;
+  std::string error;
+  if (!ReadBounded(header_path, kMaxHeaderBytes, header, error)) {
+    REXLOG_ERROR("AC6 controller replay initialization: {}", error);
+    return false;
+  }
+  if (!record_path.empty()) {
+    if (record_path == header_path || std::filesystem::exists(record_path) ||
+        !g_controller_service.BeginRecord(header, error)) {
+      REXLOG_ERROR("AC6 controller record initialization: {}",
+                   error.empty() ? "output identity" : error);
+      return false;
+    }
+    g_record_path = record_path;
+    REXLOG_INFO(
+        "AC6 controller record armed before guest launch at PAL marker "
+        "0x821CA908 BEFORE (cadence unqualified)");
+    return true;
+  }
+
+  if (replay_path == header_path) {
+    REXLOG_ERROR("AC6 controller replay and header paths must differ");
+    return false;
+  }
+  std::string replay;
+  if (!ReadBounded(replay_path, controller_replay::kMaxReplayBytes, replay,
+                   error) ||
+      !g_controller_service.BeginReplay(replay, header, error)) {
+    REXLOG_ERROR("AC6 controller replay initialization: {}", error);
+    return false;
+  }
+  REXLOG_INFO(
+      "AC6 controller replay loaded before guest launch at PAL marker "
+      "0x821CA908 BEFORE (cadence unqualified)");
+  return true;
+}
+
+bool FinalizeControllerInputReplay() {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (!g_controller_initialized) return true;
+  const Mode mode = g_controller_service.mode();
+  std::string sealed;
+  std::string error;
+  if (!g_controller_service.Finalize(sealed, error)) {
+    REXLOG_ERROR("AC6 controller replay finalization: {}", error);
+    return false;
+  }
+  if (mode == Mode::kRecord && !AtomicWriteNew(g_record_path, sealed, error)) {
+    REXLOG_ERROR("AC6 controller record publication: {}", error);
+    return false;
+  }
+  if (mode != Mode::kDisabled) {
+    REXLOG_INFO("AC6 controller replay finalized polls={} markers={}",
+                g_controller_service.poll_index(),
+                g_controller_service.marker_index());
+  }
+  g_controller_initialized = false;
+  g_record_path.clear();
+  return true;
+}
+
+XamControllerPollAction BeginXamInputGetState(
+    uint32_t user_index, uint32_t flags, uint32_t state_ptr, uint32_t& result,
+    XamControllerState& state, bool& has_state,
+    XamControllerPollRecord& record) {
+  record = {};
+  g_controller_mutex.lock();
+  const Mode mode = g_controller_service.mode();
+  if (mode == Mode::kDisabled) {
+    g_controller_mutex.unlock();
+    return XamControllerPollAction::kPhysical;
+  }
+  const Telemetry telemetry = CurrentTelemetry();
+  if (mode == Mode::kReplay) {
+    ReplayPoll replay;
+    std::string error;
+    const bool accepted = g_controller_service.ReplayNextPoll(
+        {telemetry.caller_lr, user_index, flags, state_ptr == 0}, replay,
+        error);
+    if (accepted) {
+      result = replay.result;
+      has_state = replay.state.has_value();
+      if (replay.state) state = FromServiceState(*replay.state);
+    }
+    g_controller_mutex.unlock();
+    if (!accepted) FatalControllerReplay("poll", error);
+    if (has_state) {
+      PublishInputState(user_index, state.packet_number, state.buttons,
+                        state.left_trigger, state.right_trigger, state.thumb_lx,
+                        state.thumb_ly, state.thumb_rx, state.thumb_ry);
+    }
+    return XamControllerPollAction::kReplay;
+  }
+
+  record = {
+      true, telemetry.guest_tick, telemetry.present_index, telemetry.thread_id,
+      telemetry.caller_lr, user_index, flags, state_ptr,
+  };
+  return XamControllerPollAction::kRecord;
+}
+
+void CompleteRecordXamInputGetState(XamControllerPollRecord& record,
+                                    uint32_t result,
+                                    const XamControllerState* state) {
+  if (!record.armed) return;
+  PollObservation observation{
+      record.guest_tick,
+      record.present_index,
+      record.thread_id,
+      record.caller_lr,
+      record.user_index,
+      record.flags,
+      record.state_ptr,
+      result,
+      state ? std::optional<ControllerState>(ToServiceState(*state))
+            : std::nullopt,
+  };
+  std::string error;
+  const bool accepted = g_controller_service.RecordPoll(observation, error);
+  record.armed = false;
+  g_controller_mutex.unlock();
+  if (!accepted) FatalControllerReplay("record poll", error);
+}
+
+void ControllerInputMarkerBefore() {
+  std::lock_guard<std::mutex> lock(g_controller_mutex);
+  if (g_controller_service.mode() == Mode::kDisabled) return;
+  const Telemetry telemetry = CurrentTelemetry();
+  std::string error;
+  if (!g_controller_service.MarkerBefore(telemetry.guest_tick,
+                                         telemetry.present_index, error)) {
+    FatalControllerReplay("marker", error);
+  }
+}
