+#pragma once
+
+#include <cstdint>
+
+namespace ac6::oracle {
+
+struct XamControllerState {
+  uint32_t packet_number{0};
+  uint16_t buttons{0};
+  uint8_t left_trigger{0};
+  uint8_t right_trigger{0};
+  int16_t thumb_lx{0};
+  int16_t thumb_ly{0};
+  int16_t thumb_rx{0};
+  int16_t thumb_ry{0};
+};
+
+// Opaque recording admission retained across the physical input call. When
+// armed, the runtime serializes that call with markers so the poll ordinal is
+// reserved at the XAM entry seam rather than at return time.
+struct XamControllerPollRecord {
+  bool armed{false};
+  uint64_t guest_tick{0};
+  uint64_t present_index{0};
+  uint32_t thread_id{0};
+  uint32_t caller_lr{0};
+  uint32_t user_index{0};
+  uint32_t flags{0};
+  uint32_t state_ptr{0};
+};
+
+enum class XamControllerPollAction {
+  kPhysical,
+  kRecord,
+  kReplay,
+};
+
+// Called after cvars and the PAL XEX are loaded, but before LaunchModule.
+bool InitializeControllerInputReplay();
+bool FinalizeControllerInputReplay();
+
+// One admission point decides replay, serialized record, or the untouched
+// physical path before any input driver is entered. A record admission must be
+// completed on every physical or validation return path.
+XamControllerPollAction BeginXamInputGetState(
+    uint32_t user_index, uint32_t flags, uint32_t state_ptr, uint32_t& result,
+    XamControllerState& state, bool& has_state,
+    XamControllerPollRecord& record);
+void CompleteRecordXamInputGetState(XamControllerPollRecord& record,
+                                    uint32_t result,
+                                    const XamControllerState* state);
+
+// Qualified PAL 0x821CA908 function-entry marker, before guest instructions.
+void ControllerInputMarkerBefore();
+
+}  // namespace ac6::oracle
