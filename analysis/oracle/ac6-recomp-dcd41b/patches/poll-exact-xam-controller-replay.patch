+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ac6::oracle::controller_replay {
+
+constexpr std::size_t kMaxReplayBytes = 128u * 1024u * 1024u;
+constexpr std::size_t kMaxEvents = 1'000'000u;
+
+struct ControllerState {
+  uint32_t packet_number{0};
+  uint16_t buttons{0};
+  uint8_t left_trigger{0};
+  uint8_t right_trigger{0};
+  int16_t thumb_lx{0};
+  int16_t thumb_ly{0};
+  int16_t thumb_rx{0};
+  int16_t thumb_ry{0};
+
+  bool operator==(const ControllerState&) const = default;
+};
+
+struct PollObservation {
+  uint64_t guest_tick{0};
+  uint64_t present_index{0};
+  uint32_t thread_id{0};
+  uint32_t caller_lr{0};
+  uint32_t user_index{0};
+  uint32_t flags{0};
+  uint32_t state_ptr{0};
+  uint32_t result{0};
+  std::optional<ControllerState> state;
+};
+
+struct PollGuards {
+  uint32_t caller_lr{0};
+  uint32_t user_index{0};
+  uint32_t flags{0};
+  bool state_ptr_null{true};
+};
+
+struct ReplayPoll {
+  uint32_t result{0};
+  std::optional<ControllerState> state;
+};
+
+enum class Mode {
+  kDisabled,
+  kRecord,
+  kReplay,
+};
+
+// Poll-exact service for ac6.controller-input-replay.v1. The runtime owns file
+// IO; this class owns bounded parsing, canonical sealing and event ordering.
+class Service {
+ public:
+  bool BeginRecord(std::string_view canonical_header, std::string& error);
+  bool BeginReplay(std::string_view replay, std::string_view canonical_expected_header,
+                   std::string& error);
+
+  bool MarkerBefore(uint64_t guest_tick, uint64_t present_index, std::string& error);
+  bool RecordPoll(const PollObservation& observation, std::string& error);
+  bool ReplayNextPoll(const PollGuards& guards, ReplayPoll& output, std::string& error);
+
+  // Record mode returns the sealed JSONL. Replay mode requires exact EOF and
+  // returns an empty payload. Disabled mode is a no-op.
+  bool Finalize(std::string& sealed_recording, std::string& error);
+
+  [[nodiscard]] Mode mode() const { return mode_; }
+  [[nodiscard]] bool failed() const { return failed_; }
+  [[nodiscard]] uint64_t poll_index() const { return poll_index_; }
+  [[nodiscard]] uint64_t marker_index() const { return marker_index_; }
+
+ private:
+  bool Fail(std::string message, std::string& error);
+  void Reset();
+
+  Mode mode_{Mode::kDisabled};
+  bool failed_{false};
+  std::string failure_;
+  std::string header_line_;
+  std::string body_;
+  std::string replay_bytes_;
+  std::vector<std::string> replay_event_lines_;
+  std::size_t replay_cursor_{0};
+  uint64_t sequence_{0};
+  uint64_t poll_index_{0};
+  uint64_t marker_index_{0};
+  uint64_t poll_in_marker_{0};
+  uint64_t last_guest_tick_{0};
+  uint64_t last_present_index_{0};
+};
+
+}  // namespace ac6::oracle::controller_replay
