+#include "ac6_controller_input_replay.h"
+
+#include <cassert>
+#include <string>
+
+namespace {
+
+using ac6::oracle::controller_replay::ControllerState;
+using ac6::oracle::controller_replay::PollObservation;
+using ac6::oracle::controller_replay::ReplayPoll;
+using ac6::oracle::controller_replay::Service;
+
+constexpr const char* kGolden =
+    R"json({"kind":"header","producer":{"binary_sha256":"1111111111111111111111111111111111111111111111111111111111111111","implementation_commit":"dcd41b7457fcac8242f8ef40de83d1719390d5af","lane":"ac6-recomp","platform":"linux-x86_64-vulkan"},"schema":"ac6.controller-input-replay.v1","segment":{"kind":"full_recording","parent_marker_count":null,"parent_payload_sha256":null,"parent_replay_sha256":null,"parent_start_marker":null},"session":{"behavior_config_sha256":"7777777777777777777777777777777777777777777777777777777777777777","content_manifest_sha256":"3333333333333333333333333333333333333333333333333333333333333333","profile_save_manifest_sha256":"5555555555555555555555555555555555555555555555555555555555555555","route_sha256":"6666666666666666666666666666666666666666666666666666666666666666","runtime_config_sha256":"4444444444444444444444444444444444444444444444444444444444444444","segment_origin":"sealed_retail_save"},"sync":{"cadence":{"native_hz":60,"projection":"unique_successful_user0_poll","resampling":"refuse","source_hz":null,"status":"unqualified"},"lane_local_diagnostics":["thread_id","state_ptr"],"marker_phase":"before_input","marker_role":"ac6_frame_input_stage","portable_guards":["marker_index","poll_in_marker","caller_lr","user_index","flags","state_ptr_null"],"primary":"poll_index","telemetry":["guest_tick","present_index"]},"target":{"base_version":"v0.0.0.11","marker_address":"821CA908","marker_code_sha256":"2222222222222222222222222222222222222222222222222222222222222222","media_id":"0379EFB3","module":"default.xex","module_xxh3":"0123456789abcdef","title_id":"4E4D07D1","xex_sha256":"acc302c1599c7a2fd38bd5a7de395b418a157d7001b6f986ab7113f45711bcde","xex_version":"v0.0.0.11"}}
+{"guest_tick":100,"kind":"marker","marker_index":1,"poll_index":0,"present_index":1,"sequence":0}
+{"caller_lr":2184500248,"flags":1,"guest_tick":101,"kind":"poll","marker_index":1,"poll_in_marker":0,"poll_index":0,"present_index":1,"result":0,"sequence":1,"state":{"buttons":4096,"left_trigger":0,"packet_number":10,"right_trigger":127,"thumb_lx":123,"thumb_ly":-321,"thumb_rx":-20,"thumb_ry":20},"state_ptr":2701135872,"thread_id":7,"user_index":0}
+{"event_count":2,"kind":"footer","marker_count":1,"payload_sha256":"35abc1fe0d1bfa61d138a88753e2d961275cc6c1c790292e8c4ebabbf8306c15","poll_count":1,"present_count":1}
+)json";
+
+std::string Header() {
+  const std::string golden = kGolden;
+  return golden.substr(0, golden.find('\n') + 1u);
+}
+
+ControllerState State() {
+  return {10, 0x1000, 0, 127, 123, -321, -20, 20};
+}
+
+void GoldenRecordAndReplay() {
+  Service record;
+  std::string error;
+  assert(record.BeginRecord(Header(), error));
+  assert(record.MarkerBefore(100, 1, error));
+  PollObservation poll{101,       1,          7, 0x8234D418u, 0,
+                       1,         0xA1001000, 0, State()};
+  assert(record.RecordPoll(poll, error));
+  std::string sealed;
+  assert(record.Finalize(sealed, error));
+  assert(sealed == kGolden);
+
+  Service replay;
+  assert(replay.BeginReplay(kGolden, Header(), error));
+  // Guest/present clocks are telemetry, not synchronization keys.
+  assert(replay.MarkerBefore(999, 99, error));
+  ReplayPoll output;
+  assert(replay.ReplayNextPoll({0x8234D418u, 0, 1, false}, output,
+                               error));
+  assert(output.result == 0);
+  assert(output.state == State());
+  assert(replay.Finalize(sealed, error));
+  assert(sealed.empty());
+}
+
+void FailClosedCases() {
+  std::string error;
+  Service truncated;
+  std::string payload = kGolden;
+  payload.resize(payload.rfind('\n', payload.size() - 2u) + 1u);
+  assert(!truncated.BeginReplay(payload, Header(), error));
+  assert(!error.empty());
+
+  Service corrupt;
+  payload = kGolden;
+  payload[payload.find("35abc1fe")] = '4';
+  assert(!corrupt.BeginReplay(payload, Header(), error));
+  assert(error == "footer payload_sha256");
+
+  Service mismatch;
+  assert(mismatch.BeginReplay(kGolden, Header(), error));
+  assert(mismatch.MarkerBefore(100, 1, error));
+  ReplayPoll output;
+  assert(!mismatch.ReplayNextPoll({0xDEADBEEFu, 0, 1, false}, output,
+                                  error));
+  const std::string first_error = error;
+  assert(first_error.find("poll_index=0 guard=caller_lr") !=
+         std::string::npos);
+  assert(!mismatch.ReplayNextPoll({0x8234D418u, 0, 1, false}, output,
+                                  error));
+  assert(error == first_error);
+
+  Service incomplete;
+  assert(incomplete.BeginRecord(Header(), error));
+  assert(incomplete.MarkerBefore(100, 1, error));
+  std::string sealed;
+  assert(!incomplete.Finalize(sealed, error));
+}
+
+void HeaderIdentityIsSealed() {
+  std::string error;
+  std::string wrong = Header();
+  wrong.replace(wrong.find("821CA908"), 8, "8226D1C8");
+  Service service;
+  assert(!service.BeginRecord(wrong, error));
+  assert(error == "PAL target identity");
+}
+
+}  // namespace
+
+int main() {
+  GoldenRecordAndReplay();
+  FailClosedCases();
+  HeaderIdentityIsSealed();
+  return 0;
+}
