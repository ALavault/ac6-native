@@ -0,0 +1,79 @@
+#include "generated/ac6recomp_config.h"
+
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <string_view>
+
+#include <rex/ppc/function.h>
+
+#include "ac6_decimal_parse.h"
+
+#ifndef PPC_CONFIG_H_INCLUDED
+#error "AC6 oracle PPC wrappers require generated/ac6recomp_config.h first"
+#endif
+
+PPC_EXTERN_FUNC(__imp__sub_820E7F80);
+
+// Qualified PAL default.xex thunk:
+//   0x82382480 li r5,10
+//   0x82382484 li r4,0
+//   0x82382488 b 0x823821D0
+// The pinned ReXGlue CRT map misidentifies the shared worker as strcpy_s and
+// returns EINVAL (22). Keep the correction at the public atoi boundary.
+PPC_FUNC_IMPL(sub_82382480) {
+  PPC_FUNC_PROLOGUE();
+  std::array<char, 128> input{};
+  size_t length = 0;
+  if (ctx.r3.u32 != 0) {
+    for (; length + 1 < input.size(); ++length) {
+      input[length] = static_cast<char>(PPC_LOAD_U8(ctx.r3.u32 + length));
+      if (input[length] == '\0') {
+        break;
+      }
+    }
+  }
+  ctx.r3.s64 = ac6::decimal_parse::ParseAtoi(
+      std::string_view(input.data(), length));
+}
+
+// Qualified PAL default.xex vtable thunk, body SHA-256
+// 829ec6aaa88b2ebb142acfd3ec48057553b05b59a7ef3254f8ba632b086825c9:
+//   0x820F6180 lwz r12,0(r3)
+//   0x820F6184 lwz r11,0x74(r12)
+//   0x820F6188 mtctr r11
+//   0x820F618C bctr
+// It is a canonical function boundary missing from the pinned generated tree.
+PPC_FUNC_IMPL(rex_sub_820F6180) {
+  PPC_FUNC_PROLOGUE();
+  ctx.r12.u64 = PPC_LOAD_U32(ctx.r3.u32);
+  ctx.r11.u64 = PPC_LOAD_U32(ctx.r12.u32 + 0x74);
+  ctx.ctr.u64 = ctx.r11.u64;
+  static std::atomic<uint32_t> lines{0};
+  if (lines.fetch_add(1, std::memory_order_relaxed) < 8) {
+    std::fprintf(stderr,
+                 "[ac6-oracle-indirect-dispatch] thunk=0x820F6180 "
+                 "target=0x%08X caller=0x%08X\n",
+                 ctx.ctr.u32, static_cast<uint32_t>(ctx.lr));
+    std::fflush(stderr);
+  }
+  PPC_CALL_INDIRECT_FUNC(ctx.ctr.u32);
+}
+
+// Capture-only visibility for the next virtual dispatch reached by the
+// qualified 0x820F6180 thunk. The generated implementation remains intact.
+PPC_FUNC_IMPL(sub_820E7F80) {
+  PPC_FUNC_PROLOGUE();
+  const uint32_t object = ctx.r4.u32;
+  const uint32_t vtable = object == 0 ? 0 : PPC_LOAD_U32(object);
+  const uint32_t target = vtable == 0 ? 0 : PPC_LOAD_U32(vtable + 0x60);
+  static std::atomic<uint32_t> lines{0};
+  if (lines.fetch_add(1, std::memory_order_relaxed) < 8) {
+    std::fprintf(stderr,
+                 "[ac6-oracle-indirect-dispatch] caller=0x820E7FA8 "
+                 "object=0x%08X vtable=0x%08X target=0x%08X\n",
+                 object, vtable, target);
+    std::fflush(stderr);
+  }
+  __imp__sub_820E7F80(ctx, base);
+}
diff --git a/tests/ac6_decimal_parse_test.cpp b/tests/ac6_decimal_parse_test.cpp
new file mode 100644
index 00000000..b91d224d
--- /dev/null
+++ b/tests/ac6_decimal_parse_test.cpp
@@ -0,0 +1,17 @@
+#include "ac6_decimal_parse.h"
+
+#include <cassert>
+#include <limits>
+
+int main() {
+  using ac6::decimal_parse::ParseAtoi;
+  assert(ParseAtoi("350") == 350);
+  assert(ParseAtoi("500_briefing_Main") == 500);
+  assert(ParseAtoi("  \t-42x") == -42);
+  assert(ParseAtoi("+17") == 17);
+  assert(ParseAtoi("x17") == 0);
+  assert(ParseAtoi("") == 0);
+  assert(ParseAtoi("2147483648") == std::numeric_limits<int32_t>::max());
+  assert(ParseAtoi("-2147483649") == std::numeric_limits<int32_t>::min());
+  return 0;
+}
