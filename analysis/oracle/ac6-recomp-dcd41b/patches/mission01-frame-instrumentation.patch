diff --git a/src/ac6_oracle_probe.cpp b/src/ac6_oracle_probe.cpp
new file mode 100644
index 00000000..d9256172
--- /dev/null
+++ b/src/ac6_oracle_probe.cpp
@@ -0,0 +1,221 @@
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <fstream>
+#include <iomanip>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <string_view>
+
+#include <rex/ac6_oracle_probe.h>
+#include <rex/crypto/sha256.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ppc.h>
+
+#include "d3d_hooks.h"
+
+REXCVAR_DEFINE_STRING(ac6_oracle_probe_path, "", "AC6/Oracle",
+                      "Capture-only Mission 01 JSONL probe output path");
+
+namespace ac6::oracle {
+namespace {
+
+constexpr uint64_t kMaxEvents = 1800;
+constexpr uint64_t kMaxOutputBytes = 16 * 1024 * 1024;
+
+struct InputSnapshot {
+  uint32_t packet_number{0};
+  uint16_t buttons{0};
+  uint8_t left_trigger{0};
+  uint8_t right_trigger{0};
+  int16_t thumb_lx{0};
+  int16_t thumb_ly{0};
+  int16_t thumb_rx{0};
+  int16_t thumb_ry{0};
+};
+
+std::mutex g_input_mutex;
+InputSnapshot g_input;
+
+std::mutex g_output_mutex;
+std::ofstream g_output;
+std::string g_output_path;
+uint64_t g_event_count = 0;
+uint64_t g_output_bytes = 0;
+bool g_output_failed = false;
+
+InputSnapshot SnapshotInput() {
+  std::lock_guard<std::mutex> lock(g_input_mutex);
+  return g_input;
+}
+
+std::string ButtonArray(uint16_t mask) {
+  struct Button {
+    uint16_t mask;
+    std::string_view name;
+  };
+  static constexpr std::array<Button, 15> kButtons{{
+      {0x0001, "dpad_up"},       {0x0002, "dpad_down"},
+      {0x0004, "dpad_left"},     {0x0008, "dpad_right"},
+      {0x0010, "start"},         {0x0020, "back"},
+      {0x0040, "left_thumb"},    {0x0080, "right_thumb"},
+      {0x0100, "left_shoulder"}, {0x0200, "right_shoulder"},
+      {0x0400, "guide"},         {0x1000, "a"},
+      {0x2000, "b"},             {0x4000, "x"},
+      {0x8000, "y"},
+  }};
+  std::ostringstream output;
+  output << '[';
+  bool first = true;
+  for (const Button& button : kButtons) {
+    if ((mask & button.mask) == 0) {
+      continue;
+    }
+    output << (first ? "\"" : ",\"") << button.name << '\"';
+    first = false;
+  }
+  output << ']';
+  return output.str();
+}
+
+std::string RegisterDigest(const PPCContext& ctx) {
+  std::ostringstream payload;
+  payload << std::hex << std::setfill('0');
+  const std::array<uint64_t, 10> values{{
+      ctx.r3.u64, ctx.r4.u64, ctx.r5.u64, ctx.r6.u64, ctx.r7.u64,
+      ctx.r8.u64, ctx.r9.u64, ctx.r10.u64, ctx.lr, ctx.ctr.u64,
+  }};
+  for (uint64_t value : values) {
+    payload << std::setw(16) << value;
+  }
+  return rex::crypto::sha256(payload.str());
+}
+
+std::string GraphicsDigest(const ac6::d3d::FrameCaptureSummary& graphics) {
+  std::ostringstream payload;
+  payload << graphics.frame_index << ':' << graphics.draw_count << ':'
+          << graphics.clear_count << ':' << graphics.resolve_count << ':'
+          << graphics.record_signature << ':' << graphics.frame_end_render_target_0 << ':'
+          << graphics.frame_end_depth_stencil << ':' << graphics.frame_end_viewport_width << ':'
+          << graphics.frame_end_viewport_height;
+  return rex::crypto::sha256(payload.str());
+}
+
+bool EnsureOutput(const std::string& path) {
+  if (g_output.is_open() && path == g_output_path) {
+    return true;
+  }
+  if (g_output.is_open()) {
+    g_output.close();
+  }
+  g_output.open(path, std::ios::out | std::ios::trunc);
+  g_output_path = path;
+  g_event_count = 0;
+  g_output_bytes = 0;
+  g_output_failed = !g_output.is_open();
+  if (g_output_failed) {
+    REXLOG_ERROR("AC6 oracle probe could not open its bounded output");
+    return false;
+  }
+  REXLOG_INFO("AC6 oracle Mission 01 probe enabled");
+  return true;
+}
+
+void EmitSchedulerEvent(const PPCContext& ctx) {
+  const std::string path = REXCVAR_GET(ac6_oracle_probe_path);
+  if (path.empty()) {
+    return;
+  }
+  const InputSnapshot input = SnapshotInput();
+  const ac6::d3d::FrameCaptureSummary graphics = ac6::d3d::GetFrameCaptureSummary();
+  const std::string register_digest = RegisterDigest(ctx);
+  const std::string graphics_digest = GraphicsDigest(graphics);
+
+  std::lock_guard<std::mutex> lock(g_output_mutex);
+  if (g_output_failed || !EnsureOutput(path) || g_event_count >= kMaxEvents) {
+    return;
+  }
+
+  std::ostringstream event;
+  event << "{\"guest_address\":\"0x82267370\",\"tick\":" << g_event_count
+        << ",\"input\":{\"axes\":{\"lx\":" << input.thumb_lx
+        << ",\"ly\":" << input.thumb_ly << ",\"rx\":" << input.thumb_rx
+        << ",\"ry\":" << input.thumb_ry << "},\"triggers\":{\"left\":"
+        << static_cast<uint32_t>(input.left_trigger) << ",\"right\":"
+        << static_cast<uint32_t>(input.right_trigger) << "},\"buttons\":"
+        << ButtonArray(input.buttons) << "},\"graphics\":{\"frame_index\":"
+        << graphics.frame_index << ",\"draw_calls\":" << graphics.draw_count
+        << ",\"clear_calls\":" << graphics.clear_count << ",\"resolve_calls\":"
+        << graphics.resolve_count << ",\"record_signature\":"
+        << graphics.record_signature << ",\"state_digest\":\"" << graphics_digest
+        << "\"},\"output_hashes\":{\"graphics\":\"" << graphics_digest
+        << "\",\"scheduler_registers\":\"" << register_digest << "\"}}\n";
+  const std::string line = event.str();
+  if (g_output_bytes + line.size() > kMaxOutputBytes) {
+    return;
+  }
+  g_output << line;
+  g_output.flush();
+  if (!g_output.good()) {
+    g_output_failed = true;
+    REXLOG_ERROR("AC6 oracle probe write failed");
+    return;
+  }
+  g_output_bytes += line.size();
+  ++g_event_count;
+}
+
+}  // namespace
+
+void PublishInputState(uint32_t user_index, uint32_t packet_number, uint16_t buttons,
+                       uint8_t left_trigger, uint8_t right_trigger, int16_t thumb_lx,
+                       int16_t thumb_ly, int16_t thumb_rx, int16_t thumb_ry) {
+  if (user_index != 0 || std::string(REXCVAR_GET(ac6_oracle_probe_path)).empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_input_mutex);
+  static std::atomic<uint32_t> transition_lines{0};
+  if (buttons != g_input.buttons &&
+      transition_lines.fetch_add(1, std::memory_order_relaxed) < 512) {
+    REXLOG_INFO(
+        "[ac6-oracle-input] packet={} buttons=0x{:04X}->0x{:04X} "
+        "axes={},{},{},{} triggers={},{}",
+        packet_number, g_input.buttons, buttons, thumb_lx, thumb_ly,
+        thumb_rx, thumb_ry, left_trigger, right_trigger);
+  }
+  g_input = {packet_number, buttons, left_trigger, right_trigger,
+             thumb_lx, thumb_ly, thumb_rx, thumb_ry};
+}
+
+}  // namespace ac6::oracle
+
+PPC_EXTERN_FUNC(__imp__sub_82267370);
+
+PPC_FUNC_IMPL(sub_82267370) {
+  PPC_FUNC_PROLOGUE();
+  __imp__sub_82267370(ctx, base);
+  ac6::oracle::EmitSchedulerEvent(ctx);
+}
+
+PPC_EXTERN_FUNC(__imp__sub_8237BF08);
+PPC_EXTERN_FUNC(__imp__sub_8237C828);
+
+PPC_FUNC_IMPL(sub_8237BF08) {
+  PPC_FUNC_PROLOGUE();
+  static std::atomic_flag logged = ATOMIC_FLAG_INIT;
+  if (!logged.test_and_set()) {
+    REXLOG_INFO("AC6 oracle frontier reached: 0x8237BF08");
+  }
+  __imp__sub_8237BF08(ctx, base);
+}
+
+PPC_FUNC_IMPL(sub_8237C828) {
+  PPC_FUNC_PROLOGUE();
+  static std::atomic_flag logged = ATOMIC_FLAG_INIT;
+  if (!logged.test_and_set()) {
+    REXLOG_INFO("AC6 oracle frontier reached: 0x8237C828");
+  }
+  __imp__sub_8237C828(ctx, base);
+}
