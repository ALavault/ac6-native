+  if (!self) {
+    return;
+  }
+  const uint32_t after_state = GuestWord(base, self + 12);
+  const uint32_t after_timer = GuestWord(base, self + 72);
+  if (before_state != after_state) {
+    REXLOG_INFO(
+        "[ac6-campaign-transition] self=0x{:08X} state={}->{} timer={}->{}",
+        self, before_state, after_state, before_timer, after_timer);
+  }
+}
+
+PPC_FUNC_IMPL(sub_820D8FE0) {
+  PPC_FUNC_PROLOGUE();
+  constexpr uint32_t kCampaignTaskCaller = 0x8218F5A4u;
+  const uint32_t task = ctx.r3.u32;
+  const uint32_t caller = ctx.lr;
+  const uint32_t owner = task ? GuestWord(base, task + 4) : 0;
+  const uint32_t payload = task ? GuestWord(base, task + 24) : 0;
+  __imp__sub_820D8FE0(ctx, base);
+
+  static std::atomic<uint32_t> last_task{0};
+  if (caller == kCampaignTaskCaller && task &&
+      last_task.exchange(task, std::memory_order_relaxed) != task) {
+    REXLOG_INFO(
+        "[ac6-first-mission-task] task=0x{:08X} owner=0x{:08X} "
+        "payload=0x{:08X} caller=0x{:08X}",
+        task, owner, payload, caller);
+  }
+}
