key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
sleep	3
