# Reach Mission 01, confirm the aircraft and weapon, then use Start from the
# aircraft-select screen to launch the mission.
key	Left	0.1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	20
wait-pulse	\[ac6-first-campaign-level-bridge\]	Escape
sleep	20
key	space	0.1
present	120	30
capture	mission-submenu
key	space	0.1
present	180	30
capture	aircraft-select
key	space	0.1
present	300	45
capture	weapon-select
key	space	0.1
present	300	45
capture	weapon-confirmed
key	Escape	0.1
present	900	120
capture	mission-launch-start
