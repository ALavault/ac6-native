# Cancel the optional Game Data browser and continue without save data.
# The harness starts this after selector44=3 is observed.
capture	game-data-browser
key	Shift	0.1
wait	selector44=10	20
sleep	1
capture	post-browser-cancel
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	continue-without-save
key	Shift	0.1
wait-pulse	\[ac6-first-campaign-level-bridge\]	Escape
sleep	15
key	space	0.1
sleep	5
capture	aircraft-select
