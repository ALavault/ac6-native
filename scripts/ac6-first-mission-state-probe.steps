# State-driven Mission 01 route used to qualify the post-briefing frontier.
# Keep this probe free of force_loadout_* overrides; the saved profile only
# supplies the menu entry point.
capture	game-data-browser
key	Shift	0.1
wait	selector44=10	20
sleep	1
capture	post-browser-cancel
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	create-game-data-prompt
key	space	0.1
sleep	2
capture	post-create-confirm
key	space	0.1
sleep	5
capture	post-file-selection
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
sleep	1
capture	slot-create-prompt-ready
key	Left	0.1
key	space	0.1
sleep	5
capture	post-slot-create-confirm
key	space	0.1
sleep	3
capture	campaign-new-game
key	space	0.1
sleep	3
capture	difficulty
key	space	0.1
sleep	3
capture	controls
key	space	0.1
sleep	3
capture	language
key	space	0.1
sleep	8
capture	campaign-intro
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape
capture	post-campaign-intro-skip
sleep	5
capture	mission-01-start
key	space	0.1
sleep	15
capture	post-start-a
key	space	0.1
sleep	20
capture	post-start-b
key	space	0.1
sleep	12
capture	post-weapon-confirm
key	Shift	0.1
sleep	8
capture	mission-submenu-ready
key	space	0.1
sleep	35
capture	mission-launch
key	space	0.1
sleep	60
capture	mission-briefing
key	space	0.1
sleep	45
capture	mission-cinematic
sleep	30
capture	post-cinematic-30s
key	space	0.1
sleep	15
capture	post-cinematic-a-15s
key	Escape	0.1
sleep	15
capture	post-cinematic-start-15s
# The previous capture is the first HUD frame. Exercise the MnK analog bindings
# while the mission is still live; W/S are left-stick pitch, A/D roll, and the
# trigger bindings cover throttle/brake. Each hold is long enough to span
# several guest polls, then the release is observed at a separate boundary.
key	W	1.0
sleep	2
capture	flight-pitch-up
key	S	1.0
sleep	2
capture	flight-pitch-down
key	A	1.0
sleep	2
capture	flight-roll-left
key	D	1.0
sleep	2
capture	flight-roll-right
key	LMB	1.0
sleep	2
capture	flight-throttle
key	RMB	1.0
sleep	2
capture	flight-brake
