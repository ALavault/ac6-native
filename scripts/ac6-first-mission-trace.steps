# Reach the first campaign mission, then arm the trace-gated edge probe on the
# first mission input. The runtime cvar ac6_trace_mission_edges excludes all
# menu/cutscene presses before the resource bridge.
key	Left	0.1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
key	space	0.1
present	120	20
key	space	0.1
present	90	20
key	space	0.1
present	90	20
key	space	0.1
present	90	20
key	space	0.1
present	90	20
key	space	0.1
present	180	30
key	space	0.1
present	180	30
key	Escape	0.1
wait	\[ac6-first-campaign-level-bridge\]	60
sleep	20
key	space	0.1
present	120	30
capture	mission-edge
