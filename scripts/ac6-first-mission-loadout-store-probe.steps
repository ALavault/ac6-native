# Cycle-518 bounded loadout store probe. This follows only qualified menu-state
# markers, stops before mission launch, and leaves time for the store watcher to
# flush the capture armed by the final A edge.
key	Left	0.1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	20
wait-pulse	\[ac6-first-campaign-level-bridge\]	Escape
sleep	15
key	space	0.1
sleep	5
capture	aircraft-select
key	space	0.1
sleep	5
key	space	0.1
sleep	5
key	space	0.1
sleep	5
key	space	0.1
wait	\[ac6-loadout-ready-override\]	20
sleep	12
capture	loadout-store-flushed
