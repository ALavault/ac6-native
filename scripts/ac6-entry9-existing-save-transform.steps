# Bounded Mission 01 renderer route from a populated native save. The harness
# starts after selector44=3 and waits for the exact entry-9 mapobj draw marker.
capture	existing-save-browser
key	space	0.1
wait	type28=[^ ]*6	20
capture	existing-save-type6
sleep	1
key	Left	0.1
sleep	1
key	Left	0.1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
capture	existing-save-loaded
sleep	8
capture	post-save-load
key	space	0.1
sleep	5
capture	loadout-after-a
key	space	0.1
sleep	5
capture	loadout-after-a2
key	space	0.1
sleep	12
capture	loadout-before-launch
key	Shift	0.1
sleep	8
capture	mission-submenu-ready
key	space	0.1
sleep	20
capture	mission-launch-window
key	space	0.1
sleep	10
capture	mission-flight-candidate
wait	\[ac6-entry9-mapobj-draw\]	120
capture	entry9-mapobj-draw
present	60	20
capture	entry9-mapobj-draw-window-end
