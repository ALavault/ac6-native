# Lane-observe route from the qualified cycle-775 save seed. The seed bypasses
# fresh-save synthesis; no state, transition, objective or unit is forced.
capture	existing-save-browser
key	space	0.1
wait	type28=[^ ]*6	20
capture	existing-save-type6
sleep	1
key	Left	0.1
sleep	1
key	Left	0.1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
capture	existing-save-loaded
sleep	8
capture	post-save-load
key	space	0.1
sleep	5
capture	loadout-after-a
key	space	0.1
sleep	5
capture	loadout-after-a2
key	space	0.1
sleep	12
capture	loadout-before-launch
key	Shift	0.1
sleep	8
capture	mission-submenu-ready
key	space	0.1
sleep	35
capture	mission-launch
key	space	0.1
sleep	10
capture	mission-flight-candidate
key	space	0.1
sleep	10
capture	post-objective-confirm
key	Escape	0.1
sleep	10
capture	flight-hud-baseline
key	w	1.0
sleep	3
capture	flight-pitch
key	d	1.0
sleep	3
capture	flight-roll
key	q	1.0
sleep	3
capture	flight-yaw
mouse	1	1.0
sleep	3
capture	flight-throttle
