# Reach Mission 01 with a fresh user-data profile, leave the aircraft/weapon
# editor with two CANCEL presses, then confirm START MISSION.
key	Left	0.1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	20
wait-pulse	\[ac6-first-campaign-level-bridge\]	Escape
sleep	20
key	space	0.1
present	120	30
capture	mission-submenu
key	space	0.1
present	180	30
capture	aircraft-select
key	space	0.1
present	300	45
capture	weapon-select
key	Shift	0.1
present	180	30
capture	after-weapon-cancel
key	Shift	0.1
present	180	30
capture	after-aircraft-cancel
key	space	0.1
present	600	90
capture	mission-launch
