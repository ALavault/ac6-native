# Fresh-profile route with the qualified single Left+space launch edge at type28=6.
key	Left	0.1
sleep	1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
capture	game-data-browser
key	Shift	0.1
wait	selector44=10	20
sleep	1
capture	post-browser-cancel
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	create-game-data-prompt
key	space	0.1
sleep	2
capture	post-create-confirm
key	space	0.1
sleep	5
capture	post-file-selection
wait	type28=[^ ]*6	20
sleep	2
capture	slot-create-prompt-ready
present	120	20
key	Left	0.1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
capture	post-launch-type8
key	space	0.1
wait	type28=[^ ]*10	30
capture	post-launch-type10
