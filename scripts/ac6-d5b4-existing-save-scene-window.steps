# Bounded renderer oracle from the saved profile produced by the accepted
# cycle-675 Mission 1 route.  The harness starts after selector44=3; the
# runner's state gates are append-only, so each wait observes a new transition.
capture	existing-save-browser
key	space	0.1
wait	type28=[^ ]*6	20
capture	existing-save-type6
sleep	1
key	Left	0.1
sleep	1
key	Left	0.1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
capture	existing-save-loaded
sleep	8
capture	post-save-load
key	space	0.1
sleep	5
capture	loadout-after-a
key	space	0.1
sleep	5
capture	loadout-after-a2
key	space	0.1
sleep	12
capture	loadout-before-launch
key	Shift	0.1
sleep	8
capture	mission-submenu-ready
key	space	0.1
sleep	20
capture	mission-launch-window
wait	\[ac6-d5b4-const\]	45
capture	d5b4-constants-first
present	60	20
capture	d5b4-constants-window-end
