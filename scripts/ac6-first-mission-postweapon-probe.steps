# Reach Mission 01 and probe the post-weapon confirmation flow. The manual
# describes a wingman special-weapon screen before Mission Start; capture each
# input boundary without assuming which focus is active.
key	Left	0.1
key	space	0.1
wait	type28=37	20
key	space	0.1
wait	type28=35	20
key	space	0.1
wait	selector44=3	20
key	space	0.1
wait	type28=6	20
key	Left	0.1
key	space	0.1
wait	type28=8	20
key	space	0.1
wait	type28=10	20
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	20
wait-pulse	\[ac6-first-campaign-level-bridge\]	Escape
sleep	20
key	space	0.1
present	120	30
capture	mission-submenu
key	space	0.1
present	180	30
capture	aircraft-select
key	space	0.1
present	240	45
capture	weapon-select
key	space	0.1
present	240	45
capture	postweapon-aircraft
key	space	0.1
present	240	45
capture	postweapon-second-a
key	Down	0.1
present	240	45
capture	postweapon-down
key	space	0.1
present	240	45
capture	postweapon-down-a
key	Right	0.1
present	240	45
capture	postweapon-right
key	space	0.1
present	600	90
capture	postweapon-right-a
