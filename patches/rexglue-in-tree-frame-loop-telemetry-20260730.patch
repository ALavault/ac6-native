+// Frame-loop telemetry.
+//
+// A guest that runs but never draws can only be diagnosed by pairing what it
+// asks for against what the host delivers. Cycles 316 and 317 established that
+// pairing - 2 VdSwap calls against 2 host presents, 4250 source-0 interrupts
+// against 4 source-1 - but they did it with local instrumentation patches that
+// were never landed. Cycle 323 found those patches still sitting unapplied in
+// workspaces/ace-combat-6/patches/, which means a bare run reports zero for
+// every one of those numbers and a future cycle can read that as a regression.
+//
+// These counters live in the tree so the measurement survives regeneration.
+// They are unconditional increments of relaxed atomics on paths that already do
+// far more work; only the emission is gated, on frame_loop_telemetry_interval.
+// Declared here rather than in a header: the census lives in the xboxkrnl
+// translation unit and this is its only consumer.
+namespace rex::kernel::xboxkrnl::wait_census {
+std::string Describe(size_t max_rows);
+}  // namespace rex::kernel::xboxkrnl::wait_census
+
+namespace rex::graphics::frame_loop_telemetry {
+namespace {
+std::atomic<uint64_t> g_interrupts_by_source[2]{};
+std::atomic<uint64_t> g_interrupts_other_source{0};
+std::atomic<uint64_t> g_interrupts_without_handler{0};
+std::atomic<uint64_t> g_guest_swap_requests{0};
+std::atomic<uint64_t> g_host_swap_presents{0};
+std::atomic<uint64_t> g_host_present_deliveries{0};
+// PM4 ring-buffer submission boundary. Everything the guest asks the GPU to do
+// arrives as packets in this ring, so these five counters separate the three
+// mutually exclusive causes of a frozen frame loop (PLAYABLE_PLAN.md section 2):
+//   guest stopped submitting        -> wptr_updates frozen
+//   host stopped consuming          -> wptr_updates grows, primary_executions frozen
+//   packets no longer carry the work-> primary_executions grows, pm4_* frozen
+std::atomic<uint64_t> g_wptr_updates{0};
+std::atomic<uint32_t> g_last_write_ptr{0};
+std::atomic<uint32_t> g_last_read_ptr{0};
+std::atomic<uint64_t> g_primary_executions{0};
+std::atomic<uint64_t> g_pm4_interrupt_packets{0};
+std::atomic<uint64_t> g_pm4_swap_packets{0};
+}  // namespace
+
+void CountInterrupt(uint32_t source) {
+  if (source < 2) {
+    g_interrupts_by_source[source].fetch_add(1, std::memory_order_relaxed);
+  } else {
+    g_interrupts_other_source.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (source != 0) {
+    return;
+  }
+  const int32_t interval = REXCVAR_GET(frame_loop_telemetry_interval);
+  if (interval <= 0) {
+    return;
+  }
+  const uint64_t vblanks = g_interrupts_by_source[0].load(std::memory_order_relaxed);
+  if (vblanks % static_cast<uint64_t>(interval) != 0) {
+    return;
+  }
+  REXGPU_INFO(
+      "[frame-loop] vblank={} eop={} other_source={} no_handler={} guest_swap_requests={} "
+      "host_swap_presents={} pacing_notifications={} | ring wptr_updates={} wptr={:08X} "
+      "rptr={:08X} primary_executions={} pm4_interrupt={} pm4_swap={}",
+      vblanks, g_interrupts_by_source[1].load(std::memory_order_relaxed),
+      g_interrupts_other_source.load(std::memory_order_relaxed),
+      g_interrupts_without_handler.load(std::memory_order_relaxed),
+      g_guest_swap_requests.load(std::memory_order_relaxed),
+      g_host_swap_presents.load(std::memory_order_relaxed),
+      g_host_present_deliveries.load(std::memory_order_relaxed),
+      g_wptr_updates.load(std::memory_order_relaxed),
+      g_last_write_ptr.load(std::memory_order_relaxed),
+      g_last_read_ptr.load(std::memory_order_relaxed),
+      g_primary_executions.load(std::memory_order_relaxed),
+      g_pm4_interrupt_packets.load(std::memory_order_relaxed),
+      g_pm4_swap_packets.load(std::memory_order_relaxed));
+  // Which guest threads are parked, and for how long. Cycle 326 established the
+  // guest is waiting rather than looping, so this is the frontier observable.
+  REXGPU_INFO("[frame-loop] guest waits:{}", kernel::xboxkrnl::wait_census::Describe(24));
+}
+
+void CountInterruptWithoutHandler() {
+  g_interrupts_without_handler.fetch_add(1, std::memory_order_relaxed);
+}
+
+void CountGuestSwapRequest() { g_guest_swap_requests.fetch_add(1, std::memory_order_relaxed); }
+
+void CountHostSwapPresent() { g_host_swap_presents.fetch_add(1, std::memory_order_relaxed); }
+
+void CountHostPresentDelivery() {
+  g_host_present_deliveries.fetch_add(1, std::memory_order_relaxed);
+}
+
+void CountWritePointerUpdate(uint32_t write_ptr) {
+  g_wptr_updates.fetch_add(1, std::memory_order_relaxed);
+  g_last_write_ptr.store(write_ptr, std::memory_order_relaxed);
+}
+
+void CountPrimaryBufferExecution(uint32_t read_ptr_after) {
+  g_primary_executions.fetch_add(1, std::memory_order_relaxed);
+  g_last_read_ptr.store(read_ptr_after, std::memory_order_relaxed);
+}
+
+void CountPm4InterruptPacket() {
+  g_pm4_interrupt_packets.fetch_add(1, std::memory_order_relaxed);
+}
+
+void CountPm4SwapPacket() { g_pm4_swap_packets.fetch_add(1, std::memory_order_relaxed); }
+}  // namespace rex::graphics::frame_loop_telemetry
