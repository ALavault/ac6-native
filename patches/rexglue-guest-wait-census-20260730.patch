+// ---------------------------------------------------------------------------
+// Guest wait census.
+//
+// Cycle 326 measured that AC6's guest threads together consume about 9% of CPU
+// while the frame loop is frozen: the guest is not looping, it is waiting. The
+// question that follows is which handle each guest thread is parked on and for
+// how long, and no counter answered that. This records one live entry per guest
+// thread and lets the frame-loop telemetry print it.
+//
+// Cost is one relaxed store per wait entry and one per exit, on paths that
+// already do a handle lookup and a kernel wait. The emission is gated by the
+// caller (frame_loop_telemetry_interval), never on by default.
+// ---------------------------------------------------------------------------
+namespace wait_census {
+namespace {
+struct Entry {
+  std::atomic<uint32_t> thread_id{0};
+  std::atomic<uint32_t> handle{0};
+  std::atomic<uint32_t> count{0};        // >1 for WaitForMultipleObjects
+  std::atomic<uint64_t> entered_ms{0};   // 0 = not waiting
+  std::atomic<uint64_t> waits{0};        // total waits entered by this thread
+  const char* kind = "";
+};
+constexpr size_t kMaxTracked = 64;
+Entry g_entries[kMaxTracked];
+
+uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+Entry* SlotFor(uint32_t thread_id) {
+  // Linear probe on a tiny fixed table: no allocation, no lock, and a guest
+  // that creates more than kMaxTracked waiting threads simply stops being
+  // tracked rather than growing unbounded under a diagnostic.
+  for (size_t i = 0; i < kMaxTracked; ++i) {
+    uint32_t owner = g_entries[i].thread_id.load(std::memory_order_relaxed);
+    if (owner == thread_id) {
+      return &g_entries[i];
+    }
+    if (owner == 0) {
+      uint32_t expected = 0;
+      if (g_entries[i].thread_id.compare_exchange_strong(expected, thread_id,
+                                                        std::memory_order_relaxed)) {
+        return &g_entries[i];
+      }
+      if (g_entries[i].thread_id.load(std::memory_order_relaxed) == thread_id) {
+        return &g_entries[i];
+      }
+    }
+  }
+  return nullptr;
+}
+
+uint32_t CurrentGuestThreadId() {
+  auto* thread = XThread::GetCurrentThread();
+  return thread ? thread->thread_id() : 0u;
+}
+}  // namespace
+
+void Enter(const char* kind, uint32_t handle, uint32_t count) {
+  uint32_t tid = CurrentGuestThreadId();
+  if (!tid) {
+    return;  // host thread: not part of the guest census
+  }
+  Entry* e = SlotFor(tid);
+  if (!e) {
+    return;
+  }
+  e->kind = kind;
+  e->handle.store(handle, std::memory_order_relaxed);
+  e->count.store(count, std::memory_order_relaxed);
+  e->waits.fetch_add(1, std::memory_order_relaxed);
+  e->entered_ms.store(NowMs(), std::memory_order_relaxed);
+}
+
+void Exit() {
+  uint32_t tid = CurrentGuestThreadId();
+  if (!tid) {
+    return;
+  }
+  Entry* e = SlotFor(tid);
+  if (e) {
+    e->entered_ms.store(0, std::memory_order_relaxed);
+  }
+}
+
+// Longest-waiting guest threads first. Only threads currently parked appear.
+std::string Describe(size_t max_rows) {
+  const uint64_t now = NowMs();
+  struct Row {
+    uint64_t held_ms;
+    uint32_t tid, handle, count;
+    uint64_t waits;
+    const char* kind;
+  };
+  std::vector<Row> rows;
+  for (size_t i = 0; i < kMaxTracked; ++i) {
+    uint32_t tid = g_entries[i].thread_id.load(std::memory_order_relaxed);
+    uint64_t since = g_entries[i].entered_ms.load(std::memory_order_relaxed);
+    if (!tid || !since) {
+      continue;
+    }
+    rows.push_back({now - since, tid, g_entries[i].handle.load(std::memory_order_relaxed),
+                    g_entries[i].count.load(std::memory_order_relaxed),
+                    g_entries[i].waits.load(std::memory_order_relaxed), g_entries[i].kind});
+  }
+  std::sort(rows.begin(), rows.end(),
+            [](const Row& a, const Row& b) { return a.held_ms > b.held_ms; });
+  std::string out;
+  size_t n = 0;
+  for (const auto& r : rows) {
+    if (n++ >= max_rows) {
+      break;
+    }
+    out += fmt::format(" [tid={:04X} {} handle={:08X}{} held={}ms waits={}]", r.tid, r.kind,
+                       r.handle, r.count > 1 ? fmt::format("+{}", r.count - 1) : "", r.held_ms,
+                       r.waits);
+  }
+  if (out.empty()) {
+    out = " [no guest thread currently waiting]";
+  }
+  return out;
+}
