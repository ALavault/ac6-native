diff --git a/src/xenia/base/agent_bridge.h b/src/xenia/base/agent_bridge.h
new file mode 100644
index 000000000..a919c053a
--- /dev/null
+++ b/src/xenia/base/agent_bridge.h
@@ -0,0 +1,83 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_BASE_AGENT_BRIDGE_H_
+#define XENIA_BASE_AGENT_BRIDGE_H_
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace xe {
+
+// Backend-independent state shared by the completed-XE_SWAP boundary and the
+// guest input poll. Transport, framebuffer capture and save-state coordination
+// are intentionally kept outside this class.
+struct AgentControllerState {
+  bool connected = true;
+  uint16_t buttons = 0;
+  uint8_t left_trigger = 0;
+  uint8_t right_trigger = 0;
+  int16_t thumb_lx = 0;
+  int16_t thumb_ly = 0;
+  int16_t thumb_rx = 0;
+  int16_t thumb_ry = 0;
+};
+
+struct AgentBridgeCapabilities {
+  bool pause_after_completed_present = false;
+  bool exact_guest_frame_step = false;
+  bool guest_controller_injection = true;
+  bool framebuffer_capture_while_paused = false;
+  bool checkpoint_restore = false;
+};
+
+class AgentBridge {
+ public:
+  static AgentBridge& Get();
+
+  void SetEnabled(bool enabled);
+  bool enabled() const;
+
+  // Installs one controller state for the following hold_frames completed
+  // guest presents. The action identifier must be strictly increasing.
+  bool SubmitAction(uint64_t action_id, const AgentControllerState& state,
+                    uint32_t hold_frames, std::string* error = nullptr);
+
+  // Called by the common PM4 XE_SWAP handler after the backend IssueSwap has
+  // returned. Returns the monotonically increasing completed-present number.
+  uint64_t OnCompletedPresent(uint32_t frontbuffer_ptr, uint32_t width,
+                              uint32_t height);
+
+  // Returns true when slot zero must be replaced by the injected state.
+  bool GetInjectedControllerState(uint32_t user_index,
+                                  AgentControllerState* state,
+                                  uint64_t* action_id = nullptr) const;
+
+  uint64_t completed_present_count() const;
+  uint32_t remaining_frames() const;
+  AgentBridgeCapabilities capabilities() const;
+
+  void ResetForTest();
+
+ private:
+  AgentBridge() = default;
+
+  mutable std::mutex mutex_;
+  bool enabled_ = false;
+  bool has_action_ = false;
+  bool has_submitted_action_ = false;
+  uint64_t last_action_id_ = 0;
+  uint64_t completed_present_count_ = 0;
+  uint32_t remaining_frames_ = 0;
+  AgentControllerState controller_state_;
+};
+
+}  // namespace xe
+
+#endif  // XENIA_BASE_AGENT_BRIDGE_H_
diff --git a/src/xenia/base/agent_bridge.cc b/src/xenia/base/agent_bridge.cc
new file mode 100644
index 000000000..556de3bfe
--- /dev/null
+++ b/src/xenia/base/agent_bridge.cc
@@ -0,0 +1,124 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/base/agent_bridge.h"
+
+namespace xe {
+
+AgentBridge& AgentBridge::Get() {
+  static AgentBridge bridge;
+  return bridge;
+}
+
+void AgentBridge::SetEnabled(bool enabled) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  enabled_ = enabled;
+  if (!enabled_) {
+    has_action_ = false;
+    remaining_frames_ = 0;
+    controller_state_ = {};
+  }
+}
+
+bool AgentBridge::enabled() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return enabled_;
+}
+
+bool AgentBridge::SubmitAction(uint64_t action_id,
+                               const AgentControllerState& state,
+                               uint32_t hold_frames, std::string* error) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!enabled_) {
+    if (error) {
+      *error = "agent bridge is disabled";
+    }
+    return false;
+  }
+  if (!hold_frames) {
+    if (error) {
+      *error = "hold_frames must be non-zero";
+    }
+    return false;
+  }
+  if (has_submitted_action_ && action_id <= last_action_id_) {
+    if (error) {
+      *error = "action_id must be strictly increasing";
+    }
+    return false;
+  }
+  if (remaining_frames_) {
+    if (error) {
+      *error = "previous action has not completed";
+    }
+    return false;
+  }
+
+  last_action_id_ = action_id;
+  has_submitted_action_ = true;
+  controller_state_ = state;
+  remaining_frames_ = hold_frames;
+  has_action_ = true;
+  return true;
+}
+
+uint64_t AgentBridge::OnCompletedPresent(uint32_t frontbuffer_ptr,
+                                         uint32_t width, uint32_t height) {
+  static_cast<void>(frontbuffer_ptr);
+  static_cast<void>(width);
+  static_cast<void>(height);
+  std::lock_guard<std::mutex> lock(mutex_);
+  ++completed_present_count_;
+  if (enabled_ && remaining_frames_) {
+    --remaining_frames_;
+    if (!remaining_frames_) {
+      controller_state_ = {};
+      has_action_ = false;
+    }
+  }
+  return completed_present_count_;
+}
+
+bool AgentBridge::GetInjectedControllerState(uint32_t user_index,
+                                             AgentControllerState* state,
+                                             uint64_t* action_id) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!enabled_ || !has_action_ || !remaining_frames_ || user_index != 0) {
+    return false;
+  }
+  *state = controller_state_;
+  if (action_id) {
+    *action_id = last_action_id_;
+  }
+  return true;
+}
+
+uint64_t AgentBridge::completed_present_count() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return completed_present_count_;
+}
+
+uint32_t AgentBridge::remaining_frames() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return remaining_frames_;
+}
+
+AgentBridgeCapabilities AgentBridge::capabilities() const { return {}; }
+
+void AgentBridge::ResetForTest() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  enabled_ = false;
+  has_action_ = false;
+  has_submitted_action_ = false;
+  last_action_id_ = 0;
+  completed_present_count_ = 0;
+  remaining_frames_ = 0;
+  controller_state_ = {};
+}
+
+}  // namespace xe
diff --git a/src/xenia/base/testing/agent_bridge_test.cc b/src/xenia/base/testing/agent_bridge_test.cc
new file mode 100644
index 000000000..326cbacc6
--- /dev/null
+++ b/src/xenia/base/testing/agent_bridge_test.cc
@@ -0,0 +1,75 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/base/agent_bridge.h"
+
+#include "third_party/catch/single_include/catch2/catch.hpp"
+
+namespace xe::test {
+
+TEST_CASE("Agent bridge actions are present-bounded", "[agent_bridge]") {
+  AgentBridge& bridge = AgentBridge::Get();
+  bridge.ResetForTest();
+  bridge.SetEnabled(true);
+
+  AgentControllerState submitted;
+  submitted.buttons = 0x10;
+  submitted.thumb_lx = -1234;
+  std::string error;
+  REQUIRE(bridge.SubmitAction(7, submitted, 2, &error));
+
+  AgentControllerState observed;
+  uint64_t action_id = 0;
+  REQUIRE(bridge.GetInjectedControllerState(0, &observed, &action_id));
+  REQUIRE(action_id == 7);
+  REQUIRE(observed.buttons == 0x10);
+  REQUIRE(observed.thumb_lx == -1234);
+  REQUIRE_FALSE(bridge.GetInjectedControllerState(1, &observed));
+
+  REQUIRE(bridge.OnCompletedPresent(0x1000, 1280, 720) == 1);
+  REQUIRE(bridge.remaining_frames() == 1);
+  REQUIRE(bridge.GetInjectedControllerState(0, &observed));
+
+  REQUIRE(bridge.OnCompletedPresent(0x1000, 1280, 720) == 2);
+  REQUIRE(bridge.remaining_frames() == 0);
+  REQUIRE_FALSE(bridge.GetInjectedControllerState(0, &observed));
+
+  REQUIRE_FALSE(bridge.SubmitAction(7, submitted, 1, &error));
+  REQUIRE(error == "action_id must be strictly increasing");
+  REQUIRE(bridge.SubmitAction(8, submitted, 1, &error));
+}
+
+TEST_CASE("Agent bridge rejects overlap and invalid duration",
+          "[agent_bridge]") {
+  AgentBridge& bridge = AgentBridge::Get();
+  bridge.ResetForTest();
+  AgentControllerState state;
+  std::string error;
+
+  REQUIRE_FALSE(bridge.SubmitAction(1, state, 1, &error));
+  REQUIRE(error == "agent bridge is disabled");
+  bridge.SetEnabled(true);
+  REQUIRE_FALSE(bridge.SubmitAction(1, state, 0, &error));
+  REQUIRE(error == "hold_frames must be non-zero");
+  REQUIRE(bridge.SubmitAction(1, state, 3, &error));
+  REQUIRE_FALSE(bridge.SubmitAction(2, state, 1, &error));
+  REQUIRE(error == "previous action has not completed");
+}
+
+TEST_CASE("Agent bridge capability claims remain fail-closed",
+          "[agent_bridge]") {
+  const AgentBridgeCapabilities capabilities =
+      AgentBridge::Get().capabilities();
+  REQUIRE(capabilities.guest_controller_injection);
+  REQUIRE_FALSE(capabilities.pause_after_completed_present);
+  REQUIRE_FALSE(capabilities.exact_guest_frame_step);
+  REQUIRE_FALSE(capabilities.framebuffer_capture_while_paused);
+  REQUIRE_FALSE(capabilities.checkpoint_restore);
+}
+
+}  // namespace xe::test

