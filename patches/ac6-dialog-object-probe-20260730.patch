+// ---------------------------------------------------------------------------
+// Dialog object probe (P1.3).
+//
+// The YES/NO dialog reached after the title renders with no question text, and
+// answers no confirm button. Cycles 337-339 eliminated every runtime-side
+// explanation by measurement: it is not the runtime's ImGui message box (no
+// XamShowMessageBoxUI* is ever called), not an XDBF string table (that serves
+// only title and achievements), not the storage path (XamShowDeviceSelectorUI
+// returns SUCCESS with device_id = 1), and not a data read (the loud short/failed
+// read warning added in cycle 338 reports zero hits, so the string is on disc
+// and arrives intact).
+//
+// That leaves the guest's own dialog object. sub_821CE8A8 receives it in r3 and
+// writes fields at +84, +88 and a seven-word buffer at +92 before calling out to
+// XamShowDeviceSelectorUI. If the object carries a text pointer that is null --
+// or points at an empty string -- that is the defect, and it would explain both
+// symptoms at once: a dialog built without its text may equally have been built
+// without its buttons' actions.
+//
+// So dump the object's head on entry. Cheap, one line, and it either shows a
+// null field or rules the object out.
+void ac6DialogObjectProbe(PPCRegister& r3, PPCRegister& r4) {
+    static std::atomic<int> seen{0};
+    const int n = ++seen;
+    if (n > 4) {
+        return;  // the dialog is built a handful of times; do not spam
+    }
+    auto* memory = REX_KERNEL_MEMORY();
+    if (!memory) {
+        return;
+    }
+    const uint32_t obj = r3.u32;
+
+    std::string words;
+    for (uint32_t off = 0; off < 128; off += 4) {
+        const uint32_t v = LoadGuestU32BE(memory, obj + off);
+        words += fmt::format(" +{:<3}={:08X}", off, v);
+        if ((off % 32) == 28) {
+            words += "\n                ";
+        }
+    }
+    REXLOG_INFO("[ac6-dialog] sub_821CE8A8 #{} obj=0x{:08X} arg=0x{:08X}\n                {}", n,
+                obj, r4.u32, words);
+
+    // Anything that looks like a guest pointer in the head of the object is a
+    // candidate text field; resolve the plausible ones so a null or empty
+    // string is visible directly rather than inferred from a raw word.
+    for (uint32_t off = 0; off < 128; off += 4) {
+        const uint32_t v = LoadGuestU32BE(memory, obj + off);
+        if (v >= 0x82000000u && v < 0x90000000u) {
+            const uint32_t first = LoadGuestU32BE(memory, v);
+            REXLOG_INFO("[ac6-dialog]   +{} -> 0x{:08X} first_word=0x{:08X}", off, v, first);
+        }
+    }
+}
