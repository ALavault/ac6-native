+bool IsGuestRangeReadable(rex::memory::Memory* memory, uint32_t address,
+                          uint32_t size) {
+    if (!memory || size == 0 || address > UINT32_MAX - (size - 1)) return false;
+    auto* heap = memory->LookupHeap(address);
+    return heap &&
+           heap->QueryRangeAccess(address, address + size - 1) !=
+               rex::memory::PageAccess::kNoAccess;
