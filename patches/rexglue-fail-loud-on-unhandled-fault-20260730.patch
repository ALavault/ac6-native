@@ -205,6 +205,46 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       return;
     }
   }
+
+  // No handler claimed this fault. Returning here resumes the thread at the
+  // *same* instruction, because nothing advanced the program counter -- so the
+  // faulting instruction re-executes, faults again, and the thread spins in a
+  // signal storm forever at 100% CPU without ever crashing.
+  //
+  // That is not hypothetical. AC6's main guest thread was measured doing
+  // exactly this: 100.00% of its samples landed on a single `ud2`, emitted by
+  // the recompiler as __builtin_trap() for a jump-table `bctr` it could not
+  // resolve. The process looked alive, burned a core, presented no frames, and
+  // gave no diagnostic at all. Locating it cost a profile and an annotate pass;
+  // it should have cost one line of log.
+  //
+  // Failing loudly here is strictly better than looping silently: restore the
+  // default disposition and re-raise, so the process dies at the faulting
+  // instruction with a usable core and a named address.
+  const char* signal_name = signal_number == SIGILL    ? "SIGILL (illegal instruction)"
+                            : signal_number == SIGSEGV ? "SIGSEGV (access violation)"
+                                                       : "unknown signal";
+  REXLOG_ERROR(
+      "Unhandled {} at host pc {:#018x}, faulting address {:#018x}. No installed handler claimed "
+      "it. Re-raising instead of resuming: resuming would re-execute the same instruction "
+      "forever. If the pc is inside a recompiled guest function, this is an unresolved indirect "
+      "branch the code generator turned into a trap.",
+      signal_name,
+#if REX_ARCH_AMD64
+      uint64_t(mcontext.gregs[REG_RIP]),
+#elif REX_ARCH_ARM64
+      uint64_t(mcontext.pc),
+#else
+      uint64_t(0),
+#endif  // REX_ARCH
+      reinterpret_cast<uint64_t>(signal_info->si_addr));
+
+  struct sigaction default_action;
+  std::memset(&default_action, 0, sizeof(default_action));
+  default_action.sa_handler = SIG_DFL;
+  sigaction(signal_number, &default_action, nullptr);
+  // Returning now re-executes the faulting instruction, which this time is
+  // taken by the default disposition and terminates the process.
 }
 
