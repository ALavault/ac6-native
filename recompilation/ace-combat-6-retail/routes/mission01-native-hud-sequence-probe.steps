# Diagnostic only: complete native Mission 01 handoff with the historical
# briefing/cinematic waits. This route never creates a gameplay receipt.
key	Escape	0.1
sleep	2
key	space	0.1
wait-pulse	type28=30	Escape+space
sleep	1
key	space	0.1
wait	type28=[^ ]*37	20
key	Left	0.1
key	space	0.1
wait	type28=[^ ]*35	20
key	space	0.1
wait	selector44=[^ ]*3	20
key	Shift	0.1
wait	selector44=[^ ]*10	20
sleep	1
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
key	space	0.1
sleep	2
key	space	0.1
sleep	5
wait	type28=[^ ]*6	20
sleep	2
sleep	2
key	Left	0.1
sleep	1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
capture	controls
key	space	0.1
sleep	3
capture	language
key	space	0.1
sleep	3
key	space	0.1
sleep	2
capture	campaign-intro
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape
capture	post-campaign-intro-skip
sleep	5
capture	mission-01-start
key	space	0.1
sleep	15
capture	post-start-a
key	space	0.1
sleep	20
capture	post-start-b
key	space	0.1
sleep	12
capture	post-weapon-confirm
key	Shift	0.1
sleep	8
capture	mission-submenu-ready
key	space	0.1
sleep	35
capture	mission-launch
sleep	60
capture	mission-briefing
key	space	0.1
sleep	45
capture	mission-cinematic
sleep	30
capture	post-cinematic-30s
key	space	0.1
sleep	15
capture	post-cinematic-a-15s
key	Escape	0.1
sleep	15
capture	flight-hud-baseline
key	W	1.0
sleep	2
capture	flight-pitch-up
key	S	1.0
sleep	2
capture	flight-pitch-down
key	A	1.0
sleep	2
capture	flight-roll-left
key	D	1.0
sleep	2
capture	flight-roll-right
key	LMB	1.0
sleep	2
capture	flight-throttle
key	RMB	1.0
sleep	2
capture	flight-brake
