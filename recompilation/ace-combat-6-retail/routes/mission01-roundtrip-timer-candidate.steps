# Diagnostic only: corrected Campaign/New Game handoff, then no-input timer
# observation after the native HUD. This route never produces a gameplay or
# debrief receipt; it only tests whether the qualified Mission 01 script can
# reach its own terminal without synthetic objective input.
sleep	20
wait-pulse	type28=30	Escape@90
sleep	1
key	space	0.1
wait	type28=[^ ]*37	20
key	Left	0.1
key	space	0.1
wait	type28=[^ ]*35	20
key	space	0.1
wait	selector44=[^ ]*3	20
capture	game-data-browser
key	Shift	0.1
wait	selector44=[^ ]*10	20
sleep	1
capture	post-browser-cancel
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	create-game-data-prompt
key	space	0.1
sleep	2
capture	post-create-confirm
key	space	0.1
sleep	5
capture	post-file-selection
wait	type28=[^ ]*6	20
sleep	2
capture	slot-create-prompt-ready
sleep	2
key	Left	0.1
sleep	1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
capture	post-slot-create-confirm
key	space	0.1
sleep	3
capture	campaign-new-game
sleep	8
key	space	0.6
sleep	5
capture	difficulty
key	space	0.6
sleep	5
capture	controls
key	space	0.6
sleep	5
capture	language
key	space	0.6
sleep	5
key	space	0.6
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape@60
capture	post-campaign-intro-skip
sleep	5
capture	mission-01-start
key	space	0.1
sleep	15
capture	post-start-a
key	space	0.1
sleep	20
capture	post-start-b
key	space	0.1
sleep	12
capture	post-weapon-confirm
key	space	0.6
sleep	15
capture	cinematic-view-1
sleep	2
key	space	0.6
sleep	15
capture	mission-tactical-map
key	space	0.6
sleep	60
capture	mission-briefing
key	space	0.6
sleep	45
capture	mission-cinematic
sleep	30
capture	post-cinematic-30s
key	space	0.6
sleep	15
capture	post-cinematic-a-15s
key	Escape	0.6
sleep	15
capture	flight-hud-candidate
sleep	60
capture	post-hud-60s
sleep	60
capture	post-hud-120s
sleep	60
capture	post-hud-180s
sleep	60
capture	post-hud-240s
sleep	60
capture	post-hud-300s
