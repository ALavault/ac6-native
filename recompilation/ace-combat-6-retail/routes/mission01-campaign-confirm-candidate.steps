# Bounded diagnostic: qualify the Campaign/New Game input-inhibit boundary
# after the synchronized fresh-profile prefix.  The sealed 96-step route is
# unchanged and this route never produces a gameplay receipt.
sleep	20
wait-pulse	type28=30	Escape+space
sleep	1
key	space	0.1
wait	type28=[^ ]*37	20
key	Left	0.1
key	space	0.1
wait	type28=[^ ]*35	20
key	space	0.1
wait	selector44=[^ ]*3	20
capture	game-data-browser
key	Shift	0.1
wait	selector44=[^ ]*10	20
sleep	1
capture	post-browser-cancel
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	create-game-data-prompt
key	space	0.1
sleep	2
capture	post-create-confirm
key	space	0.1
sleep	5
capture	post-file-selection
wait	type28=[^ ]*6	20
sleep	2
capture	slot-create-prompt-ready
sleep	2
key	Left	0.1
sleep	1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
key	space	0.1
sleep	3
capture	campaign-new-game-initial
# The preceding capture can be a transition frame.  Let the guest-owned menu
# settle, then qualify one changed input: a held A/Space edge.
sleep	8
key	space	0.6
sleep	5
capture	difficulty-after-settle
key	space	0.6
sleep	5
capture	controls-after-settle
key	space	0.6
sleep	5
capture	language-after-settle
key	space	0.6
sleep	5
key	space	0.6
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape@60
capture	campaign-transition
