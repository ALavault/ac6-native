# Compact, diagnostic-only Mission 01 handoff probe. The launch transition is
# paced through the full briefing/cinematic before the single HUD Escape edge.
key	Escape	0.1
sleep	2
key	space	0.1
wait-pulse	type28=30	Escape+space
sleep	1
key	space	0.1
wait	type28=[^ ]*37	20
key	Left	0.1
key	space	0.1
wait	type28=[^ ]*35	20
key	space	0.1
wait	selector44=[^ ]*3	20
capture	game-data-browser
key	Shift	0.1
wait	selector44=[^ ]*10	20
sleep	1
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
capture	create-game-data-prompt
key	space	0.1
sleep	2
key	space	0.1
sleep	5
wait	type28=[^ ]*6	20
sleep	2
key	Left	0.1
sleep	1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	3
key	space	0.1
sleep	2
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape
sleep	5
key	space	0.1
sleep	15
key	space	0.1
sleep	20
key	space	0.1
sleep	12
key	Shift	0.1
sleep	8
key	space	0.1
sleep	35
sleep	60
capture	mission-briefing-full
key	space	0.1
sleep	45
capture	mission-cinematic-full
sleep	30
key	space	0.1
sleep	15
capture	post-cinematic-full
key	Escape	0.1
sleep	15
capture	flight-hud-airborne
key	w	1.0
sleep	3
capture	flight-pitch-airborne
