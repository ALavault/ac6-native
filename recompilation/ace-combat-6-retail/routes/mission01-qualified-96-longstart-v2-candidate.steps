# Candidate v2: preserve the qualified longstart pacing, add the complete
# 27-capture audit shape, and adapt the cinematic handoff to a stable phase.
# Diagnostic until this route produces and passes a matching gameplay receipt.
sleep	60
wait-pulse	type28=30	Escape@180
sleep	1
key	space	0.1
wait	type28=[^ ]*37	20
key	Left	0.1
key	space	0.1
wait	type28=[^ ]*35	20
key	space	0.1
wait	selector44=[^ ]*3	20
capture	game-data-browser
key	Shift	0.1
wait	selector44=[^ ]*10	20
capture	post-browser-cancel	1
key	Left	0.1
key	space	0.1
wait	state40=9.*type28=5	20
key	space	0.1
capture	create-game-data-prompt	2
key	space	0.1
capture	post-create-confirm	5
wait	type28=[^ ]*6	20
capture	post-file-selection	2
capture	slot-create-prompt-ready	2
key	Left	0.1
sleep	1
key	space	0.1
wait-pulse	type28=[^ ]*8	space
key	space	0.1
wait	type28=[^ ]*10	20
key	space	0.1
capture	post-slot-create-confirm	3
sleep	8
key	space	0.6
sleep	5
key	space	0.6
sleep	5
key	space	0.6
sleep	5
capture	language
key	space	0.6
sleep	5
key	space	0.6
wait-pulse	\[ac6-campaign-transition\].*state=1->2	Escape@60
capture	post-campaign-intro-skip
sleep	5
capture	mission-01-start
key	space	0.1
sleep	15
capture	post-start-a
key	space	0.1
sleep	20
capture	post-start-b
key	space	0.1
sleep	12
capture	post-weapon-confirm
key	space	0.6
sleep	15
capture	pre-cinematic-view-1
sleep	2
key	space	0.6
sleep	15
capture	pre-cinematic-map
key	space	0.6
sleep	60
capture	pre-cinematic-briefing
key	space	0.6
sleep	45
capture	cinematic-view-1
sleep	30
capture	cinematic-view-2
key	space	0.6
sleep	15
capture	cinematic-view-3
capture	cinematic-view-4
capture	cinematic-view-5
